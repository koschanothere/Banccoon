<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Banccoon.App.Views.AppLockPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:Banccoon.App.ViewModels"
    xmlns:loc="clr-namespace:Banccoon.App.Localization"
    x:DataType="viewModels:AppLockViewModel"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light={StaticResource LightPageBackground}, Dark={StaticResource DarkPageBackground}}">

    <Grid>
        <Border
            Style="{StaticResource CardBorder}"
            WidthRequest="300"
            HorizontalOptions="Center"
            VerticalOptions="Center">
            <VerticalStackLayout Spacing="14">
                <Label Text="{loc:Translate AppLock_Title}" Style="{StaticResource SectionTitleLabel}" HorizontalTextAlignment="Center" />
                <Label Text="{loc:Translate AppLock_Subtitle}" Style="{StaticResource SecondaryLabel}" HorizontalTextAlignment="Center" />
                <Entry
                    x:Name="PinEntry"
                    Text="{Binding PinText}"
                    Placeholder="{loc:Translate AppLock_PinPlaceholder}"
                    IsPassword="True"
                    Keyboard="Numeric"
                    HorizontalTextAlignment="Center"
                    Completed="OnPinCompleted" />
                <Button Text="{loc:Translate AppLock_UnlockButton}" Command="{Binding UnlockCommand}" Style="{StaticResource PrimaryButton}" HorizontalOptions="Fill" />
                <Label
                    Text="{Binding StatusText}"
                    HorizontalTextAlignment="Center"
                    TextColor="{AppThemeBinding Light={StaticResource LightStatusRed}, Dark={StaticResource DarkStatusRed}}" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
