<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Banccoon.App.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Banccoon.App.Controls"
    xmlns:viewModels="clr-namespace:Banccoon.App.ViewModels"
    x:DataType="viewModels:DashboardViewModel"
    Title="Dashboard"
    BackgroundColor="{AppThemeBinding Light={StaticResource LightPageBackground}, Dark={StaticResource DarkPageBackground}}">

    <ScrollView>
        <VerticalStackLayout Padding="32" Spacing="16">

            <VerticalStackLayout Spacing="2">
                <Label Text="Dashboard" Style="{StaticResource ScreenTitleLabel}" />
                <Label Text="{Binding FreeToSpendWindowText}" Style="{StaticResource SecondaryLabel}" />
            </VerticalStackLayout>

            <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" HorizontalOptions="Start" />

            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="14">
                    <Label Text="Free to spend" Style="{StaticResource SecondaryLabel}" />
                    <Label Text="{Binding FreeToSpendText}" Style="{StaticResource HeroAmountLabel}" />

                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource LightDivider}, Dark={StaticResource DarkDivider}}" />

                    <Button
                        Text="How it's calculated"
                        Command="{Binding ToggleCalcCommand}"
                        Style="{StaticResource QuietButton}"
                        HorizontalOptions="Start" />

                    <VerticalStackLayout Spacing="7" IsVisible="{Binding IsCalcOpen}">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="Lowest forecasted balance" Style="{StaticResource SecondaryLabel}" />
                            <Label Grid.Column="1" Text="{Binding LowestForecastedBalanceText}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="Reserved for goals" Style="{StaticResource SecondaryLabel}" />
                            <Label Grid.Column="1" Text="{Binding ReservedForGoalsText}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="Safety buffer" Style="{StaticResource SecondaryLabel}" />
                            <Label Grid.Column="1" Text="{Binding SafetyBufferText}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="Free to spend" FontAttributes="Bold" />
                            <Label Grid.Column="1" Text="{Binding FreeToSpendText}" FontAttributes="Bold" />
                        </Grid>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Balance history &amp; forecast" Style="{StaticResource SecondaryLabel}" />
                    <Label Text="{Binding GraphWindowSummaryText}" Style="{StaticResource TertiaryLabel}" />
                    <controls:ForecastChartView Points="{Binding ChartPoints}" HeightRequest="220" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Upcoming" Style="{StaticResource SectionTitleLabel}" />
                    <Label Text="Coming soon" Style="{StaticResource TertiaryLabel}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Forecast" Style="{StaticResource SectionTitleLabel}" />
                    <Label Text="Coming soon" Style="{StaticResource TertiaryLabel}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Analytics" Style="{StaticResource SectionTitleLabel}" />
                    <Label Text="Coming soon" Style="{StaticResource TertiaryLabel}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Goals" Style="{StaticResource SectionTitleLabel}" />
                    <Label Text="Coming soon" Style="{StaticResource TertiaryLabel}" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
