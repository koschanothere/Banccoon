<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Banccoon.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:Banccoon.App.ViewModels"
    x:DataType="viewModels:SettingsViewModel"
    Title="Settings">
    <VerticalStackLayout Padding="32" Spacing="16">
        <Label Text="Settings" Style="{StaticResource ScreenTitleLabel}" />

        <Border Style="{StaticResource CardBorder}">
            <VerticalStackLayout Spacing="10">
                <Label Text="Appearance" Style="{StaticResource SectionTitleLabel}" />
                <Label Text="Theme" Style="{StaticResource SecondaryLabel}" />
                <HorizontalStackLayout Spacing="6">
                    <Button Text="Light" Command="{Binding SetLightCommand}" Style="{StaticResource QuietButton}" />
                    <Button Text="Dark" Command="{Binding SetDarkCommand}" Style="{StaticResource QuietButton}" />
                    <Button Text="System" Command="{Binding SetSystemCommand}" Style="{StaticResource QuietButton}" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Border>

        <Border Style="{StaticResource CardBorder}">
            <VerticalStackLayout Spacing="4">
                <Label Text="Data" Style="{StaticResource SectionTitleLabel}" />
                <Label Text="Backup, restore, and delete-all-local-data coming soon." Style="{StaticResource TertiaryLabel}" />
            </VerticalStackLayout>
        </Border>
    </VerticalStackLayout>
</ContentPage>
