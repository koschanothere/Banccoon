<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Banccoon.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:Banccoon.App.ViewModels"
    xmlns:loc="clr-namespace:Banccoon.App.Localization"
    x:DataType="viewModels:SettingsViewModel"
    Title="{loc:Translate AppShell_Nav_Settings}"
    BackgroundColor="{AppThemeBinding Light={StaticResource LightPageBackground}, Dark={StaticResource DarkPageBackground}}">

    <Grid>
    <Grid ColumnDefinitions="220,*" Padding="32" ColumnSpacing="24">

        <VerticalStackLayout Grid.Column="0" Spacing="4">
            <Label Text="{loc:Translate AppShell_Nav_Settings}" Style="{StaticResource ScreenTitleLabel}" Margin="0,0,0,12" />
            <CollectionView ItemsSource="{Binding Categories}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:SettingsCategoryRowViewModel">
                        <Border
                            StrokeShape="RoundRectangle 8"
                            Stroke="Transparent"
                            Padding="12,10"
                            Margin="0,1"
                            Background="{Binding IsSelected, Converter={StaticResource SelectedNavBackgroundConverter}}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SelectCommand}" />
                            </Border.GestureRecognizers>
                            <Label Text="{Binding Name}" />
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>

        <ScrollView Grid.Column="1">
            <VerticalStackLayout Spacing="16">

                <!-- General -->
                <VerticalStackLayout Spacing="16" IsVisible="{Binding IsGeneralCategorySelected}">
                    <Border Style="{StaticResource CardBorder}">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="{loc:Translate Settings_AppearanceHeader}" Style="{StaticResource SectionTitleLabel}" />
                            <Label Text="{loc:Translate Settings_ThemeLabel}" Style="{StaticResource SecondaryLabel}" />
                            <HorizontalStackLayout Spacing="6">
                                <Button Text="{loc:Translate Settings_ThemeLight}" Command="{Binding SetLightCommand}" Style="{StaticResource QuietButton}" />
                                <Button Text="{loc:Translate Settings_ThemeDark}" Command="{Binding SetDarkCommand}" Style="{StaticResource QuietButton}" />
                                <Button Text="{loc:Translate Settings_ThemeSystem}" Command="{Binding SetSystemCommand}" Style="{StaticResource QuietButton}" />
                            </HorizontalStackLayout>

                            <Label Text="{loc:Translate Settings_CategoryColorsLabel}" Style="{StaticResource SecondaryLabel}" />
                            <Label Text="{loc:Translate Settings_CategoryColorsHint}" Style="{StaticResource TertiaryLabel}" />
                            <HorizontalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding CategoryColorPreview}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="Color">
                                        <Border WidthRequest="22" HeightRequest="22" StrokeShape="RoundRectangle 11" Stroke="Transparent" Background="{Binding .}" />
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource CardBorder}">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="{loc:Translate Settings_GeneralHeader}" Style="{StaticResource SectionTitleLabel}" />

                            <Label Text="{loc:Translate Settings_LanguageLabel}" Style="{StaticResource SecondaryLabel}" />
                            <Label Text="{loc:Translate Settings_LanguageHint}" Style="{StaticResource TertiaryLabel}" />
                            <Picker Title="{loc:Translate Settings_LanguageLabel}" ItemsSource="{Binding General.Languages}" SelectedItem="{Binding General.SelectedLanguage}" WidthRequest="160" HorizontalOptions="Start" />

                            <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource LightDivider}, Dark={StaticResource DarkDivider}}" />

                            <Label Text="{loc:Translate Settings_RemindersLabel}" Style="{StaticResource SecondaryLabel}" />
                            <Label Text="{loc:Translate Settings_RemindersHint}" Style="{StaticResource TertiaryLabel}" />
                            <Picker Title="{loc:Translate Settings_FrequencyPickerTitle}" ItemsSource="{Binding General.ReminderFrequencies}" SelectedItem="{Binding General.ReminderFrequency}" ItemDisplayBinding="{Binding ., Converter={StaticResource EnumDisplayConverter}}" WidthRequest="160" HorizontalOptions="Start" />

                            <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource LightDivider}, Dark={StaticResource DarkDivider}}" />

                            <Label Text="{loc:Translate Settings_NewAccountDefaultsLabel}" Style="{StaticResource SecondaryLabel}" />
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                <VerticalStackLayout Grid.Column="0" Spacing="4">
                                    <Label Text="{loc:Translate Settings_DefaultCurrencyLabel}" Style="{StaticResource TertiaryLabel}" />
                                    <Entry Text="{Binding General.DefaultCurrencyText}" Placeholder="EUR" WidthRequest="100" HorizontalOptions="Start" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="4">
                                    <Label Text="{loc:Translate Settings_DefaultAccountTypeLabel}" Style="{StaticResource TertiaryLabel}" />
                                    <Picker Title="{loc:Translate Common_Type}" ItemsSource="{Binding General.AccountTypes}" SelectedItem="{Binding General.DefaultAccountType}" ItemDisplayBinding="{Binding ., Converter={StaticResource EnumDisplayConverter}}" />
                                </VerticalStackLayout>
                            </Grid>

                            <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource LightDivider}, Dark={StaticResource DarkDivider}}" />

                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Grid.Column="0" Spacing="1">
                                    <Label Text="{loc:Translate Settings_PrivacyModeLabel}" Style="{StaticResource SecondaryLabel}" />
                                    <Label Text="{loc:Translate Settings_PrivacyModeHint}" Style="{StaticResource TertiaryLabel}" />
                                </VerticalStackLayout>
                                <Switch Grid.Column="1" IsToggled="{Binding General.PrivacyModeEnabled}" VerticalOptions="Center" />
                            </Grid>

                            <HorizontalStackLayout Spacing="10">
                                <Button Text="{loc:Translate Common_Save}" Command="{Binding General.SaveCommand}" Style="{StaticResource PrimaryButton}" />
                                <Label Text="{Binding General.StatusText}" Style="{StaticResource SecondaryLabel}" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- Dashboard -->
                <VerticalStackLayout Spacing="16" IsVisible="{Binding IsDashboardCategorySelected}">
                    <Border Style="{StaticResource CardBorder}">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="Dashboard" Style="{StaticResource SectionTitleLabel}" />

                            <Label Text="Section order" Style="{StaticResource SecondaryLabel}" />
                            <CollectionView ItemsSource="{Binding DashboardSectionRows}">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="viewModels:DashboardSectionRowViewModel">
                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Padding="0,4">
                                            <Label Grid.Column="0" Text="{Binding Name}" VerticalOptions="Center" />
                                            <Button Grid.Column="1" Text="&#8593;" Command="{Binding MoveUpCommand}" IsEnabled="{Binding CanMoveUp}" Style="{StaticResource QuietButton}" WidthRequest="36" />
                                            <Button Grid.Column="2" Text="&#8595;" Command="{Binding MoveDownCommand}" IsEnabled="{Binding CanMoveDown}" Style="{StaticResource QuietButton}" WidthRequest="36" />
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>

                            <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource LightDivider}, Dark={StaticResource DarkDivider}}" />

                            <Label Text="Forecast period" Style="{StaticResource SecondaryLabel}" />
                            <Label Text="Used by the balance graph's forward-looking window." Style="{StaticResource TertiaryLabel}" />
                            <Picker Title="Period" ItemsSource="{Binding ForecastPeriods}" SelectedItem="{Binding SelectedForecastPeriod}" ItemDisplayBinding="{Binding ., Converter={StaticResource EnumDisplayConverter}}" WidthRequest="160" HorizontalOptions="Start" />
                            <HorizontalStackLayout Spacing="10">
                                <Button Text="Save" Command="{Binding SaveForecastPeriodCommand}" Style="{StaticResource PrimaryButton}" />
                                <Label Text="{Binding DashboardStatusText}" Style="{StaticResource SecondaryLabel}" VerticalOptions="Center" />
                            </HorizontalStackLayout>

                            <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource LightDivider}, Dark={StaticResource DarkDivider}}" />

                            <Label Text="Primary hero number" Style="{StaticResource SecondaryLabel}" />
                            <Label Text="Which number shows big on the dashboard - the other still shows smaller alongside it." Style="{StaticResource TertiaryLabel}" />
                            <HorizontalStackLayout Spacing="6">
                                <Button Text="Free to spend" Command="{Binding SetFreeToSpendPrimaryCommand}" Style="{StaticResource QuietButton}" />
                                <Button Text="Current balance" Command="{Binding SetCurrentBalancePrimaryCommand}" Style="{StaticResource QuietButton}" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource CardBorder}">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="Free to spend" Style="{StaticResource SectionTitleLabel}" />

                            <Label Text="Window" Style="{StaticResource SecondaryLabel}" />
                            <HorizontalStackLayout Spacing="6">
                                <Button Text="Rolling days" Command="{Binding SetWindowRollingCommand}" Style="{StaticResource QuietButton}" />
                                <Button Text="This week" Command="{Binding SetWindowCalendarWeekCommand}" Style="{StaticResource QuietButton}" />
                                <Button Text="This month" Command="{Binding SetWindowCalendarMonthCommand}" Style="{StaticResource QuietButton}" />
                                <Button Text="Until next major payment" Command="{Binding SetWindowUntilMajorPaymentCommand}" Style="{StaticResource QuietButton}" />
                            </HorizontalStackLayout>

                            <VerticalStackLayout Spacing="4" IsVisible="{Binding IsRollingDaysFieldVisible}">
                                <Label Text="Rolling window, in days" Style="{StaticResource SecondaryLabel}" />
                                <Entry Text="{Binding WindowDaysText}" Placeholder="Days" Keyboard="Numeric" WidthRequest="120" HorizontalOptions="Start" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="4" IsVisible="{Binding IsMajorPaymentThresholdFieldVisible}">
                                <Label Text="Major payment threshold" Style="{StaticResource SecondaryLabel}" />
                                <Entry Text="{Binding MajorPaymentThresholdText}" Placeholder="Amount" Keyboard="Numeric" WidthRequest="160" HorizontalOptions="Start" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="4">
                                <Label Text="Safety buffer (always kept out of Free to spend)" Style="{StaticResource SecondaryLabel}" />
                                <Entry Text="{Binding SafetyBufferText}" Placeholder="Amount" Keyboard="Numeric" WidthRequest="160" HorizontalOptions="Start" />
                            </VerticalStackLayout>

                            <HorizontalStackLayout Spacing="10">
                                <Button Text="Save" Command="{Binding SaveFreeToSpendCommand}" Style="{StaticResource PrimaryButton}" />
                                <Label Text="{Binding FreeToSpendStatusText}" Style="{StaticResource SecondaryLabel}" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- Transactions -->
                <VerticalStackLayout Spacing="16" IsVisible="{Binding IsTransactionsCategorySelected}">
                    <Border Style="{StaticResource CardBorder}">
                        <VerticalStackLayout Spacing="10">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                <Label Grid.Column="0" Text="Manage categories" Style="{StaticResource SectionTitleLabel}" VerticalOptions="Center" />
                                <Button Grid.Column="1" Text="Select" Command="{Binding CategoryManagement.ToggleSelectModeCommand}" IsVisible="{Binding CategoryManagement.IsSelectMode, Converter={StaticResource InverseBoolConverter}}" Style="{StaticResource QuietButton}" />
                                <Button Grid.Column="1" Text="Cancel" Command="{Binding CategoryManagement.ToggleSelectModeCommand}" IsVisible="{Binding CategoryManagement.IsSelectMode}" Style="{StaticResource QuietButton}" />
                                <Button Grid.Column="2" Text="Delete selected" Command="{Binding CategoryManagement.DeleteSelectedCommand}" IsVisible="{Binding CategoryManagement.IsSelectMode}" Style="{StaticResource DestructiveButton}" />
                            </Grid>
                            <Label Text="Tap a category to change its color. Press and drag one onto another to merge them together." Style="{StaticResource TertiaryLabel}" />

                            <FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding CategoryManagement.Boxes}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="viewModels:CategoryBoxViewModel">
                                        <Border
                                            StrokeShape="RoundRectangle 10"
                                            Stroke="Transparent"
                                            Background="{Binding Color}"
                                            Padding="12,8"
                                            Margin="4"
                                            MinimumWidthRequest="110">
                                            <!-- Drag/drop lives on the outer Border only; tapping lives on the inner Grid
                                                 below. Stacking Tap + Drag on the identical element is a known MAUI/WinUI
                                                 conflict where the drag recognizer can swallow the tap entirely - keeping
                                                 them on separate (parent/child) elements avoids that. -->
                                            <Border.GestureRecognizers>
                                                <DragGestureRecognizer CanDrag="{Binding IsSelectModeActive, Converter={StaticResource InverseBoolConverter}}" DragStartingCommand="{Binding StartDragCommand}" />
                                                <DropGestureRecognizer AllowDrop="True" DropCommand="{Binding DropCommand}" />
                                            </Border.GestureRecognizers>

                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                                <Grid.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding TapCommand}" />
                                                </Grid.GestureRecognizers>
                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" IsVisible="{Binding IsSelectModeActive}" IsEnabled="False" Scale="0.8" />
                                                <Label Grid.Column="1" Text="{Binding Name}" TextColor="White" FontAttributes="Bold" VerticalOptions="Center" LineBreakMode="TailTruncation" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>

                            <Button
                                Text="+ Add category"
                                Command="{Binding CategoryManagement.StartAddCategoryCommand}"
                                IsVisible="{Binding CategoryManagement.IsAddingCategory, Converter={StaticResource InverseBoolConverter}}"
                                Style="{StaticResource QuietButton}"
                                HorizontalOptions="Start" />

                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" IsVisible="{Binding CategoryManagement.IsAddingCategory}">
                                <Entry Grid.Column="0" Text="{Binding CategoryManagement.NewCategoryName}" Placeholder="Category name" />
                                <Button Grid.Column="1" Text="Add" Command="{Binding CategoryManagement.ConfirmAddCategoryCommand}" Style="{StaticResource PrimaryButton}" />
                                <Button Grid.Column="2" Text="Cancel" Command="{Binding CategoryManagement.CancelAddCategoryCommand}" Style="{StaticResource QuietButton}" />
                            </Grid>
                            <Label Text="{Binding CategoryManagement.StatusText}" IsVisible="{Binding CategoryManagement.IsAddingCategory}" TextColor="{AppThemeBinding Light={StaticResource LightStatusRed}, Dark={StaticResource DarkStatusRed}}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource CardBorder}">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Transactions" Style="{StaticResource SectionTitleLabel}" />

                            <VerticalStackLayout Spacing="4">
                                <Label Text="Resolve upcoming: days ahead to show while collapsed" Style="{StaticResource SecondaryLabel}" />
                                <Entry Text="{Binding ResolveUpcomingNearTermDaysText}" Placeholder="Days" Keyboard="Numeric" WidthRequest="120" HorizontalOptions="Start" />
                            </VerticalStackLayout>

                            <HorizontalStackLayout Spacing="10">
                                <Button Text="Save" Command="{Binding SaveResolveUpcomingCommand}" Style="{StaticResource PrimaryButton}" />
                                <Label Text="{Binding ResolveUpcomingStatusText}" Style="{StaticResource SecondaryLabel}" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource CardBorder}">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Learned categorization rules" Style="{StaticResource SectionTitleLabel}" />
                            <Label Text="What the app has auto-learned from your corrections during statement import. Edit one that learned wrong, or forget it entirely." Style="{StaticResource TertiaryLabel}" />
                            <SearchBar Placeholder="Search by recipient or category" Text="{Binding LearningRules.SearchText}" />
                            <CollectionView ItemsSource="{Binding LearningRules.Rows}">
                                <CollectionView.EmptyView>
                                    <Label Text="Nothing learned yet." Style="{StaticResource TertiaryLabel}" />
                                </CollectionView.EmptyView>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="viewModels:CategoryLearningRuleRowViewModel">
                                        <VerticalStackLayout Padding="0,8" Spacing="8">
                                            <!-- View mode -->
                                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10" IsVisible="{Binding IsEditing, Converter={StaticResource InverseBoolConverter}}">
                                                <VerticalStackLayout Grid.Column="0" Spacing="1">
                                                    <Label Text="{Binding MatchText}" />
                                                    <Label Style="{StaticResource TertiaryLabel}" Text="{Binding TypeText}" />
                                                    <Label Style="{StaticResource TertiaryLabel}" Text="{Binding CategoryName}" />
                                                    <Label Style="{StaticResource TertiaryLabel}" Text="{Binding DestinationAccountName}" IsVisible="{Binding HasDestinationAccount}" />
                                                    <Label Style="{StaticResource TertiaryLabel}" Text="{Binding MatchCountText}" />
                                                </VerticalStackLayout>
                                                <Button Grid.Column="1" Text="Edit" Command="{Binding EditCommand}" Style="{StaticResource QuietButton}" VerticalOptions="Center" />
                                                <Button Grid.Column="2" Text="Forget" Command="{Binding ForgetCommand}" Style="{StaticResource DestructiveButton}" VerticalOptions="Center" />
                                            </Grid>

                                            <!-- Edit mode -->
                                            <VerticalStackLayout Spacing="8" IsVisible="{Binding IsEditing}">
                                                <Entry Text="{Binding EditMatchText}" Placeholder="Recipient text" />
                                                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                                    <Picker Grid.Column="0" Title="Type" ItemsSource="{Binding TypeOptions}" SelectedItem="{Binding EditType}" ItemDisplayBinding="{Binding ., Converter={StaticResource EnumDisplayConverter}}" />
                                                    <Picker Grid.Column="1" Title="Category" ItemsSource="{Binding CategoryOptions}" SelectedItem="{Binding EditCategory}" />
                                                </Grid>
                                                <Picker Title="Other account" ItemsSource="{Binding AccountOptions}" SelectedItem="{Binding EditDestinationAccount}" IsVisible="{Binding IsEditTransferType}" />
                                                <HorizontalStackLayout Spacing="8">
                                                    <Button Text="Save" Command="{Binding SaveEditCommand}" Style="{StaticResource PrimaryButton}" />
                                                    <Button Text="Cancel" Command="{Binding CancelEditCommand}" Style="{StaticResource QuietButton}" />
                                                </HorizontalStackLayout>
                                            </VerticalStackLayout>

                                            <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource LightDivider}, Dark={StaticResource DarkDivider}}" />
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- Data & Security -->
                <VerticalStackLayout Spacing="16" IsVisible="{Binding IsDataCategorySelected}">
                    <Border Style="{StaticResource CardBorder}">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="Security" Style="{StaticResource SectionTitleLabel}" />
                            <Label Text="A PIN is a privacy speedbump against casual snooping, not encryption - the underlying data file stays unencrypted regardless. It's asked for once, when the app starts." Style="{StaticResource TertiaryLabel}" />

                            <Label Text="A PIN is currently set." Style="{StaticResource SecondaryLabel}" IsVisible="{Binding Pin.IsPinSet}" />
                            <Label Text="No PIN is set - the app opens directly." Style="{StaticResource SecondaryLabel}" IsVisible="{Binding Pin.IsPinSet, Converter={StaticResource InverseBoolConverter}}" />

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                <Entry Grid.Column="0" Text="{Binding Pin.NewPinText}" Placeholder="New PIN" IsPassword="True" Keyboard="Numeric" />
                                <Entry Grid.Column="1" Text="{Binding Pin.ConfirmPinText}" Placeholder="Confirm PIN" IsPassword="True" Keyboard="Numeric" />
                            </Grid>
                            <HorizontalStackLayout Spacing="8">
                                <Button Text="Set / change PIN" Command="{Binding Pin.SetPinCommand}" Style="{StaticResource PrimaryButton}" />
                                <Button Text="Remove PIN" Command="{Binding Pin.RemovePinCommand}" IsVisible="{Binding Pin.IsPinSet}" Style="{StaticResource DestructiveButton}" />
                            </HorizontalStackLayout>

                            <Label Text="{Binding Pin.StatusText}" Style="{StaticResource SecondaryLabel}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource CardBorder}">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="Data" Style="{StaticResource SectionTitleLabel}" />

                            <VerticalStackLayout Spacing="4">
                                <Label Text="Backup" Style="{StaticResource SecondaryLabel}" />
                                <Button Text="Export backup" Command="{Binding Data.ExportCommand}" Style="{StaticResource QuietButton}" HorizontalOptions="Start" />
                                <Label Text="{Binding Data.ExportStatusText}" Style="{StaticResource TertiaryLabel}" />
                            </VerticalStackLayout>

                            <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource LightDivider}, Dark={StaticResource DarkDivider}}" />

                            <VerticalStackLayout Spacing="4">
                                <Label Text="Automatic backups" Style="{StaticResource SecondaryLabel}" />
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Grid.Column="0" Text="Enable automatic backups" VerticalOptions="Center" />
                                    <Switch Grid.Column="1" IsToggled="{Binding Data.AutoBackupEnabled}" />
                                </Grid>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                                        <Label Text="Every (days)" Style="{StaticResource TertiaryLabel}" />
                                        <Entry Text="{Binding Data.AutoBackupFrequencyDaysText}" Keyboard="Numeric" WidthRequest="100" HorizontalOptions="Start" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                                        <Label Text="Keep last N backups" Style="{StaticResource TertiaryLabel}" />
                                        <Entry Text="{Binding Data.AutoBackupRetentionCountText}" Keyboard="Numeric" WidthRequest="100" HorizontalOptions="Start" />
                                    </VerticalStackLayout>
                                </Grid>
                                <Label Text="{Binding Data.LastAutoBackupText, StringFormat='Last automatic backup: {0}'}" Style="{StaticResource TertiaryLabel}" />
                                <HorizontalStackLayout Spacing="10">
                                    <Button Text="Save" Command="{Binding Data.SaveAutoBackupSettingsCommand}" Style="{StaticResource PrimaryButton}" />
                                    <Label Text="{Binding Data.AutoBackupStatusText}" Style="{StaticResource SecondaryLabel}" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>

                            <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource LightDivider}, Dark={StaticResource DarkDivider}}" />

                            <VerticalStackLayout Spacing="4">
                                <Label Text="Diagnostics" Style="{StaticResource SecondaryLabel}" />
                                <Label Text="{Binding Data.AppVersionText}" Style="{StaticResource TertiaryLabel}" />
                                <HorizontalStackLayout Spacing="8">
                                    <Button Text="Open diagnostics log" Command="{Binding Data.OpenDiagnosticsLogCommand}" Style="{StaticResource QuietButton}" />
                                    <Button Text="Open data folder" Command="{Binding Data.OpenDataFolderCommand}" Style="{StaticResource QuietButton}" />
                                </HorizontalStackLayout>
                                <Label Text="{Binding Data.DiagnosticsStatusText}" Style="{StaticResource TertiaryLabel}" />
                            </VerticalStackLayout>

                            <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource LightDivider}, Dark={StaticResource DarkDivider}}" />

                            <VerticalStackLayout Spacing="4">
                                <Label Text="Restore from backup" Style="{StaticResource SecondaryLabel}" />
                                <Button
                                    Text="Choose backup file"
                                    Command="{Binding Data.PickRestoreFileCommand}"
                                    IsVisible="{Binding Data.HasPendingRestore, Converter={StaticResource InverseBoolConverter}}"
                                    Style="{StaticResource QuietButton}"
                                    HorizontalOptions="Start" />

                                <VerticalStackLayout Spacing="6" IsVisible="{Binding Data.HasPendingRestore}">
                                    <Label Text="{Binding Data.PendingRestoreFileName}" />
                                    <Label Text="{Binding Data.PendingRestoreSummaryText}" Style="{StaticResource TertiaryLabel}" />
                                    <HorizontalStackLayout Spacing="8">
                                        <Button Text="Merge" Command="{Binding Data.ConfirmMergeCommand}" IsEnabled="{Binding Data.PendingRestoreIsValid}" Style="{StaticResource PrimaryButton}" />
                                        <Button Text="Replace everything" Command="{Binding Data.ConfirmReplaceCommand}" IsEnabled="{Binding Data.PendingRestoreIsValid}" Style="{StaticResource DestructiveButton}" />
                                        <Button Text="Cancel" Command="{Binding Data.CancelRestoreCommand}" Style="{StaticResource QuietButton}" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>

                                <Label Text="{Binding Data.RestoreStatusText}" Style="{StaticResource TertiaryLabel}" />
                            </VerticalStackLayout>

                            <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource LightDivider}, Dark={StaticResource DarkDivider}}" />

                            <VerticalStackLayout Spacing="4">
                                <Label Text="Delete all local data" Style="{StaticResource SecondaryLabel}" />
                                <Button
                                    Text="Delete all local data"
                                    Command="{Binding Data.RequestDeleteAllCommand}"
                                    IsVisible="{Binding Data.IsConfirmingDeleteAll, Converter={StaticResource InverseBoolConverter}}"
                                    Style="{StaticResource DestructiveButton}"
                                    HorizontalOptions="Start" />

                                <VerticalStackLayout Spacing="6" IsVisible="{Binding Data.IsConfirmingDeleteAll}">
                                    <Label
                                        Text="This permanently deletes every account, transaction, category, scheduled rule, and goal. This cannot be undone."
                                        Style="{StaticResource TertiaryLabel}"
                                        TextColor="{AppThemeBinding Light={StaticResource LightStatusRed}, Dark={StaticResource DarkStatusRed}}" />
                                    <HorizontalStackLayout Spacing="8">
                                        <Button Text="Yes, delete everything" Command="{Binding Data.ConfirmDeleteAllCommand}" Style="{StaticResource DestructiveButton}" />
                                        <Button Text="Cancel" Command="{Binding Data.CancelDeleteAllCommand}" Style="{StaticResource QuietButton}" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>

                                <Label Text="{Binding Data.DeleteAllStatusText}" Style="{StaticResource TertiaryLabel}" />
                            </VerticalStackLayout>

                            <ActivityIndicator IsRunning="{Binding Data.IsBusy}" IsVisible="{Binding Data.IsBusy}" HorizontalOptions="Start" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>

    <!-- Color-picker popup: a single shared overlay (not per-box inline) so its swatches can be
         shown larger than any one box, and so tapping anywhere outside it closes it. The backdrop
         Grid below catches every tap outside the popup's own bounds; a tap on the popup itself is
         consumed by the popup's own content first and never reaches the backdrop beneath it. -->
    <Grid IsVisible="{Binding CategoryManagement.IsColorPickerOpen}" Background="Transparent">
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding CategoryManagement.CloseColorPickerCommand}" />
        </Grid.GestureRecognizers>
    </Grid>

    <Border
        Style="{StaticResource CardBorder}"
        IsVisible="{Binding CategoryManagement.IsColorPickerOpen}"
        HorizontalOptions="Center"
        VerticalOptions="Center"
        Padding="20"
        WidthRequest="260">
        <Border.Shadow>
            <Shadow Brush="Black" Offset="0,6" Radius="16" Opacity="0.18" />
        </Border.Shadow>
        <VerticalStackLayout Spacing="14">
            <Label Text="{Binding CategoryManagement.ActiveColorPickerBox.Name, StringFormat='Color for {0}'}" Style="{StaticResource SectionTitleLabel}" HorizontalTextAlignment="Center" />
            <FlexLayout Wrap="Wrap" HorizontalOptions="Center" BindableLayout.ItemsSource="{Binding CategoryManagement.ActiveColorPickerBox.ColorSwatches}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:CategoryColorSwatchViewModel">
                        <Border
                            WidthRequest="40"
                            HeightRequest="40"
                            Margin="6"
                            StrokeShape="RoundRectangle 20"
                            Stroke="{AppThemeBinding Light={StaticResource LightAccent}, Dark={StaticResource DarkAccent}}"
                            StrokeThickness="{Binding SelectionStrokeThickness}"
                            Background="{Binding Color}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SelectCommand}" />
                            </Border.GestureRecognizers>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>
        </VerticalStackLayout>
    </Border>
    </Grid>
</ContentPage>
