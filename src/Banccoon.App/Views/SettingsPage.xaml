<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Banccoon.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:Banccoon.App.ViewModels"
    x:DataType="viewModels:SettingsViewModel"
    Title="Settings"
    BackgroundColor="{AppThemeBinding Light={StaticResource LightPageBackground}, Dark={StaticResource DarkPageBackground}}">

    <Grid ColumnDefinitions="220,*" Padding="32" ColumnSpacing="24">

        <VerticalStackLayout Grid.Column="0" Spacing="4">
            <Label Text="Settings" Style="{StaticResource ScreenTitleLabel}" Margin="0,0,0,12" />
            <CollectionView ItemsSource="{Binding Categories}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:SettingsCategoryRowViewModel">
                        <Border
                            StrokeShape="RoundRectangle 8"
                            Stroke="Transparent"
                            Padding="12,10"
                            Margin="0,1"
                            Background="{Binding IsSelected, Converter={StaticResource SelectedNavBackgroundConverter}}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SelectCommand}" />
                            </Border.GestureRecognizers>
                            <Label Text="{Binding Name}" />
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>

        <ScrollView Grid.Column="1">
            <VerticalStackLayout Spacing="16">

                <!-- General -->
                <VerticalStackLayout Spacing="16" IsVisible="{Binding IsGeneralCategorySelected}">
                    <Border Style="{StaticResource CardBorder}">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Appearance" Style="{StaticResource SectionTitleLabel}" />
                            <Label Text="Theme" Style="{StaticResource SecondaryLabel}" />
                            <HorizontalStackLayout Spacing="6">
                                <Button Text="Light" Command="{Binding SetLightCommand}" Style="{StaticResource QuietButton}" />
                                <Button Text="Dark" Command="{Binding SetDarkCommand}" Style="{StaticResource QuietButton}" />
                                <Button Text="System" Command="{Binding SetSystemCommand}" Style="{StaticResource QuietButton}" />
                            </HorizontalStackLayout>

                            <Label Text="Category colors" Style="{StaticResource SecondaryLabel}" />
                            <Label Text="Set per-category in Transactions -&gt; Categories. Exact shades still TBD." Style="{StaticResource TertiaryLabel}" />
                            <HorizontalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding CategoryColorPreview}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="Color">
                                        <Border WidthRequest="22" HeightRequest="22" StrokeShape="RoundRectangle 11" Stroke="Transparent" Background="{Binding .}" />
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource CardBorder}">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="General" Style="{StaticResource SectionTitleLabel}" />

                            <Label Text="Language" Style="{StaticResource SecondaryLabel}" />
                            <Label Text="Only affects newly-parsed statement text going forward - the app's own screens don't translate yet, that's a separate, larger project." Style="{StaticResource TertiaryLabel}" />
                            <Picker Title="Language" ItemsSource="{Binding General.Languages}" SelectedItem="{Binding General.SelectedLanguage}" WidthRequest="160" HorizontalOptions="Start" />

                            <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource LightDivider}, Dark={StaticResource DarkDivider}}" />

                            <Label Text="Reminders" Style="{StaticResource SecondaryLabel}" />
                            <Label Text="How often to be reminded of upcoming bills. Desktop notification delivery isn't wired up yet - this saves the preference for when it is." Style="{StaticResource TertiaryLabel}" />
                            <Picker Title="Frequency" ItemsSource="{Binding General.ReminderFrequencies}" SelectedItem="{Binding General.ReminderFrequency}" WidthRequest="160" HorizontalOptions="Start" />

                            <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource LightDivider}, Dark={StaticResource DarkDivider}}" />

                            <Label Text="New account defaults" Style="{StaticResource SecondaryLabel}" />
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                <VerticalStackLayout Grid.Column="0" Spacing="4">
                                    <Label Text="Default currency" Style="{StaticResource TertiaryLabel}" />
                                    <Entry Text="{Binding General.DefaultCurrencyText}" Placeholder="EUR" WidthRequest="100" HorizontalOptions="Start" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="4">
                                    <Label Text="Default account type" Style="{StaticResource TertiaryLabel}" />
                                    <Picker Title="Type" ItemsSource="{Binding General.AccountTypes}" SelectedItem="{Binding General.DefaultAccountType}" />
                                </VerticalStackLayout>
                            </Grid>

                            <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource LightDivider}, Dark={StaticResource DarkDivider}}" />

                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Grid.Column="0" Spacing="1">
                                    <Label Text="Privacy mode" Style="{StaticResource SecondaryLabel}" />
                                    <Label Text="Hides every amount behind &#8226;&#8226;&#8226;&#8226; app-wide." Style="{StaticResource TertiaryLabel}" />
                                </VerticalStackLayout>
                                <Switch Grid.Column="1" IsToggled="{Binding General.PrivacyModeEnabled}" VerticalOptions="Center" />
                            </Grid>

                            <HorizontalStackLayout Spacing="10">
                                <Button Text="Save" Command="{Binding General.SaveCommand}" Style="{StaticResource PrimaryButton}" />
                                <Label Text="{Binding General.StatusText}" Style="{StaticResource SecondaryLabel}" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- Security & Privacy -->
                <VerticalStackLayout Spacing="16" IsVisible="{Binding IsSecurityCategorySelected}">
                    <Border Style="{StaticResource CardBorder}">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="Security" Style="{StaticResource SectionTitleLabel}" />
                            <Label Text="A PIN is a privacy speedbump against casual snooping, not encryption - the underlying data file stays unencrypted regardless." Style="{StaticResource TertiaryLabel}" />

                            <Label Text="A PIN is currently set." Style="{StaticResource SecondaryLabel}" IsVisible="{Binding AppLock.IsPinSet}" />
                            <Label Text="No PIN is set - the app opens directly." Style="{StaticResource SecondaryLabel}" IsVisible="{Binding AppLock.IsPinSet, Converter={StaticResource InverseBoolConverter}}" />

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                <Entry Grid.Column="0" Text="{Binding AppLock.NewPinText}" Placeholder="New PIN" IsPassword="True" Keyboard="Numeric" />
                                <Entry Grid.Column="1" Text="{Binding AppLock.ConfirmPinText}" Placeholder="Confirm PIN" IsPassword="True" Keyboard="Numeric" />
                            </Grid>
                            <HorizontalStackLayout Spacing="8">
                                <Button Text="Set / change PIN" Command="{Binding AppLock.SetPinCommand}" Style="{StaticResource PrimaryButton}" />
                                <Button Text="Remove PIN" Command="{Binding AppLock.RemovePinCommand}" IsVisible="{Binding AppLock.IsPinSet}" Style="{StaticResource DestructiveButton}" />
                            </HorizontalStackLayout>

                            <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource LightDivider}, Dark={StaticResource DarkDivider}}" />

                            <Label Text="Auto-lock after inactivity" Style="{StaticResource SecondaryLabel}" />
                            <Label Text="Approximate - checked whenever you switch tabs, not on every mouse movement." Style="{StaticResource TertiaryLabel}" />
                            <Entry Text="{Binding AppLock.AutoLockMinutesText}" Placeholder="Minutes" Keyboard="Numeric" WidthRequest="120" HorizontalOptions="Start" />
                            <Button Text="Save" Command="{Binding AppLock.SaveAutoLockCommand}" Style="{StaticResource PrimaryButton}" HorizontalOptions="Start" />

                            <Label Text="{Binding AppLock.StatusText}" Style="{StaticResource SecondaryLabel}" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- Dashboard -->
                <VerticalStackLayout Spacing="16" IsVisible="{Binding IsDashboardCategorySelected}">
                    <Border Style="{StaticResource CardBorder}">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="Dashboard" Style="{StaticResource SectionTitleLabel}" />

                            <Label Text="Section order" Style="{StaticResource SecondaryLabel}" />
                            <CollectionView ItemsSource="{Binding DashboardSectionRows}">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="viewModels:DashboardSectionRowViewModel">
                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Padding="0,4">
                                            <Label Grid.Column="0" Text="{Binding Name}" VerticalOptions="Center" />
                                            <Button Grid.Column="1" Text="&#8593;" Command="{Binding MoveUpCommand}" IsEnabled="{Binding CanMoveUp}" Style="{StaticResource QuietButton}" WidthRequest="36" />
                                            <Button Grid.Column="2" Text="&#8595;" Command="{Binding MoveDownCommand}" IsEnabled="{Binding CanMoveDown}" Style="{StaticResource QuietButton}" WidthRequest="36" />
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>

                            <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource LightDivider}, Dark={StaticResource DarkDivider}}" />

                            <Label Text="Forecast period" Style="{StaticResource SecondaryLabel}" />
                            <Label Text="Used by the balance graph's forward-looking window." Style="{StaticResource TertiaryLabel}" />
                            <Picker Title="Period" ItemsSource="{Binding ForecastPeriods}" SelectedItem="{Binding SelectedForecastPeriod}" WidthRequest="160" HorizontalOptions="Start" />
                            <HorizontalStackLayout Spacing="10">
                                <Button Text="Save" Command="{Binding SaveForecastPeriodCommand}" Style="{StaticResource PrimaryButton}" />
                                <Label Text="{Binding DashboardStatusText}" Style="{StaticResource SecondaryLabel}" VerticalOptions="Center" />
                            </HorizontalStackLayout>

                            <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource LightDivider}, Dark={StaticResource DarkDivider}}" />

                            <Label Text="Primary hero number" Style="{StaticResource SecondaryLabel}" />
                            <Label Text="Which number shows big on the dashboard - the other still shows smaller alongside it." Style="{StaticResource TertiaryLabel}" />
                            <HorizontalStackLayout Spacing="6">
                                <Button Text="Free to spend" Command="{Binding SetFreeToSpendPrimaryCommand}" Style="{StaticResource QuietButton}" />
                                <Button Text="Current balance" Command="{Binding SetCurrentBalancePrimaryCommand}" Style="{StaticResource QuietButton}" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource CardBorder}">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="Free to spend" Style="{StaticResource SectionTitleLabel}" />

                            <Label Text="Window" Style="{StaticResource SecondaryLabel}" />
                            <HorizontalStackLayout Spacing="6">
                                <Button Text="Rolling days" Command="{Binding SetWindowRollingCommand}" Style="{StaticResource QuietButton}" />
                                <Button Text="This week" Command="{Binding SetWindowCalendarWeekCommand}" Style="{StaticResource QuietButton}" />
                                <Button Text="This month" Command="{Binding SetWindowCalendarMonthCommand}" Style="{StaticResource QuietButton}" />
                                <Button Text="Until next major payment" Command="{Binding SetWindowUntilMajorPaymentCommand}" Style="{StaticResource QuietButton}" />
                            </HorizontalStackLayout>

                            <VerticalStackLayout Spacing="4" IsVisible="{Binding IsRollingDaysFieldVisible}">
                                <Label Text="Rolling window, in days" Style="{StaticResource SecondaryLabel}" />
                                <Entry Text="{Binding WindowDaysText}" Placeholder="Days" Keyboard="Numeric" WidthRequest="120" HorizontalOptions="Start" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="4" IsVisible="{Binding IsMajorPaymentThresholdFieldVisible}">
                                <Label Text="Major payment threshold" Style="{StaticResource SecondaryLabel}" />
                                <Entry Text="{Binding MajorPaymentThresholdText}" Placeholder="Amount" Keyboard="Numeric" WidthRequest="160" HorizontalOptions="Start" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="4">
                                <Label Text="Safety buffer (always kept out of Free to spend)" Style="{StaticResource SecondaryLabel}" />
                                <Entry Text="{Binding SafetyBufferText}" Placeholder="Amount" Keyboard="Numeric" WidthRequest="160" HorizontalOptions="Start" />
                            </VerticalStackLayout>

                            <HorizontalStackLayout Spacing="10">
                                <Button Text="Save" Command="{Binding SaveFreeToSpendCommand}" Style="{StaticResource PrimaryButton}" />
                                <Label Text="{Binding FreeToSpendStatusText}" Style="{StaticResource SecondaryLabel}" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- Transactions -->
                <VerticalStackLayout Spacing="16" IsVisible="{Binding IsTransactionsCategorySelected}">
                    <Border Style="{StaticResource CardBorder}">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Transactions" Style="{StaticResource SectionTitleLabel}" />

                            <VerticalStackLayout Spacing="4">
                                <Label Text="Resolve upcoming: days ahead to show while collapsed" Style="{StaticResource SecondaryLabel}" />
                                <Entry Text="{Binding ResolveUpcomingNearTermDaysText}" Placeholder="Days" Keyboard="Numeric" WidthRequest="120" HorizontalOptions="Start" />
                            </VerticalStackLayout>

                            <HorizontalStackLayout Spacing="10">
                                <Button Text="Save" Command="{Binding SaveResolveUpcomingCommand}" Style="{StaticResource PrimaryButton}" />
                                <Label Text="{Binding ResolveUpcomingStatusText}" Style="{StaticResource SecondaryLabel}" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource CardBorder}">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Learned categorization rules" Style="{StaticResource SectionTitleLabel}" />
                            <Label Text="What the app has auto-learned from your corrections during statement import. Forget one if it learned something wrong." Style="{StaticResource TertiaryLabel}" />
                            <CollectionView ItemsSource="{Binding LearningRules.Rows}">
                                <CollectionView.EmptyView>
                                    <Label Text="Nothing learned yet." Style="{StaticResource TertiaryLabel}" />
                                </CollectionView.EmptyView>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="viewModels:CategoryLearningRuleRowViewModel">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Padding="0,8">
                                            <VerticalStackLayout Grid.Column="0" Spacing="1">
                                                <Label Text="{Binding MatchText}" />
                                                <Label Style="{StaticResource TertiaryLabel}" Text="{Binding TypeText}" />
                                                <Label Style="{StaticResource TertiaryLabel}" Text="{Binding CategoryName}" />
                                                <Label Style="{StaticResource TertiaryLabel}" Text="{Binding DestinationAccountName}" IsVisible="{Binding HasDestinationAccount}" />
                                                <Label Style="{StaticResource TertiaryLabel}" Text="{Binding MatchCountText}" />
                                            </VerticalStackLayout>
                                            <Button Grid.Column="1" Text="Forget" Command="{Binding ForgetCommand}" Style="{StaticResource DestructiveButton}" VerticalOptions="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- Data & Backup -->
                <VerticalStackLayout Spacing="16" IsVisible="{Binding IsDataCategorySelected}">
                    <Border Style="{StaticResource CardBorder}">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="Data" Style="{StaticResource SectionTitleLabel}" />

                            <VerticalStackLayout Spacing="4">
                                <Label Text="Backup" Style="{StaticResource SecondaryLabel}" />
                                <Button Text="Export backup" Command="{Binding Data.ExportCommand}" Style="{StaticResource QuietButton}" HorizontalOptions="Start" />
                                <Label Text="{Binding Data.ExportStatusText}" Style="{StaticResource TertiaryLabel}" />
                            </VerticalStackLayout>

                            <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource LightDivider}, Dark={StaticResource DarkDivider}}" />

                            <VerticalStackLayout Spacing="4">
                                <Label Text="Automatic backups" Style="{StaticResource SecondaryLabel}" />
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Grid.Column="0" Text="Enable automatic backups" VerticalOptions="Center" />
                                    <Switch Grid.Column="1" IsToggled="{Binding Data.AutoBackupEnabled}" />
                                </Grid>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                                        <Label Text="Every (days)" Style="{StaticResource TertiaryLabel}" />
                                        <Entry Text="{Binding Data.AutoBackupFrequencyDaysText}" Keyboard="Numeric" WidthRequest="100" HorizontalOptions="Start" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                                        <Label Text="Keep last N backups" Style="{StaticResource TertiaryLabel}" />
                                        <Entry Text="{Binding Data.AutoBackupRetentionCountText}" Keyboard="Numeric" WidthRequest="100" HorizontalOptions="Start" />
                                    </VerticalStackLayout>
                                </Grid>
                                <Label Text="{Binding Data.LastAutoBackupText, StringFormat='Last automatic backup: {0}'}" Style="{StaticResource TertiaryLabel}" />
                                <HorizontalStackLayout Spacing="10">
                                    <Button Text="Save" Command="{Binding Data.SaveAutoBackupSettingsCommand}" Style="{StaticResource PrimaryButton}" />
                                    <Label Text="{Binding Data.AutoBackupStatusText}" Style="{StaticResource SecondaryLabel}" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>

                            <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource LightDivider}, Dark={StaticResource DarkDivider}}" />

                            <VerticalStackLayout Spacing="4">
                                <Label Text="Diagnostics" Style="{StaticResource SecondaryLabel}" />
                                <Label Text="{Binding Data.AppVersionText}" Style="{StaticResource TertiaryLabel}" />
                                <HorizontalStackLayout Spacing="8">
                                    <Button Text="Open diagnostics log" Command="{Binding Data.OpenDiagnosticsLogCommand}" Style="{StaticResource QuietButton}" />
                                    <Button Text="Open data folder" Command="{Binding Data.OpenDataFolderCommand}" Style="{StaticResource QuietButton}" />
                                </HorizontalStackLayout>
                                <Label Text="{Binding Data.DiagnosticsStatusText}" Style="{StaticResource TertiaryLabel}" />
                            </VerticalStackLayout>

                            <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource LightDivider}, Dark={StaticResource DarkDivider}}" />

                            <VerticalStackLayout Spacing="4">
                                <Label Text="Restore from backup" Style="{StaticResource SecondaryLabel}" />
                                <Button
                                    Text="Choose backup file"
                                    Command="{Binding Data.PickRestoreFileCommand}"
                                    IsVisible="{Binding Data.HasPendingRestore, Converter={StaticResource InverseBoolConverter}}"
                                    Style="{StaticResource QuietButton}"
                                    HorizontalOptions="Start" />

                                <VerticalStackLayout Spacing="6" IsVisible="{Binding Data.HasPendingRestore}">
                                    <Label Text="{Binding Data.PendingRestoreFileName}" />
                                    <Label Text="{Binding Data.PendingRestoreSummaryText}" Style="{StaticResource TertiaryLabel}" />
                                    <HorizontalStackLayout Spacing="8">
                                        <Button Text="Merge" Command="{Binding Data.ConfirmMergeCommand}" IsEnabled="{Binding Data.PendingRestoreIsValid}" Style="{StaticResource PrimaryButton}" />
                                        <Button Text="Replace everything" Command="{Binding Data.ConfirmReplaceCommand}" IsEnabled="{Binding Data.PendingRestoreIsValid}" Style="{StaticResource DestructiveButton}" />
                                        <Button Text="Cancel" Command="{Binding Data.CancelRestoreCommand}" Style="{StaticResource QuietButton}" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>

                                <Label Text="{Binding Data.RestoreStatusText}" Style="{StaticResource TertiaryLabel}" />
                            </VerticalStackLayout>

                            <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource LightDivider}, Dark={StaticResource DarkDivider}}" />

                            <VerticalStackLayout Spacing="4">
                                <Label Text="Delete all local data" Style="{StaticResource SecondaryLabel}" />
                                <Button
                                    Text="Delete all local data"
                                    Command="{Binding Data.RequestDeleteAllCommand}"
                                    IsVisible="{Binding Data.IsConfirmingDeleteAll, Converter={StaticResource InverseBoolConverter}}"
                                    Style="{StaticResource DestructiveButton}"
                                    HorizontalOptions="Start" />

                                <VerticalStackLayout Spacing="6" IsVisible="{Binding Data.IsConfirmingDeleteAll}">
                                    <Label
                                        Text="This permanently deletes every account, transaction, category, scheduled rule, and goal. This cannot be undone."
                                        Style="{StaticResource TertiaryLabel}"
                                        TextColor="{AppThemeBinding Light={StaticResource LightStatusRed}, Dark={StaticResource DarkStatusRed}}" />
                                    <HorizontalStackLayout Spacing="8">
                                        <Button Text="Yes, delete everything" Command="{Binding Data.ConfirmDeleteAllCommand}" Style="{StaticResource DestructiveButton}" />
                                        <Button Text="Cancel" Command="{Binding Data.CancelDeleteAllCommand}" Style="{StaticResource QuietButton}" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>

                                <Label Text="{Binding Data.DeleteAllStatusText}" Style="{StaticResource TertiaryLabel}" />
                            </VerticalStackLayout>

                            <ActivityIndicator IsRunning="{Binding Data.IsBusy}" IsVisible="{Binding Data.IsBusy}" HorizontalOptions="Start" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
