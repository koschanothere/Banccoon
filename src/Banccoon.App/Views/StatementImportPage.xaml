<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Banccoon.App.Views.StatementImportPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:Banccoon.App.ViewModels"
    xmlns:loc="clr-namespace:Banccoon.App.Localization"
    x:DataType="viewModels:StatementImportViewModel"
    Title="{loc:Translate StatementImport_Title}"
    BackgroundColor="{AppThemeBinding Light={StaticResource LightPageBackground}, Dark={StaticResource DarkPageBackground}}">

    <ContentPage.Resources>
        <!-- One review row, shared by all three blocks of step 3. "Calmer" layout: no type picker by
             default - the amount's colour is the detected type (income green, transfer purple,
             expense plain; TransactionTypeColorConverter) and clicking the amount opens the picker. -->
        <DataTemplate x:Key="ReviewRowTemplate" x:DataType="viewModels:StatementImportRowViewModel">
            <VerticalStackLayout Spacing="0">
                <Grid RowDefinitions="Auto,Auto" RowSpacing="6" Padding="0,8">
                    <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto" ColumnSpacing="8">
                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" IsVisible="{Binding IsSelectModeActive}" />
                        <Label Grid.Column="1" Text="{Binding DateText}" Style="{StaticResource TertiaryLabel}" VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="2" Spacing="1" VerticalOptions="Center">
                            <Label Text="{Binding Description}" />
                            <Label Text="{loc:Translate StatementImport_PossibleDuplicate}" IsVisible="{Binding IsDuplicate}" Style="{StaticResource TertiaryLabel}"
                                   TextColor="{AppThemeBinding Light={StaticResource LightStatusOrange}, Dark={StaticResource DarkStatusOrange}}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="3" Text="{Binding AmountText}" FontAttributes="Bold" VerticalOptions="Center"
                               TextColor="{Binding Type, Converter={StaticResource TransactionTypeColorConverter}}"
                               ToolTipProperties.Text="{Binding TypeToolTipText}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleTypeEditorCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                        <HorizontalStackLayout Grid.Column="4" Spacing="6" VerticalOptions="Center">
                            <Border StrokeShape="RoundRectangle 8" StrokeThickness="2" Stroke="{Binding CategoryBorderColor}" Padding="0">
                                <Picker Title="{loc:Translate Common_Category}" ItemsSource="{Binding CategoryOptions}" SelectedItem="{Binding Category}" WidthRequest="140" />
                            </Border>
                            <!-- Enter or Add creates the category at once, so every other row can pick it too. -->
                            <Entry Placeholder="{loc:Translate Common_NewCategoryNamePlaceholder}" Text="{Binding NewCategoryName}" ReturnCommand="{Binding CreateCategoryCommand}" IsVisible="{Binding IsCreatingNewCategory}" WidthRequest="140" />
                            <Button Text="{loc:Translate Common_Add}" Command="{Binding CreateCategoryCommand}" IsVisible="{Binding IsCreatingNewCategory}" Style="{StaticResource QuietButton}" />
                        </HorizontalStackLayout>
                        <Button Grid.Column="5" Text="{loc:Translate Common_Skip}" Command="{Binding SkipCommand}" IsEnabled="{Binding IsIdle}" Style="{StaticResource QuietButton}" />
                        <Button Grid.Column="6" Text="{loc:Translate Common_Approve}" Command="{Binding ApproveCommand}" IsEnabled="{Binding IsIdle}" Style="{StaticResource PrimaryButton}" />
                    </Grid>
                    <HorizontalStackLayout Grid.Row="1" Spacing="8" HorizontalOptions="End">
                        <Picker Title="{loc:Translate Common_Type}" ItemsSource="{Binding TypeOptions}" SelectedItem="{Binding Type}" ItemDisplayBinding="{Binding ., Converter={StaticResource EnumDisplayConverter}}" IsVisible="{Binding IsTypeEditorOpen}" WidthRequest="130" />
                        <Picker Title="{loc:Translate StatementImport_OtherAccountPickerTitle}" ItemsSource="{Binding OtherAccountOptions}" SelectedItem="{Binding OtherAccount}" IsVisible="{Binding IsTransferType}" WidthRequest="160" />
                    </HorizontalStackLayout>
                </Grid>
                <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource LightDivider}, Dark={StaticResource DarkDivider}}" />
            </VerticalStackLayout>
        </DataTemplate>

        <!-- One sender's ready rows ("Group by name"). Two or more: a collapsed line with the name,
             count, total, category and its own "Approve all"; expanding shows the rows beside a rail
             in the category's colour. One: just the row. DisplayedRows stays empty while collapsed,
             so a closed group costs one line to draw. -->
        <DataTemplate x:Key="ReviewGroupTemplate" x:DataType="viewModels:StatementImportRowGroupViewModel">
            <VerticalStackLayout Spacing="0">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="10" Padding="0,8" IsVisible="{Binding IsMultiple}">
                    <Grid Grid.Column="0" WidthRequest="24" HeightRequest="24" VerticalOptions="Center"
                          Rotation="{Binding IsExpanded, Converter={StaticResource ExpandedRotationConverter}}">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleExpandedCommand}" />
                        </Grid.GestureRecognizers>
                        <BoxView WidthRequest="9" HeightRequest="2" CornerRadius="1" Rotation="45" TranslationX="-3" TranslationY="-2"
                                 Color="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
                        <BoxView WidthRequest="9" HeightRequest="2" CornerRadius="1" Rotation="-45" TranslationX="3" TranslationY="-2"
                                 Color="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
                    </Grid>
                    <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                        <VerticalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleExpandedCommand}" />
                        </VerticalStackLayout.GestureRecognizers>
                        <Label Text="{Binding Name}" FontAttributes="Bold" />
                        <Label Text="{Binding CountText}" Style="{StaticResource TertiaryLabel}" />
                    </VerticalStackLayout>
                    <Label Grid.Column="2" Text="{Binding TotalText}" FontAttributes="Bold" VerticalOptions="Center"
                           TextColor="{Binding Type, Converter={StaticResource TransactionTypeColorConverter}}" />
                    <Border Grid.Column="3" StrokeShape="RoundRectangle 8" StrokeThickness="2" Stroke="{Binding CategoryColor}" Padding="10,4" VerticalOptions="Center">
                        <Label Text="{Binding CategoryName}" />
                    </Border>
                    <Button Grid.Column="4" Text="{Binding ApproveText}" Command="{Binding ApproveCommand}" Style="{StaticResource PrimaryButton}" />
                </Grid>
                <Grid ColumnDefinitions="Auto,*">
                    <BoxView Grid.Column="0" WidthRequest="3" CornerRadius="1.5" Margin="10,0,14,0" Color="{Binding CategoryColor}" IsVisible="{Binding IsMultiple}" />
                    <VerticalStackLayout Grid.Column="1" BindableLayout.ItemsSource="{Binding DisplayedRows}" BindableLayout.ItemTemplate="{StaticResource ReviewRowTemplate}" />
                </Grid>
                <BoxView HeightRequest="1" IsVisible="{Binding IsMultiple}" Color="{AppThemeBinding Light={StaticResource LightDivider}, Dark={StaticResource DarkDivider}}" />
            </VerticalStackLayout>
        </DataTemplate>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="32" Spacing="16">

            <Grid ColumnDefinitions="*,Auto">
                <Label Grid.Column="0" Text="{loc:Translate StatementImport_Header}" Style="{StaticResource ScreenTitleLabel}" />
                <Button Grid.Column="1" Text="{loc:Translate Common_Close}" Clicked="OnCloseClicked" Style="{StaticResource QuietButton}" />
            </Grid>

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HorizontalOptions="Start" />

            <!-- Step 1: pick file -->
            <Border Style="{StaticResource CardBorder}" IsVisible="{Binding IsPickFileStep}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{loc:Translate StatementImport_Step1Header}" Style="{StaticResource SectionTitleLabel}" />
                    <Button Text="{loc:Translate StatementImport_ChooseFileButton}" Command="{Binding PickFileCommand}" Style="{StaticResource QuietButton}" HorizontalOptions="Start" />
                    <Label Text="{Binding FileName}" IsVisible="{Binding HasStatement}" />
                    <Label Text="{Binding PreviewStatusText}" Style="{StaticResource SecondaryLabel}" />

                    <VerticalStackLayout Spacing="8" IsVisible="{Binding HasStatement}">
                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource LightDivider}, Dark={StaticResource DarkDivider}}" />
                        <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="12">
                            <Label Grid.Row="0" Grid.Column="0" Text="{loc:Translate StatementImport_ParserLabel}" Style="{StaticResource TertiaryLabel}" />
                            <Label Grid.Row="0" Grid.Column="1" Text="{Binding ParserNameText}" />
                            <Label Grid.Row="1" Grid.Column="0" Text="{loc:Translate StatementImport_PeriodLabel}" Style="{StaticResource TertiaryLabel}" />
                            <Label Grid.Row="1" Grid.Column="1" Text="{Binding PeriodText}" />
                            <Label Grid.Row="2" Grid.Column="0" Text="{loc:Translate StatementImport_RowsFoundLabel}" Style="{StaticResource TertiaryLabel}" />
                            <Label Grid.Row="2" Grid.Column="1" Text="{Binding RowCountText}" />
                            <Label Grid.Row="3" Grid.Column="0" Text="{loc:Translate StatementImport_DetectedBalanceLabel}" Style="{StaticResource TertiaryLabel}" />
                            <Label Grid.Row="3" Grid.Column="1" Text="{Binding DetectedBalanceText}" />
                            <Label Grid.Row="4" Grid.Column="0" Text="{loc:Translate StatementImport_DetectedAccountLabel}" Style="{StaticResource TertiaryLabel}" />
                            <Label Grid.Row="4" Grid.Column="1" Text="{Binding DetectedAccountText}" />
                        </Grid>
                    </VerticalStackLayout>

                    <Button
                        Text="{loc:Translate Common_Continue}"
                        Command="{Binding ContinueFromPickCommand}"
                        IsEnabled="{Binding CanContinueFromPick}"
                        Style="{StaticResource PrimaryButton}"
                        HorizontalOptions="Start" />
                </VerticalStackLayout>
            </Border>

            <!-- Step 2: confirm/create account -->
            <Border Style="{StaticResource CardBorder}" IsVisible="{Binding IsConfirmAccountStep}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{loc:Translate StatementImport_Step2Header}" Style="{StaticResource SectionTitleLabel}" />

                    <HorizontalStackLayout Spacing="6">
                        <Button Text="{loc:Translate StatementImport_ExistingAccountButton}" Command="{Binding Account.UseExistingAccountCommand}" Style="{StaticResource QuietButton}" />
                        <Button Text="{loc:Translate StatementImport_NewAccountButton}" Command="{Binding Account.UseNewAccountCommand}" Style="{StaticResource QuietButton}" />
                    </HorizontalStackLayout>

                    <Picker
                        Title="{loc:Translate Common_Account}"
                        ItemsSource="{Binding Account.AccountOptions}"
                        SelectedItem="{Binding Account.SelectedAccount}"
                        IsVisible="{Binding Account.IsCreatingNewAccount, Converter={StaticResource InverseBoolConverter}}" />

                    <VerticalStackLayout Spacing="8" IsVisible="{Binding Account.IsCreatingNewAccount}">
                        <Entry Placeholder="{loc:Translate StatementImport_AccountNamePlaceholder}" Text="{Binding Account.NewAccountName}" />
                        <Picker Title="{loc:Translate Common_Type}" ItemsSource="{Binding Account.AccountTypes}" SelectedItem="{Binding Account.NewAccountType}" ItemDisplayBinding="{Binding ., Converter={StaticResource EnumDisplayConverter}}" />
                        <Entry Placeholder="{loc:Translate StatementImport_StartingBalancePlaceholder}" Text="{Binding Account.NewAccountStartingBalanceText}" Keyboard="Numeric" />
                    </VerticalStackLayout>

                    <Label Text="{Binding Account.StatusText}" TextColor="{AppThemeBinding Light={StaticResource LightStatusRed}, Dark={StaticResource DarkStatusRed}}" />

                    <HorizontalStackLayout Spacing="8">
                        <Button Text="{loc:Translate Common_Back}" Command="{Binding BackToPickCommand}" Style="{StaticResource QuietButton}" />
                        <Button
                            Text="{loc:Translate Common_Continue}"
                            Command="{Binding ContinueFromAccountCommand}"
                            IsEnabled="{Binding Account.CanContinue}"
                            Style="{StaticResource PrimaryButton}" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Step 3: review rows, in three blocks (see StatementImportReviewSectionsViewModel) -->
            <Border Style="{StaticResource CardBorder}" IsVisible="{Binding IsReviewStep}">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <Label Grid.Column="0" Text="{loc:Translate StatementImport_Step3Header}" Style="{StaticResource SectionTitleLabel}" />
                        <Button Grid.Column="1" Text="{loc:Translate Common_Select}" Command="{Binding Review.Bulk.ToggleSelectModeCommand}" IsVisible="{Binding Review.HasRows}" Style="{StaticResource QuietButton}" />
                        <Button Grid.Column="2" Text="{loc:Translate StatementImport_CancelImportButton}" Command="{Binding Review.CancelImportCommand}" IsVisible="{Binding Review.HasRows}" Style="{StaticResource DestructiveButton}" />
                    </Grid>

                    <!-- Progress, undo and the one-click path for everything already categorised -->
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" IsVisible="{Binding Review.HasRows}">
                        <Label Grid.Column="0" Text="{Binding Review.ProgressText}" Style="{StaticResource SecondaryLabel}" VerticalOptions="Center" />
                        <Button Grid.Column="1" Text="{loc:Translate StatementImport_UndoButton}" Command="{Binding Review.UndoCommand}" IsVisible="{Binding Review.CanUndo}" Style="{StaticResource QuietButton}" />
                        <Button Grid.Column="2" Text="{Binding Review.Sections.ApproveAllCategorisedText}" Command="{Binding Review.Sections.ApproveAllCategorisedCommand}" IsEnabled="{Binding Review.Sections.CanApproveAllCategorised}" Style="{StaticResource PrimaryButton}" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="8" IsVisible="{Binding Review.Bulk.SelectMode}">
                        <Label Grid.Column="0" Text="{Binding Review.Bulk.SelectionSummaryText}" VerticalOptions="Center" />
                        <Picker Grid.Column="1" Title="{loc:Translate Common_Category}" ItemsSource="{Binding Review.CategoryOptions}" SelectedItem="{Binding Review.Bulk.BulkCategory}" WidthRequest="160" />
                        <Entry Grid.Column="2" Placeholder="{loc:Translate Common_NewCategoryNamePlaceholder}" Text="{Binding Review.Bulk.NewBulkCategoryName}" IsVisible="{Binding Review.Bulk.IsCreatingNewBulkCategory}" WidthRequest="140" />
                        <Button Grid.Column="3" Text="{loc:Translate StatementImport_ApplyToSelectedButton}" Command="{Binding Review.Bulk.ApplyCategoryCommand}" Style="{StaticResource QuietButton}" />
                        <Button Grid.Column="4" Text="{loc:Translate StatementImport_ApproveSelectedButton}" Command="{Binding Review.Bulk.ApproveSelectedCommand}" Style="{StaticResource PrimaryButton}" />
                    </Grid>
                    <HorizontalStackLayout Spacing="8" IsVisible="{Binding Review.Bulk.SelectMode}">
                        <Button Text="{loc:Translate Common_SelectAll}" Command="{Binding Review.Bulk.ToggleSelectAllCommand}" IsVisible="{Binding Review.Bulk.CanSelectAll}" Style="{StaticResource QuietButton}" />
                        <Button Text="{loc:Translate Common_ClearSelection}" Command="{Binding Review.Bulk.ToggleSelectAllCommand}" IsVisible="{Binding Review.Bulk.AreAllRowsSelected}" Style="{StaticResource QuietButton}" />
                        <Button Text="{loc:Translate StatementImport_SelectDuplicatesButton}" Command="{Binding Review.Bulk.SelectDuplicatesCommand}" IsVisible="{Binding Review.Bulk.HasDuplicates}" Style="{StaticResource QuietButton}" />
                        <Button Text="{loc:Translate StatementImport_SkipSelectedButton}" Command="{Binding Review.Bulk.SkipSelectedCommand}" Style="{StaticResource QuietButton}" />
                    </HorizontalStackLayout>

                    <Label Text="{Binding Review.StatusText}" TextColor="{AppThemeBinding Light={StaticResource LightStatusRed}, Dark={StaticResource DarkStatusRed}}" />

                    <!-- Block 1: possible duplicates -->
                    <VerticalStackLayout Spacing="4" IsVisible="{Binding Review.Sections.HasDuplicates}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Label Grid.Column="0" Text="{Binding Review.Sections.DuplicatesHeaderText}" Style="{StaticResource SectionTitleLabel}" VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource LightStatusOrange}, Dark={StaticResource DarkStatusOrange}}" />
                            <Button Grid.Column="1" Text="{loc:Translate StatementImport_SkipAllDuplicatesButton}" Command="{Binding Review.Sections.SkipAllDuplicatesCommand}" Style="{StaticResource QuietButton}" />
                        </Grid>
                        <Label Text="{loc:Translate StatementImport_DuplicatesHint}" Style="{StaticResource TertiaryLabel}" />
                        <CollectionView ItemsSource="{Binding Review.Sections.DuplicateRows}" ItemTemplate="{StaticResource ReviewRowTemplate}" />
                    </VerticalStackLayout>

                    <!-- Block 2: already categorised from what Banccoon learned - collapsed by default, right under
                         the duplicates so the "nothing to decide" rows are dealt with before the real decisions -->
                    <VerticalStackLayout Spacing="4" IsVisible="{Binding Review.Sections.HasReady}">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                            <Label Grid.Column="0" Text="{Binding Review.Sections.ReadyHeaderText}" Style="{StaticResource SectionTitleLabel}" VerticalOptions="Center" />
                            <HorizontalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                <CheckBox IsChecked="{Binding Review.Sections.IsGroupedByName}" />
                                <Label Text="{loc:Translate StatementImport_GroupByName}" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <Button Grid.Column="2" Text="{loc:Translate StatementImport_ShowRowsButton}" Command="{Binding Review.Sections.ToggleReadyExpandedCommand}" IsVisible="{Binding Review.Sections.IsReadyCollapsed}" Style="{StaticResource QuietButton}" />
                            <Button Grid.Column="2" Text="{loc:Translate StatementImport_HideRowsButton}" Command="{Binding Review.Sections.ToggleReadyExpandedCommand}" IsVisible="{Binding Review.Sections.IsReadyExpanded}" Style="{StaticResource QuietButton}" />
                        </Grid>
                        <Label Text="{loc:Translate StatementImport_ReadyHint}" Style="{StaticResource TertiaryLabel}" />
                        <CollectionView ItemsSource="{Binding Review.Sections.ReadyGroups}" ItemTemplate="{StaticResource ReviewGroupTemplate}" IsVisible="{Binding Review.Sections.IsReadyListGrouped}" />
                        <CollectionView ItemsSource="{Binding Review.Sections.ReadyRows}" ItemTemplate="{StaticResource ReviewRowTemplate}" IsVisible="{Binding Review.Sections.IsReadyListFlat}" />
                    </VerticalStackLayout>

                    <!-- Block 3: needs a decision -->
                    <VerticalStackLayout Spacing="4" IsVisible="{Binding Review.Sections.HasAttention}">
                        <Label Text="{Binding Review.Sections.AttentionHeaderText}" Style="{StaticResource SectionTitleLabel}" />
                        <Label Text="{loc:Translate StatementImport_AttentionHint}" Style="{StaticResource TertiaryLabel}" />
                        <CollectionView ItemsSource="{Binding Review.Sections.AttentionRows}" ItemTemplate="{StaticResource ReviewRowTemplate}" />
                    </VerticalStackLayout>

                    <!-- Every row reviewed: the statement's closing balance is now the account's balance, so a
                         check-in mostly means attaching the imported rows to the scheduled payments they paid. -->
                    <VerticalStackLayout Spacing="8" IsVisible="{Binding Review.IsComplete}">
                        <Label Text="{loc:Translate StatementImport_AllRowsReviewed}" Style="{StaticResource SecondaryLabel}" />
                        <Border Style="{StaticResource CardBorder}" IsVisible="{Binding CanCheckIn}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <Label Grid.Column="0" Text="{loc:Translate StatementImport_CheckInSuggestion}" Style="{StaticResource SecondaryLabel}" VerticalOptions="Center" />
                                <Button Grid.Column="1" Text="{loc:Translate StatementImport_CheckInNowButton}" Clicked="OnCheckInClicked" Style="{StaticResource PrimaryButton}" />
                            </Grid>
                        </Border>
                        <Button Text="{loc:Translate Common_Done}" Clicked="OnCloseClicked" Style="{StaticResource QuietButton}" HorizontalOptions="Start" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
