<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Banccoon.App.Views.StatementImportPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:Banccoon.App.ViewModels"
    xmlns:loc="clr-namespace:Banccoon.App.Localization"
    x:DataType="viewModels:StatementImportViewModel"
    Title="{loc:Translate StatementImport_Title}"
    BackgroundColor="{AppThemeBinding Light={StaticResource LightPageBackground}, Dark={StaticResource DarkPageBackground}}">

    <ScrollView>
        <VerticalStackLayout Padding="32" Spacing="16">

            <Grid ColumnDefinitions="*,Auto">
                <Label Grid.Column="0" Text="{loc:Translate StatementImport_Header}" Style="{StaticResource ScreenTitleLabel}" />
                <Button Grid.Column="1" Text="{loc:Translate Common_Close}" Clicked="OnCloseClicked" Style="{StaticResource QuietButton}" />
            </Grid>

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HorizontalOptions="Start" />

            <!-- Step 1: pick file -->
            <Border Style="{StaticResource CardBorder}" IsVisible="{Binding IsPickFileStep}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{loc:Translate StatementImport_Step1Header}" Style="{StaticResource SectionTitleLabel}" />
                    <Button Text="{loc:Translate StatementImport_ChooseFileButton}" Command="{Binding PickFileCommand}" Style="{StaticResource QuietButton}" HorizontalOptions="Start" />
                    <Label Text="{Binding FileName}" IsVisible="{Binding HasStatement}" />
                    <Label Text="{Binding PreviewStatusText}" Style="{StaticResource SecondaryLabel}" />

                    <VerticalStackLayout Spacing="8" IsVisible="{Binding HasStatement}">
                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource LightDivider}, Dark={StaticResource DarkDivider}}" />
                        <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="12">
                            <Label Grid.Row="0" Grid.Column="0" Text="{loc:Translate StatementImport_ParserLabel}" Style="{StaticResource TertiaryLabel}" />
                            <Label Grid.Row="0" Grid.Column="1" Text="{Binding ParserNameText}" />
                            <Label Grid.Row="1" Grid.Column="0" Text="{loc:Translate StatementImport_PeriodLabel}" Style="{StaticResource TertiaryLabel}" />
                            <Label Grid.Row="1" Grid.Column="1" Text="{Binding PeriodText}" />
                            <Label Grid.Row="2" Grid.Column="0" Text="{loc:Translate StatementImport_RowsFoundLabel}" Style="{StaticResource TertiaryLabel}" />
                            <Label Grid.Row="2" Grid.Column="1" Text="{Binding RowCountText}" />
                            <Label Grid.Row="3" Grid.Column="0" Text="{loc:Translate StatementImport_DetectedBalanceLabel}" Style="{StaticResource TertiaryLabel}" />
                            <Label Grid.Row="3" Grid.Column="1" Text="{Binding DetectedBalanceText}" />
                            <Label Grid.Row="4" Grid.Column="0" Text="{loc:Translate StatementImport_DetectedAccountLabel}" Style="{StaticResource TertiaryLabel}" />
                            <Label Grid.Row="4" Grid.Column="1" Text="{Binding DetectedAccountText}" />
                        </Grid>
                    </VerticalStackLayout>

                    <Button
                        Text="{loc:Translate Common_Continue}"
                        Command="{Binding ContinueFromPickCommand}"
                        IsEnabled="{Binding CanContinueFromPick}"
                        Style="{StaticResource PrimaryButton}"
                        HorizontalOptions="Start" />
                </VerticalStackLayout>
            </Border>

            <!-- Step 2: confirm/create account -->
            <Border Style="{StaticResource CardBorder}" IsVisible="{Binding IsConfirmAccountStep}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{loc:Translate StatementImport_Step2Header}" Style="{StaticResource SectionTitleLabel}" />

                    <HorizontalStackLayout Spacing="6">
                        <Button Text="{loc:Translate StatementImport_ExistingAccountButton}" Command="{Binding Account.UseExistingAccountCommand}" Style="{StaticResource QuietButton}" />
                        <Button Text="{loc:Translate StatementImport_NewAccountButton}" Command="{Binding Account.UseNewAccountCommand}" Style="{StaticResource QuietButton}" />
                    </HorizontalStackLayout>

                    <Picker
                        Title="{loc:Translate Common_Account}"
                        ItemsSource="{Binding Account.AccountOptions}"
                        SelectedItem="{Binding Account.SelectedAccount}"
                        IsVisible="{Binding Account.IsCreatingNewAccount, Converter={StaticResource InverseBoolConverter}}" />

                    <VerticalStackLayout Spacing="8" IsVisible="{Binding Account.IsCreatingNewAccount}">
                        <Entry Placeholder="{loc:Translate StatementImport_AccountNamePlaceholder}" Text="{Binding Account.NewAccountName}" />
                        <Picker Title="{loc:Translate Common_Type}" ItemsSource="{Binding Account.AccountTypes}" SelectedItem="{Binding Account.NewAccountType}" ItemDisplayBinding="{Binding ., Converter={StaticResource EnumDisplayConverter}}" />
                        <Entry Placeholder="{loc:Translate StatementImport_StartingBalancePlaceholder}" Text="{Binding Account.NewAccountStartingBalanceText}" Keyboard="Numeric" />
                    </VerticalStackLayout>

                    <Label Text="{Binding Account.StatusText}" TextColor="{AppThemeBinding Light={StaticResource LightStatusRed}, Dark={StaticResource DarkStatusRed}}" />

                    <HorizontalStackLayout Spacing="8">
                        <Button Text="{loc:Translate Common_Back}" Command="{Binding BackToPickCommand}" Style="{StaticResource QuietButton}" />
                        <Button
                            Text="{loc:Translate Common_Continue}"
                            Command="{Binding ContinueFromAccountCommand}"
                            IsEnabled="{Binding Account.CanContinue}"
                            Style="{StaticResource PrimaryButton}" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Step 3: review rows -->
            <Border Style="{StaticResource CardBorder}" IsVisible="{Binding IsReviewStep}">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <Label Grid.Column="0" Text="{loc:Translate StatementImport_Step3Header}" Style="{StaticResource SectionTitleLabel}" />
                        <Button Grid.Column="1" Text="{loc:Translate Common_Select}" Command="{Binding Review.ToggleSelectModeCommand}" Style="{StaticResource QuietButton}" />
                        <Button Grid.Column="2" Text="{loc:Translate StatementImport_CancelImportButton}" Command="{Binding Review.CancelImportCommand}" Style="{StaticResource DestructiveButton}" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8" IsVisible="{Binding Review.SelectMode}">
                        <Label Grid.Column="0" Text="{Binding Review.SelectionSummaryText}" VerticalOptions="Center" />
                        <Picker Grid.Column="1" Title="{loc:Translate Common_Category}" ItemsSource="{Binding Review.CategoryOptions}" SelectedItem="{Binding Review.BulkCategory}" WidthRequest="160" />
                        <Entry Grid.Column="2" Placeholder="{loc:Translate Common_NewCategoryNamePlaceholder}" Text="{Binding Review.NewBulkCategoryName}" IsVisible="{Binding Review.IsCreatingNewBulkCategory}" WidthRequest="140" />
                        <Button Grid.Column="3" Text="{loc:Translate StatementImport_ApproveSelectedButton}" Command="{Binding Review.ApproveSelectedCommand}" Style="{StaticResource PrimaryButton}" />
                    </Grid>
                    <HorizontalStackLayout Spacing="8" IsVisible="{Binding Review.SelectMode}">
                        <Button Text="{loc:Translate StatementImport_SkipSelectedButton}" Command="{Binding Review.SkipSelectedCommand}" Style="{StaticResource QuietButton}" />
                    </HorizontalStackLayout>

                    <Label Text="{Binding Review.StatusText}" TextColor="{AppThemeBinding Light={StaticResource LightStatusRed}, Dark={StaticResource DarkStatusRed}}" />

                    <CollectionView ItemsSource="{Binding Review.Rows}">
                        <CollectionView.EmptyView>
                            <VerticalStackLayout Spacing="8">
                                <Label Text="{loc:Translate StatementImport_AllRowsReviewed}" Style="{StaticResource SecondaryLabel}" />
                                <Button Text="{loc:Translate Common_Done}" Clicked="OnCloseClicked" Style="{StaticResource PrimaryButton}" HorizontalOptions="Start" />
                            </VerticalStackLayout>
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:StatementImportRowViewModel">
                                <VerticalStackLayout Spacing="0">
                                <Grid RowDefinitions="Auto,Auto" RowSpacing="6" Padding="0,8">
                                <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8">
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" IsVisible="{Binding IsSelectModeActive}" />
                                    <Label Grid.Column="1" Text="{Binding DateText}" Style="{StaticResource TertiaryLabel}" VerticalOptions="Center" />
                                    <VerticalStackLayout Grid.Column="2" Spacing="1" VerticalOptions="Center">
                                        <Label Text="{Binding Description}" />
                                        <Label Text="{loc:Translate StatementImport_PossibleDuplicate}" IsVisible="{Binding IsDuplicate}" Style="{StaticResource TertiaryLabel}"
                                               TextColor="{AppThemeBinding Light={StaticResource LightStatusOrange}, Dark={StaticResource DarkStatusOrange}}" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="3" Text="{Binding AmountText}" FontAttributes="Bold" VerticalOptions="Center" />
                                    <Picker Grid.Column="4" Title="{loc:Translate Common_Type}" ItemsSource="{Binding TypeOptions}" SelectedItem="{Binding Type}" ItemDisplayBinding="{Binding ., Converter={StaticResource EnumDisplayConverter}}" WidthRequest="110" VerticalOptions="Center" />
                                    <HorizontalStackLayout Grid.Column="5" Spacing="6" VerticalOptions="Center">
                                        <Border StrokeShape="RoundRectangle 8" StrokeThickness="2" Stroke="{Binding CategoryBorderColor}" Padding="0">
                                            <Picker Title="{loc:Translate Common_Category}" ItemsSource="{Binding CategoryOptions}" SelectedItem="{Binding Category}" WidthRequest="140" />
                                        </Border>
                                        <Entry Placeholder="{loc:Translate Common_NewCategoryNamePlaceholder}" Text="{Binding NewCategoryName}" IsVisible="{Binding IsCreatingNewCategory}" WidthRequest="140" />
                                    </HorizontalStackLayout>
                                    <Button Grid.Column="6" Text="{loc:Translate Common_Skip}" Command="{Binding SkipCommand}" Style="{StaticResource QuietButton}" />
                                    <Button Grid.Column="7" Text="{loc:Translate Common_Approve}" Command="{Binding ApproveCommand}" Style="{StaticResource PrimaryButton}" />
                                </Grid>
                                <HorizontalStackLayout Grid.Row="1" Spacing="8" HorizontalOptions="End" IsVisible="{Binding IsTransferType}">
                                    <Picker Title="{loc:Translate StatementImport_OtherAccountPickerTitle}" ItemsSource="{Binding OtherAccountOptions}" SelectedItem="{Binding OtherAccount}" WidthRequest="160" />
                                </HorizontalStackLayout>
                                </Grid>
                                <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource LightDivider}, Dark={StaticResource DarkDivider}}" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
