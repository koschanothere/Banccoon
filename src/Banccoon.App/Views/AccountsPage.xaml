<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Banccoon.App.Views.AccountsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:Banccoon.App.ViewModels"
    x:DataType="viewModels:AccountsViewModel"
    Title="Accounts">
    <VerticalStackLayout Padding="32" Spacing="16">
        <Label Text="Accounts" Style="{StaticResource ScreenTitleLabel}" />
        <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" HorizontalOptions="Start" />

        <Border Style="{StaticResource CardBorder}">
            <CollectionView ItemsSource="{Binding Accounts}">
                <CollectionView.EmptyView>
                    <Label Text="No accounts yet." Style="{StaticResource SecondaryLabel}" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:AccountRowViewModel">
                        <Grid ColumnDefinitions="*,Auto" Padding="0,10">
                            <VerticalStackLayout Grid.Column="0" Spacing="1">
                                <Label Text="{Binding Name}" />
                                <Label Text="{Binding TypeText}" Style="{StaticResource TertiaryLabel}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1" Text="{Binding BalanceText}" FontAttributes="Bold" VerticalOptions="Center" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Border>
    </VerticalStackLayout>
</ContentPage>
