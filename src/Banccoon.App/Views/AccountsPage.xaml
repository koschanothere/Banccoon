<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Banccoon.App.Views.AccountsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:Banccoon.App.ViewModels"
    xmlns:controls="clr-namespace:Banccoon.App.Controls"
    xmlns:loc="clr-namespace:Banccoon.App.Localization"
    x:DataType="viewModels:AccountsViewModel"
    Title="{loc:Translate AppShell_Nav_Accounts}"
    BackgroundColor="{AppThemeBinding Light={StaticResource LightPageBackground}, Dark={StaticResource DarkPageBackground}}">
    <ScrollView>
        <VerticalStackLayout Padding="32" Spacing="16">

            <Grid ColumnDefinitions="*,Auto">
                <Label Grid.Column="0" Text="{loc:Translate AppShell_Nav_Accounts}" Style="{StaticResource ScreenTitleLabel}" />
                <HorizontalStackLayout Grid.Column="1" Spacing="6">
                    <controls:IconButton Icon="{x:Static controls:Heroicons.ArchiveBox}" Label="{Binding ShowArchivedToggleText}" Command="{Binding ToggleShowArchivedCommand}" Style="{StaticResource QuietButton}" />
                    <controls:IconButton Icon="{x:Static controls:Heroicons.Plus}" Label="{loc:Translate Accounts_AddAccountLabel}" TextOnlyLabel="{loc:Translate Accounts_AddAccountButton}" ShowLabel="True" Command="{Binding OpenAddAccountCommand}" Style="{StaticResource PrimaryButton}" />
                </HorizontalStackLayout>
            </Grid>

            <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" HorizontalOptions="Start" />

            <!-- Add/edit account -->
            <Border Style="{StaticResource CardBorder}" IsVisible="{Binding Form.IsOpen}">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="{Binding Form.Title}" Style="{StaticResource SectionTitleLabel}" />
                        <controls:IconButton Grid.Column="1" Icon="{x:Static controls:Heroicons.XMark}" Label="{loc:Translate Common_Close}" Command="{Binding Form.CloseCommand}" Style="{StaticResource QuietButton}" />
                    </Grid>

                    <Entry Placeholder="{loc:Translate Accounts_AccountNamePlaceholder}" Text="{Binding Form.Name}" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Picker Grid.Column="0" Title="{loc:Translate Common_Type}" ItemsSource="{Binding Form.AccountTypes}" SelectedItem="{Binding Form.Type}" ItemDisplayBinding="{Binding ., Converter={StaticResource EnumDisplayConverter}}" />
                        <Entry Grid.Column="1" Placeholder="{loc:Translate Accounts_CurrencyPlaceholder}" Text="{Binding Form.Currency}" />
                    </Grid>

                    <Entry Placeholder="{loc:Translate Accounts_BalancePlaceholder}" Text="{Binding Form.BalanceText}" Keyboard="Numeric" />

                    <Entry Placeholder="{loc:Translate Accounts_GoalTargetPlaceholder}" Text="{Binding Form.GoalTargetText}" Keyboard="Numeric" IsVisible="{Binding Form.IsGoalType}" />

                    <VerticalStackLayout Spacing="8" IsVisible="{Binding Form.IsCreditCardType}">
                        <Entry Placeholder="{loc:Translate Accounts_MinimumPaymentPlaceholder}" Text="{Binding Form.MinimumPaymentText}" Keyboard="Numeric" />
                        <Entry Placeholder="{loc:Translate Accounts_PlannedMonthlyPaymentPlaceholder}" Text="{Binding Form.PlannedPaymentText}" Keyboard="Numeric" />
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Entry Grid.Column="0" Placeholder="{loc:Translate Accounts_AccountNumberOptionalPlaceholder}" Text="{Binding Form.AccountNumberText}" />
                        <Entry Grid.Column="1" Placeholder="{loc:Translate Accounts_CardLastFourOptionalPlaceholder}" Text="{Binding Form.CardLastFourDigitsText}" Keyboard="Numeric" />
                    </Grid>

                    <HorizontalStackLayout Spacing="8">
                        <CheckBox IsChecked="{Binding Form.IncludeInDashboardTotals}" />
                        <Label Text="{loc:Translate Accounts_IncludeInDashboardTotals}" VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <Label Text="{Binding Form.StatusText}" TextColor="{AppThemeBinding Light={StaticResource LightStatusRed}, Dark={StaticResource DarkStatusRed}}" />
                    <controls:IconButton Icon="{x:Static controls:Heroicons.Check}" Label="{loc:Translate Common_Save}" ShowLabel="True" Command="{Binding Form.SaveCommand}" Style="{StaticResource PrimaryButton}" HorizontalOptions="Start" />
                </VerticalStackLayout>
            </Border>

            <!-- Credit card payoff calculator -->
            <Border Style="{StaticResource CardBorder}" IsVisible="{Binding CardDetails.IsOpen}">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="{Binding CardDetails.AccountName}" Style="{StaticResource SectionTitleLabel}" />
                        <controls:IconButton Grid.Column="1" Icon="{x:Static controls:Heroicons.XMark}" Label="{loc:Translate Common_Close}" Command="{Binding CardDetails.CloseCommand}" Style="{StaticResource QuietButton}" />
                    </Grid>

                    <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto" RowSpacing="4" ColumnSpacing="12">
                        <Label Grid.Row="0" Grid.Column="0" Text="{loc:Translate Accounts_CurrentDebtLabel}" Style="{StaticResource TertiaryLabel}" />
                        <Label Grid.Row="0" Grid.Column="1" Text="{Binding CardDetails.CurrentDebtText}" />
                        <Label Grid.Row="1" Grid.Column="0" Text="{loc:Translate Accounts_MinimumPaymentPlaceholder}" Style="{StaticResource TertiaryLabel}" />
                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding CardDetails.MinimumPaymentDisplayText}" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource LightDivider}, Dark={StaticResource DarkDivider}}" />

                    <Label Text="{loc:Translate Accounts_PayoffCalculatorHeader}" Style="{StaticResource SectionTitleLabel}" FontSize="13" />
                    <Entry Placeholder="{loc:Translate Accounts_MonthlyPaymentPlaceholder}" Text="{Binding CardDetails.ChosenPaymentAmountText}" Keyboard="Numeric" />
                    <Entry Placeholder="{loc:Translate Accounts_MonthlyFinanceChargeOptionalPlaceholder}" Text="{Binding CardDetails.ManualMonthlyFinanceChargeText}" Keyboard="Numeric" />
                    <DatePicker Date="{Binding CardDetails.FirstPaymentDateTime}" />
                    <Label Text="{Binding CardDetails.PayoffSummary}" Style="{StaticResource SecondaryLabel}" />
                </VerticalStackLayout>
            </Border>

            <!-- Account detail -->
            <Border Style="{StaticResource CardBorder}" IsVisible="{Binding IsDetailOpen}">
                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Border
                            Grid.Column="0"
                            WidthRequest="44"
                            HeightRequest="44"
                            StrokeShape="RoundRectangle 12"
                            Stroke="Transparent"
                            Background="{AppThemeBinding Light={StaticResource LightAccentSoft}, Dark={StaticResource DarkAccentSoft}}">
                            <Label
                                Text="{Binding DetailAccount.IsFavorite, Converter={StaticResource FavoriteStarConverter}}"
                                FontSize="20"
                                HorizontalTextAlignment="Center"
                                VerticalTextAlignment="Center"
                                TextColor="{AppThemeBinding Light={StaticResource LightAccent}, Dark={StaticResource DarkAccent}}" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="1" Margin="12,0,0,0" VerticalOptions="Center">
                            <HorizontalStackLayout Spacing="6">
                                <Label Text="{Binding DetailAccount.Name}" Style="{StaticResource SectionTitleLabel}" />
                                <Label Text="{loc:Translate Accounts_PrimaryBadge}" IsVisible="{Binding DetailAccount.IsPrimary}" Style="{StaticResource TertiaryLabel}"
                                       TextColor="{AppThemeBinding Light={StaticResource LightAccent}, Dark={StaticResource DarkAccent}}" />
                            </HorizontalStackLayout>
                            <Label Text="{Binding DetailAccount.TypeText}" Style="{StaticResource TertiaryLabel}" />
                        </VerticalStackLayout>
                        <controls:IconButton Grid.Column="2" Icon="{x:Static controls:Heroicons.XMark}" Label="{loc:Translate Common_Close}" Command="{Binding CloseDetailCommand}" Style="{StaticResource QuietButton}" />
                    </Grid>

                    <Label Text="{Binding DetailAccount.BalanceText}" Style="{StaticResource HeroAmountLabel}" />

                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource LightDivider}, Dark={StaticResource DarkDivider}}" />

                    <HorizontalStackLayout Spacing="8" IsVisible="{Binding DetailAccount.HasIdentifier}">
                        <Label Text="{Binding DetailAccount.IdentifierText}" VerticalOptions="Center" />
                        <controls:IconButton Icon="{Binding DetailAccount.IsNumberRevealed, Converter={StaticResource RevealGlyphConverter}}" Label="{Binding DetailAccount.RevealToggleText}" IconSize="14" Command="{Binding DetailAccount.ToggleRevealCommand}" Style="{StaticResource QuietButton}" FontSize="11" Padding="8,4" />
                    </HorizontalStackLayout>

                    <VerticalStackLayout Spacing="4" IsVisible="{Binding DetailAccount.HasGoalTarget}">
                        <Label Text="{loc:Translate Accounts_GoalProgressLabel}" Style="{StaticResource TertiaryLabel}" />
                        <ProgressBar Progress="{Binding DetailAccount.GoalProgress}" ProgressColor="{AppThemeBinding Light={StaticResource LightAccent}, Dark={StaticResource DarkAccent}}" />
                        <Label Text="{Binding DetailAccount.GoalTargetText}" Style="{StaticResource TertiaryLabel}" />
                    </VerticalStackLayout>

                    <Label Text="{loc:Translate Accounts_ArchivedBadge}" IsVisible="{Binding DetailAccount.IsArchived}" Style="{StaticResource TertiaryLabel}"
                           TextColor="{AppThemeBinding Light={StaticResource LightStatusOrange}, Dark={StaticResource DarkStatusOrange}}" />

                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource LightDivider}, Dark={StaticResource DarkDivider}}" />

                    <HorizontalStackLayout Spacing="8">
                        <controls:IconButton Icon="{x:Static controls:Heroicons.PencilSquare}" Label="{loc:Translate Common_Edit}" ShowLabel="True" Command="{Binding DetailEditCommand}" Style="{StaticResource PrimaryButton}" />
                        <controls:IconButton Icon="{x:Static controls:Heroicons.ListBullet}" Label="{loc:Translate Accounts_ViewTransactionsButton}" Command="{Binding DetailViewTransactionsCommand}" Style="{StaticResource QuietButton}" />
                        <controls:IconButton Icon="{x:Static controls:Heroicons.CreditCard}" Label="{loc:Translate Accounts_CardDetailsButton}" Command="{Binding DetailOpenCardDetailsCommand}" IsVisible="{Binding DetailAccount.IsCreditCard}" Style="{StaticResource QuietButton}" />
                        <controls:IconButton Icon="{x:Static controls:Heroicons.CheckBadge}" Label="{loc:Translate Accounts_SetPrimaryButton}" Command="{Binding DetailSetPrimaryCommand}" IsVisible="{Binding DetailAccount.IsPrimary, Converter={StaticResource InverseBoolConverter}}" Style="{StaticResource QuietButton}" />
                        <controls:IconButton Icon="{x:Static controls:Heroicons.ArchiveBox}" Label="{loc:Translate Accounts_ArchiveButton}" ShowLabel="True" Command="{Binding DetailArchiveCommand}" IsVisible="{Binding DetailAccount.IsArchived, Converter={StaticResource InverseBoolConverter}}" Style="{StaticResource DestructiveButton}" />
                        <controls:IconButton Icon="{x:Static controls:Heroicons.ArrowUturnLeft}" Label="{loc:Translate Accounts_UnarchiveButton}" ShowLabel="True" Command="{Binding DetailUnarchiveCommand}" IsVisible="{Binding DetailAccount.IsArchived}" Style="{StaticResource QuietButton}" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <CollectionView ItemsSource="{Binding Accounts}">
                    <CollectionView.EmptyView>
                        <Label Text="{loc:Translate Accounts_NoAccountsYet}" Style="{StaticResource SecondaryLabel}" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:AccountRowViewModel">
                            <VerticalStackLayout Padding="0,10" Spacing="0">
                                <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding OpenDetailCommand}" />
                                    </Grid.GestureRecognizers>
                                    <VerticalStackLayout Grid.Column="0" Spacing="0" VerticalOptions="Center">
                                        <controls:IconButton
                                            Icon="{x:Static controls:Heroicons.ChevronUp}" Label="{loc:Translate Common_MoveUp}" TextOnlyLabel="&#9650;" IconSize="12"
                                            Command="{Binding MoveUpCommand}"
                                            IsEnabled="{Binding CanMoveUp}"
                                            BackgroundColor="Transparent"
                                            TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}"
                                            FontSize="9"
                                            Padding="0"
                                            WidthRequest="22"
                                            HeightRequest="16" />
                                        <controls:IconButton
                                            Icon="{x:Static controls:Heroicons.ChevronDown}" Label="{loc:Translate Common_MoveDown}" TextOnlyLabel="&#9660;" IconSize="12"
                                            Command="{Binding MoveDownCommand}"
                                            IsEnabled="{Binding CanMoveDown}"
                                            BackgroundColor="Transparent"
                                            TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}"
                                            FontSize="9"
                                            Padding="0"
                                            WidthRequest="22"
                                            HeightRequest="16" />
                                    </VerticalStackLayout>
                                    <Button
                                        Grid.Column="1"
                                        Text="{Binding IsFavorite, Converter={StaticResource FavoriteStarConverter}}"
                                        Command="{Binding ToggleFavoriteCommand}"
                                        CommandParameter="{Binding Id}"
                                        BackgroundColor="Transparent"
                                        TextColor="{AppThemeBinding Light={StaticResource LightAccent}, Dark={StaticResource DarkAccent}}"
                                        FontSize="17"
                                        Padding="0"
                                        WidthRequest="34"
                                        HeightRequest="34"
                                        TranslationY="2" />
                                    <VerticalStackLayout Grid.Column="2" Spacing="1" Margin="8,0,0,0" VerticalOptions="Center">
                                        <HorizontalStackLayout Spacing="6">
                                            <Label Text="{Binding Name}" />
                                            <Label Text="{loc:Translate Accounts_PrimaryBadge}" IsVisible="{Binding IsPrimary}" Style="{StaticResource TertiaryLabel}"
                                                   TextColor="{AppThemeBinding Light={StaticResource LightAccent}, Dark={StaticResource DarkAccent}}" />
                                        </HorizontalStackLayout>
                                        <Label Text="{Binding TypeText}" Style="{StaticResource TertiaryLabel}" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="3" Text="{Binding BalanceText}" FontAttributes="Bold" VerticalOptions="Center" />
                                </Grid>

                                <BoxView HeightRequest="1" Margin="0,10,0,0" Color="{AppThemeBinding Light={StaticResource LightDivider}, Dark={StaticResource DarkDivider}}" />
                            </VerticalStackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
