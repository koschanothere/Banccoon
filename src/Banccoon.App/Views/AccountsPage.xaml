<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Banccoon.App.Views.AccountsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:Banccoon.App.ViewModels"
    x:DataType="viewModels:AccountsViewModel"
    Title="Accounts"
    BackgroundColor="{AppThemeBinding Light={StaticResource LightPageBackground}, Dark={StaticResource DarkPageBackground}}">
    <VerticalStackLayout Padding="32" Spacing="16">
        <Label Text="Accounts" Style="{StaticResource ScreenTitleLabel}" />
        <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" HorizontalOptions="Start" />

        <Border Style="{StaticResource CardBorder}">
            <CollectionView ItemsSource="{Binding Accounts}">
                <CollectionView.EmptyView>
                    <Label Text="No accounts yet." Style="{StaticResource SecondaryLabel}" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:AccountRowViewModel">
                        <Grid ColumnDefinitions="Auto,*,Auto" Padding="0,10">
                            <Button
                                Grid.Column="0"
                                Text="{Binding IsFavorite, Converter={StaticResource FavoriteStarConverter}}"
                                Command="{Binding ToggleFavoriteCommand}"
                                CommandParameter="{Binding Id}"
                                BackgroundColor="Transparent"
                                TextColor="{AppThemeBinding Light={StaticResource LightAccent}, Dark={StaticResource DarkAccent}}"
                                FontSize="17"
                                Padding="0"
                                WidthRequest="34"
                                HeightRequest="34" />
                            <VerticalStackLayout Grid.Column="1" Spacing="1" Margin="8,0,0,0">
                                <Label Text="{Binding Name}" />
                                <Label Text="{Binding TypeText}" Style="{StaticResource TertiaryLabel}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="{Binding BalanceText}" FontAttributes="Bold" VerticalOptions="Center" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Border>
    </VerticalStackLayout>
</ContentPage>
