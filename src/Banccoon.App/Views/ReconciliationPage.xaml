<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Banccoon.App.Views.ReconciliationPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:Banccoon.App.ViewModels"
    xmlns:loc="clr-namespace:Banccoon.App.Localization"
    x:DataType="viewModels:ReconciliationViewModel"
    Title="{loc:Translate Reconciliation_Title}"
    BackgroundColor="{AppThemeBinding Light={StaticResource LightPageBackground}, Dark={StaticResource DarkPageBackground}}">

    <ScrollView>
        <VerticalStackLayout Padding="32" Spacing="16">

            <Grid ColumnDefinitions="*,Auto">
                <VerticalStackLayout Grid.Column="0" Spacing="2">
                    <Label Text="{loc:Translate Reconciliation_Header}" Style="{StaticResource ScreenTitleLabel}" />
                    <Label Text="{Binding StepProgressText}" Style="{StaticResource TertiaryLabel}" />
                </VerticalStackLayout>
                <Button Grid.Column="1" Text="{loc:Translate Common_Close}" Clicked="OnCloseClicked" Style="{StaticResource QuietButton}" VerticalOptions="Start" />
            </Grid>

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HorizontalOptions="Start" />

            <!-- Running difference, shown above steps 2-4 so every action's effect is visible. -->
            <Border Style="{StaticResource CardBorder}" IsVisible="{Binding ShowsDifference}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                        <Label Text="{Binding SelectedAccount.Name}" Style="{StaticResource SectionTitleLabel}" />
                        <Label Text="{Binding ComparisonText}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="End">
                        <Label Text="{loc:Translate Reconciliation_BanccoonBalanceLabel}" Style="{StaticResource TertiaryLabel}" HorizontalOptions="End" />
                        <Label Text="{Binding AppBalanceText}" FontAttributes="Bold" HorizontalOptions="End" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- Step 1: account + what the bank says -->
            <Border Style="{StaticResource CardBorder}" IsVisible="{Binding IsBalanceStep}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{loc:Translate Reconciliation_Step1Header}" Style="{StaticResource SectionTitleLabel}" />
                    <Label Text="{loc:Translate Reconciliation_Step1Hint}" Style="{StaticResource SecondaryLabel}" />

                    <Picker Title="{loc:Translate Common_Account}" ItemsSource="{Binding AccountOptions}" SelectedItem="{Binding SelectedAccount}" WidthRequest="280" HorizontalOptions="Start" />

                    <Grid ColumnDefinitions="200,*" RowDefinitions="Auto,Auto" RowSpacing="8" ColumnSpacing="12">
                        <Label Grid.Row="0" Grid.Column="0" Text="{loc:Translate Reconciliation_BanccoonBalanceLabel}" Style="{StaticResource TertiaryLabel}" VerticalOptions="Center" />
                        <Label Grid.Row="0" Grid.Column="1" Text="{Binding AppBalanceText}" FontAttributes="Bold" />
                        <Label Grid.Row="1" Grid.Column="0" Text="{loc:Translate Reconciliation_ActualBalanceLabel}" Style="{StaticResource TertiaryLabel}" VerticalOptions="Center" />
                        <Entry Grid.Row="1" Grid.Column="1" Placeholder="{loc:Translate Reconciliation_ActualBalancePlaceholder}" Text="{Binding ActualBalanceText}" Keyboard="Numeric" WidthRequest="200" HorizontalOptions="Start" />
                    </Grid>

                    <Label Text="{loc:Translate Reconciliation_PrefilledFromStatement}" IsVisible="{Binding IsPrefilledFromStatement}" Style="{StaticResource TertiaryLabel}" />
                    <Label Text="{Binding ComparisonText}" IsVisible="{Binding HasComparison}" FontAttributes="Bold" />
                    <Label Text="{Binding StatusText}" TextColor="{AppThemeBinding Light={StaticResource LightStatusRed}, Dark={StaticResource DarkStatusRed}}" />

                    <Button Text="{loc:Translate Common_Continue}" Command="{Binding ContinueCommand}" IsEnabled="{Binding HasComparison}" Style="{StaticResource PrimaryButton}" HorizontalOptions="Start" />
                </VerticalStackLayout>
            </Border>

            <!-- Step 2: expected scheduled items - the same shrinking list as Transactions' resolve-upcoming widget -->
            <Border Style="{StaticResource CardBorder}" IsVisible="{Binding IsExpectedStep}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{loc:Translate Reconciliation_Step2Header}" Style="{StaticResource SectionTitleLabel}" />
                    <Label Text="{loc:Translate Reconciliation_Step2Hint}" Style="{StaticResource SecondaryLabel}" />

                    <!-- A plain layout, not a CollectionView: a row grows when "Attach…" opens. -->
                    <Label Text="{loc:Translate Reconciliation_NothingExpected}" IsVisible="{Binding Expected.HasNoRows}" Style="{StaticResource TertiaryLabel}" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Expected.Rows}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:ResolveUpcomingRowViewModel">
                                <VerticalStackLayout Spacing="6" Padding="0,8">
                                    <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8">
                                        <VerticalStackLayout Grid.Column="0" Spacing="1">
                                            <Label Text="{Binding Name}" />
                                            <Label Text="{Binding DueText}" Style="{StaticResource TertiaryLabel}" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="1" Text="{Binding AmountText}" FontAttributes="Bold" VerticalOptions="Center" TextColor="{Binding Type, Converter={StaticResource TransactionTypeColorConverter}}" />
                                        <Button Grid.Column="2" Text="{loc:Translate Transactions_DelayButton}" Command="{Binding DelayCommand}" Style="{StaticResource QuietButton}" />
                                        <Button Grid.Column="3" Text="{loc:Translate Common_Skip}" Command="{Binding SkipCommand}" Style="{StaticResource QuietButton}" />
                                        <Button Grid.Column="4" Text="{Binding AttachToggleText}" Command="{Binding ToggleAttachCommand}" IsVisible="{Binding CanAttach}" Style="{StaticResource QuietButton}" />
                                        <Button Grid.Column="5" Text="{loc:Translate Transactions_MarkPaidButton}" Command="{Binding MarkPaidCommand}" Style="{StaticResource PrimaryButton}" />
                                    </Grid>
                                    <!-- "Attach…": pick the recorded transaction that paid this (e.g. the imported bank row) -
                                         the occurrence is marked paid without a second transaction. Nothing is suggested
                                         up front (2026-09-25); anything not yet linked can be found by name or amount. -->
                                    <VerticalStackLayout Spacing="6" Padding="12,4,0,4" IsVisible="{Binding IsAttachOpen}">
                                        <Label Text="{loc:Translate ResolveUpcoming_AttachHint}" Style="{StaticResource TertiaryLabel}" />
                                        <Entry Placeholder="{loc:Translate ResolveUpcoming_AttachSearchPlaceholder}" Text="{Binding AttachSearchText}" WidthRequest="320" HorizontalOptions="Start" />
                                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding AttachChoices}">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate x:DataType="viewModels:AttachChoiceViewModel">
                                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Padding="0,4">
                                                        <VerticalStackLayout Grid.Column="0" Spacing="1">
                                                            <Label Text="{Binding Name}" />
                                                            <Label Text="{Binding DetailText}" Style="{StaticResource TertiaryLabel}" />
                                                        </VerticalStackLayout>
                                                        <Label Grid.Column="1" Text="{Binding AmountText}" VerticalOptions="Center" TextColor="{Binding Type, Converter={StaticResource TransactionTypeColorConverter}}" />
                                                        <Button Grid.Column="2" Text="{loc:Translate ResolveUpcoming_AttachButton}" Command="{Binding AttachCommand}" Style="{StaticResource QuietButton}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </VerticalStackLayout>
                                        <Label Text="{loc:Translate ResolveUpcoming_NoAttachChoices}" IsVisible="{Binding HasNoAttachChoices}" Style="{StaticResource TertiaryLabel}" />
                                    </VerticalStackLayout>
                                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource LightDivider}, Dark={StaticResource DarkDivider}}" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <HorizontalStackLayout Spacing="8">
                        <Button Text="{loc:Translate Common_Back}" Command="{Binding BackCommand}" Style="{StaticResource QuietButton}" />
                        <Button Text="{loc:Translate Common_Continue}" Command="{Binding ContinueCommand}" Style="{StaticResource PrimaryButton}" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Step 3: explain the difference with spending that was never entered -->
            <Border Style="{StaticResource CardBorder}" IsVisible="{Binding IsExplainStep}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{loc:Translate Reconciliation_Step3Header}" Style="{StaticResource SectionTitleLabel}" />
                    <Label Text="{loc:Translate Reconciliation_Step3Hint}" Style="{StaticResource SecondaryLabel}" />

                    <HorizontalStackLayout Spacing="8">
                        <Entry Placeholder="{loc:Translate Common_AmountPlaceholder}" Text="{Binding GroupedSpending.AmountText}" Keyboard="Numeric" WidthRequest="140" />
                        <Picker Title="{loc:Translate Common_Category}" ItemsSource="{Binding GroupedSpending.CategoryOptions}" SelectedItem="{Binding GroupedSpending.Category}" WidthRequest="170" />
                        <Picker Title="{loc:Translate Common_SubcategoryPickerTitle}" ItemsSource="{Binding GroupedSpending.Subcategory.Options}" SelectedItem="{Binding GroupedSpending.Subcategory.Selected}" IsVisible="{Binding GroupedSpending.Subcategory.IsVisible}" WidthRequest="170" />
                        <Entry Placeholder="{loc:Translate Common_NewCategoryNamePlaceholder}" Text="{Binding GroupedSpending.NewCategoryName}" IsVisible="{Binding GroupedSpending.IsCreatingNewCategory}" WidthRequest="150" />
                        <Entry Placeholder="{loc:Translate Reconciliation_GroupedSpendingNotePlaceholder}" Text="{Binding GroupedSpending.NoteText}" WidthRequest="220" />
                        <Button Text="{loc:Translate Common_Add}" Command="{Binding GroupedSpending.AddCommand}" Style="{StaticResource ExpenseButton}" />
                    </HorizontalStackLayout>
                    <Label Text="{Binding GroupedSpending.StatusText}" TextColor="{AppThemeBinding Light={StaticResource LightStatusRed}, Dark={StaticResource DarkStatusRed}}" />

                    <VerticalStackLayout Spacing="4" BindableLayout.ItemsSource="{Binding GroupedSpending.AddedEntries}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:NamedOptionViewModel">
                                <Label Text="{Binding Name}" Style="{StaticResource SecondaryLabel}" />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <HorizontalStackLayout Spacing="8">
                        <Button Text="{loc:Translate Common_Back}" Command="{Binding BackCommand}" Style="{StaticResource QuietButton}" />
                        <Button Text="{loc:Translate Common_Continue}" Command="{Binding ContinueCommand}" Style="{StaticResource PrimaryButton}" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Step 4: write off whatever is left as an explicit adjustment transaction -->
            <Border Style="{StaticResource CardBorder}" IsVisible="{Binding IsAdjustStep}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{loc:Translate Reconciliation_Step4Header}" Style="{StaticResource SectionTitleLabel}" />

                    <VerticalStackLayout Spacing="10" IsVisible="{Binding HasDifference}">
                        <Label Text="{loc:Translate Reconciliation_Step4Hint}" Style="{StaticResource SecondaryLabel}" />
                        <Label Text="{Binding AdjustmentText}" FontAttributes="Bold" />
                        <HorizontalStackLayout Spacing="8">
                            <Button Text="{loc:Translate Common_Back}" Command="{Binding BackCommand}" Style="{StaticResource QuietButton}" />
                            <Button Text="{loc:Translate Reconciliation_FinishWithoutAdjustingButton}" Command="{Binding FinishWithoutAdjustingCommand}" Style="{StaticResource QuietButton}" />
                            <Button Text="{loc:Translate Reconciliation_RecordAdjustmentButton}" Command="{Binding RecordAdjustmentCommand}" Style="{StaticResource PrimaryButton}" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="10" IsVisible="{Binding IsMatched}">
                        <Label Text="{loc:Translate Reconciliation_Matched}" />
                        <HorizontalStackLayout Spacing="8">
                            <Button Text="{loc:Translate Common_Back}" Command="{Binding BackCommand}" Style="{StaticResource QuietButton}" />
                            <Button Text="{loc:Translate Common_Done}" Command="{Binding FinishWithoutAdjustingCommand}" Style="{StaticResource PrimaryButton}" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Done -->
            <Border Style="{StaticResource CardBorder}" IsVisible="{Binding IsDoneStep}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{loc:Translate Reconciliation_DoneHeader}" Style="{StaticResource SectionTitleLabel}" />
                    <Label Text="{Binding DoneSummaryText}" />
                    <Button Text="{loc:Translate Common_Done}" Clicked="OnCloseClicked" Style="{StaticResource PrimaryButton}" HorizontalOptions="Start" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
