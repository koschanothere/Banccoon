                                    <DatePicker Date="{Binding Data.CheckInFromDate}" Format="{Binding Data.DatePickerFormat}" />
                                    <DatePicker Grid.Column="1" Date="{Binding Data.CheckInToDate}" Format="{Binding Data.DatePickerFormat}" />
                                    <Button Grid.Column="2" Command="{Binding Data.CreateCheckInCommand}" Style="{StaticResource PrimaryButton}" Text="Load" />
                                </Grid>
                                <CollectionView HeightRequest="230" ItemsSource="{Binding Data.CheckInExpectedTransactions}">
                                    <CollectionView.EmptyView>
                                        <Label Style="{StaticResource MutedLabel}" Text="No expected items loaded for this check-in period." />
