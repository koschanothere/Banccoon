                            <VerticalStackLayout Grid.Column="1" Spacing="10">
                                <VerticalStackLayout IsVisible="{Binding Data.IsStatementAccountUnmatched}" Spacing="8">
                                    <Label FontAttributes="Bold" Text="Connect statement account" />
