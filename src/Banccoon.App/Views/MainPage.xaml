                                    HorizontalTextAlignment="Center"
                                    Keyboard="Numeric"
                                    Text="{Binding Data.NewScheduledIntervalText}" />
                                <Picker
                                    Grid.Column="2"
                                    ItemDisplayBinding="{Binding ., Converter={StaticResource EnumDisplayConverter}}"
                                    ItemsSource="{Binding Data.RecurrenceFrequencies}"
                                    SelectedItem="{Binding Data.SelectedScheduledFrequency}" />
