                            <VerticalStackLayout Spacing="10">
                                <Label FontAttributes="Bold" Text="Reality comparison" />
                                <Grid ColumnDefinitions="1.2*,*,*" ColumnSpacing="10">
                                    <Picker ItemDisplayBinding="{Binding Name}" ItemsSource="{Binding Data.Accounts}" SelectedItem="{Binding Data.ReconciliationAccount}" Title="Account to compare" />
