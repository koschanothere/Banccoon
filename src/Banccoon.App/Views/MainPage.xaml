                        <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                        <VerticalStackLayout Spacing="10">
                            <Grid ColumnDefinitions="1.2*,*,*" ColumnSpacing="10">
                                <Entry Placeholder="Name" Text="{Binding Data.NewScheduledName}" />
                                <Picker Grid.Column="1" ItemDisplayBinding="{Binding Name}" ItemsSource="{Binding Data.Accounts}" SelectedItem="{Binding Data.NewScheduledAccount}" />
                                <Picker
                                    Grid.Column="2"
                                    ItemDisplayBinding="{Binding ., Converter={StaticResource EnumDisplayConverter}}"
