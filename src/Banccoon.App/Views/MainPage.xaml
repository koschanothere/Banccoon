<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Banccoon.App.Views.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:Banccoon.App.ViewModels"
    BackgroundColor="{StaticResource PageBackgroundColor}"
    Title="Banccoon">
    <Grid RowDefinitions="Auto,*">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding NavigationColumnWidth}" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border
            Grid.RowSpan="2"
            BackgroundColor="{StaticResource ShellBackgroundColor}"
            IsVisible="{Binding IsRailMode}"
            StrokeThickness="0">
            <Grid Padding="12,14" RowDefinitions="Auto,*,Auto">
                <Grid ColumnDefinitions="36,*,38" ColumnSpacing="9">
                    <Border
                        BackgroundColor="{StaticResource AccentColor}"
                        HeightRequest="34"
                        StrokeThickness="0"
                        WidthRequest="34">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <Label
                            FontAttributes="Bold"
                            FontSize="18"
                            HorizontalTextAlignment="Center"
                            Text="B"
                            TextColor="#FFFFFF"
                            VerticalTextAlignment="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="0">
                        <Label
                            FontAttributes="Bold"
                            FontSize="16"
                            Text="Banccoon"
                            TextColor="{StaticResource ShellTextColor}" />
                        <Label
                            FontSize="11"
                            Text="Private forecast"
                            TextColor="#B8C7BD" />
                    </VerticalStackLayout>
                    <Border
                        Grid.Column="2"
                        BackgroundColor="{StaticResource ShellPanelColor}"
                        HeightRequest="34"
                        StrokeThickness="0"
                        WidthRequest="34"
                        HorizontalOptions="End"
                        VerticalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleNavigationCommand}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout
                            HorizontalOptions="Center"
                            Spacing="4"
                            VerticalOptions="Center">
                            <BoxView
                                Color="{StaticResource ShellTextColor}"
                                HeightRequest="2"
                                WidthRequest="16" />
                            <BoxView
                                Color="{StaticResource ShellTextColor}"
                                HeightRequest="2"
                                WidthRequest="16" />
                            <BoxView
                                Color="{StaticResource ShellTextColor}"
                                HeightRequest="2"
                                WidthRequest="16" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <VerticalStackLayout Grid.Row="1" Margin="0,16,0,0" Spacing="4">
                    <Button
                        Command="{Binding SelectSectionCommand}"
                        CommandParameter="{x:Static viewModels:AppSection.Dashboard}"
                        Style="{StaticResource ShellButton}"
                        Text="Dashboard" />
                    <Button
                        Command="{Binding SelectSectionCommand}"
                        CommandParameter="{x:Static viewModels:AppSection.Accounts}"
                        Style="{StaticResource ShellButton}"
                        Text="Accounts" />
                    <Button
                        Command="{Binding SelectSectionCommand}"
                        CommandParameter="{x:Static viewModels:AppSection.Transactions}"
                        Style="{StaticResource ShellButton}"
                        Text="Transactions" />
                    <Button
                        Command="{Binding SelectSectionCommand}"
                        CommandParameter="{x:Static viewModels:AppSection.Scheduled}"
                        Style="{StaticResource ShellButton}"
                        Text="Scheduled" />
                    <Button
                        Command="{Binding SelectSectionCommand}"
                        CommandParameter="{x:Static viewModels:AppSection.Forecast}"
                        Style="{StaticResource ShellButton}"
                        Text="Forecast" />
                    <Button
                        Command="{Binding SelectSectionCommand}"
                        CommandParameter="{x:Static viewModels:AppSection.Analytics}"
                        Style="{StaticResource ShellButton}"
                        Text="Analytics" />
                    <Button
                        Command="{Binding SelectSectionCommand}"
                        CommandParameter="{x:Static viewModels:AppSection.Preferences}"
                        Style="{StaticResource ShellButton}"
                        Text="Preferences" />
                </VerticalStackLayout>

                <Border
                    Grid.Row="2"
                    Padding="12"
                    BackgroundColor="{StaticResource ShellPanelColor}"
                    StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="4">
                        <Label
                            FontAttributes="Bold"
                            FontSize="12"
                            Text="Logo space"
                            TextColor="{StaticResource ShellTextColor}" />
                        <Label
                            FontSize="11"
                            Text="Ready for the Banccoon mascot."
                            TextColor="#B8C7BD" />
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </Border>

        <Border
            Grid.Column="1"
            BackgroundColor="{StaticResource SurfaceColor}"
            Stroke="{StaticResource DividerColor}"
            StrokeThickness="0">
            <Grid Padding="22,14" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" RowDefinitions="Auto,Auto">
                <Border
                    HeightRequest="38"
                    IsVisible="{Binding IsMenuButtonVisible}"
                    StrokeThickness="0"
                    WidthRequest="38"
                    BackgroundColor="{StaticResource SurfaceMutedColor}"
                    VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleNavigationCommand}" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout
                        HorizontalOptions="Center"
                        Spacing="4"
                        VerticalOptions="Center">
                        <BoxView
                            Color="{StaticResource PrimaryTextColor}"
                            HeightRequest="2"
                            WidthRequest="18" />
                        <BoxView
                            Color="{StaticResource PrimaryTextColor}"
                            HeightRequest="2"
                            WidthRequest="18" />
                        <BoxView
                            Color="{StaticResource PrimaryTextColor}"
                            HeightRequest="2"
                            WidthRequest="18" />
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout Grid.Column="1" Spacing="2">
                    <Label
                        FontAttributes="Bold"
                        FontSize="22"
                        Text="{Binding SelectedTitle}" />
                    <Label
                        Style="{StaticResource MutedLabel}"
                        Text="{Binding SelectedDescription}" />
                </VerticalStackLayout>

                <HorizontalStackLayout
                    Grid.Column="2"
                    Spacing="8"
                    VerticalOptions="Center">
                    <Button
                        Command="{Binding UseRailNavigationCommand}"
                        Style="{StaticResource QuietButton}"
                        Text="Rail" />
                    <Button
                        Command="{Binding UseTopTabsCommand}"
                        Style="{StaticResource QuietButton}"
                        Text="Tabs" />
                </HorizontalStackLayout>

                <ScrollView
                    Grid.Row="1"
                    Grid.ColumnSpan="3"
                    Margin="0,14,0,0"
                    IsVisible="{Binding IsTopTabsMode}"
                    Orientation="Horizontal">
                    <HorizontalStackLayout Spacing="8">
                        <Button
                            Command="{Binding SelectSectionCommand}"
                            CommandParameter="{x:Static viewModels:AppSection.Dashboard}"
                            Style="{StaticResource QuietButton}"
                            Text="Dashboard" />
                        <Button
                            Command="{Binding SelectSectionCommand}"
                            CommandParameter="{x:Static viewModels:AppSection.Accounts}"
                            Style="{StaticResource QuietButton}"
                            Text="Accounts" />
                        <Button
                            Command="{Binding SelectSectionCommand}"
                            CommandParameter="{x:Static viewModels:AppSection.Transactions}"
                            Style="{StaticResource QuietButton}"
                            Text="Transactions" />
                        <Button
                            Command="{Binding SelectSectionCommand}"
                            CommandParameter="{x:Static viewModels:AppSection.Scheduled}"
                            Style="{StaticResource QuietButton}"
                            Text="Scheduled" />
                        <Button
                            Command="{Binding SelectSectionCommand}"
                            CommandParameter="{x:Static viewModels:AppSection.Forecast}"
                            Style="{StaticResource QuietButton}"
                            Text="Forecast" />
                        <Button
                            Command="{Binding SelectSectionCommand}"
                            CommandParameter="{x:Static viewModels:AppSection.Analytics}"
                            Style="{StaticResource QuietButton}"
                            Text="Analytics" />
                        <Button
                            Command="{Binding SelectSectionCommand}"
                            CommandParameter="{x:Static viewModels:AppSection.Preferences}"
                            Style="{StaticResource QuietButton}"
                            Text="Preferences" />
                    </HorizontalStackLayout>
                </ScrollView>
            </Grid>
        </Border>

        <ScrollView Grid.Row="1" Grid.Column="1">
            <Grid Padding="28" RowDefinitions="Auto">
                <VerticalStackLayout
                    IsVisible="{Binding IsDashboardSelected}"
                    Spacing="22">
                    <Grid ColumnDefinitions="2*,*" ColumnSpacing="18">
                        <Border
                            Padding="22"
                            BackgroundColor="{StaticResource SurfaceColor}"
                            Stroke="{StaticResource DividerColor}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="14">
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="30"
                                    Text="You can safely spend €0 today." />
                                <Label
                                    Style="{StaticResource MutedLabel}"
                                    Text="Once accounts and scheduled payments are wired into the UI, this will use the forecast engine and local SQLite data." />
                                <HorizontalStackLayout Spacing="10">
                                    <Button
                                        Command="{Binding SelectSectionCommand}"
                                        CommandParameter="{x:Static viewModels:AppSection.Accounts}"
                                        Style="{StaticResource PrimaryButton}"
                                        Text="Add account" />
                                    <Button
                                        Command="{Binding SelectSectionCommand}"
                                        CommandParameter="{x:Static viewModels:AppSection.Scheduled}"
                                        Style="{StaticResource QuietButton}"
                                        Text="Add scheduled item" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Border>

                        <Border
                            Grid.Column="1"
                            Padding="18"
                            BackgroundColor="{StaticResource AccentSoftColor}"
                            StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="8">
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="16"
                                    Text="Weekly check-in" />
                                <Label
                                    Style="{StaticResource MutedLabel}"
                                    Text="Future workflow: confirm what happened, enter real balances, and reconcile differences without logging every tiny purchase." />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="14">
                        <Border Padding="16" BackgroundColor="{StaticResource SurfaceColor}" Stroke="{StaticResource DividerColor}">
                            <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                            <VerticalStackLayout>
                                <Label Style="{StaticResource MutedLabel}" Text="Current balance" />
                                <Label FontAttributes="Bold" FontSize="24" Text="€0" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="1" Padding="16" BackgroundColor="{StaticResource SurfaceColor}" Stroke="{StaticResource DividerColor}">
                            <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                            <VerticalStackLayout>
                                <Label Style="{StaticResource MutedLabel}" Text="Upcoming obligations" />
                                <Label FontAttributes="Bold" FontSize="24" Text="€0" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="2" Padding="16" BackgroundColor="{StaticResource SurfaceColor}" Stroke="{StaticResource DividerColor}">
                            <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                            <VerticalStackLayout>
                                <Label Style="{StaticResource MutedLabel}" Text="Lowest forecast" />
                                <Label FontAttributes="Bold" FontSize="24" Text="€0" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="3" Padding="16" BackgroundColor="{StaticResource SurfaceColor}" Stroke="{StaticResource DividerColor}">
                            <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                            <VerticalStackLayout>
                                <Label Style="{StaticResource MutedLabel}" Text="Forecast period" />
                                <Label FontAttributes="Bold" FontSize="24" Text="30 days" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </VerticalStackLayout>

                <VerticalStackLayout IsVisible="{Binding IsAccountsSelected}" Spacing="14">
                    <Label Style="{StaticResource SectionTitleLabel}" Text="Accounts" />
                    <Label Style="{StaticResource MutedLabel}" Text="This screen will manage cash, debit, credit, savings, investment, and other accounts." />
                    <Button HorizontalOptions="Start" Style="{StaticResource PrimaryButton}" Text="New account" />
                </VerticalStackLayout>

                <VerticalStackLayout IsVisible="{Binding IsTransactionsSelected}" Spacing="14">
                    <Label Style="{StaticResource SectionTitleLabel}" Text="Transactions" />
                    <Label Style="{StaticResource MutedLabel}" Text="Manual transactions and grouped spending will live here, with categories optional by design." />
                    <Button HorizontalOptions="Start" Style="{StaticResource PrimaryButton}" Text="Add transaction" />
                </VerticalStackLayout>

                <VerticalStackLayout IsVisible="{Binding IsScheduledSelected}" Spacing="14">
                    <Label Style="{StaticResource SectionTitleLabel}" Text="Scheduled" />
                    <Label Style="{StaticResource MutedLabel}" Text="Recurring income, bills, subscriptions, and planned payments will be managed here." />
                    <Button HorizontalOptions="Start" Style="{StaticResource PrimaryButton}" Text="New scheduled item" />
                </VerticalStackLayout>

                <VerticalStackLayout IsVisible="{Binding IsForecastSelected}" Spacing="14">
                    <Label Style="{StaticResource SectionTitleLabel}" Text="Forecast" />
                    <Label Style="{StaticResource MutedLabel}" Text="A timeline of expected money movement and projected balances will appear here." />
                </VerticalStackLayout>

                <VerticalStackLayout IsVisible="{Binding IsAnalyticsSelected}" Spacing="14">
                    <Label Style="{StaticResource SectionTitleLabel}" Text="Analytics" />
                    <Label Style="{StaticResource MutedLabel}" Text="Future analytics will explain trends, categories, changes, and available spending patterns." />
                </VerticalStackLayout>

                <VerticalStackLayout IsVisible="{Binding IsPreferencesSelected}" Spacing="14">
                    <Label Style="{StaticResource SectionTitleLabel}" Text="Preferences" />
                    <Label Style="{StaticResource MutedLabel}" Text="Appearance, navigation style, default currency, analytics options, and privacy settings will be customized here." />
                    <Border
                        Padding="16"
                        BackgroundColor="{StaticResource SurfaceColor}"
                        Stroke="{StaticResource DividerColor}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="*,180" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="4">
                                <Label
                                    FontAttributes="Bold"
                                    Text="Default currency" />
                                <Label
                                    Style="{StaticResource MutedLabel}"
                                    Text="Used as the default for new accounts and future analytics summaries." />
                            </VerticalStackLayout>
                            <Picker
                                Grid.Column="1"
                                ItemsSource="{Binding SupportedCurrencies}"
                                SelectedItem="{Binding DefaultCurrency}"
                                VerticalOptions="Center" />
                        </Grid>
                    </Border>
                    <Border
                        Padding="16"
                        BackgroundColor="{StaticResource SurfaceColor}"
                        Stroke="{StaticResource DividerColor}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="4">
                                <Label
                                    FontAttributes="Bold"
                                    Text="Power-user features" />
                                <Label
                                    Style="{StaticResource MutedLabel}"
                                    Text="Show advanced controls such as technical recurrence syntax. Friendly controls stay as the default." />
                            </VerticalStackLayout>
                            <CheckBox
                                Grid.Column="1"
                                IsChecked="{Binding ShowPowerUserFeatures}"
                                VerticalOptions="Center" />
                        </Grid>
                    </Border>
                    <Grid ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="10">
                        <Button
                            Command="{Binding UseRailNavigationCommand}"
                            Style="{StaticResource QuietButton}"
                            Text="Use rail" />
                        <Button
                            Grid.Column="1"
                            Command="{Binding UseCompactNavigationCommand}"
                            Style="{StaticResource QuietButton}"
                            Text="Compact rail" />
                        <Button
                            Grid.Column="2"
                            Command="{Binding UseTopTabsCommand}"
                            Style="{StaticResource QuietButton}"
                            Text="Use tabs" />
                    </Grid>
                </VerticalStackLayout>
            </Grid>
        </ScrollView>
    </Grid>
</ContentPage>
