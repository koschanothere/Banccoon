<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Banccoon.App.Views.MainPage"
    x:Name="Page"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:Banccoon.App.ViewModels"
    BackgroundColor="{StaticResource PageBackgroundColor}"
    Title="Banccoon">
    <Grid RowDefinitions="Auto,*">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding NavigationColumnWidth}" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border
            Grid.RowSpan="2"
            BackgroundColor="{StaticResource ShellBackgroundColor}"
            IsVisible="{Binding IsRailMode}"
            StrokeThickness="0">
            <Grid Padding="12,14" RowDefinitions="Auto,*,Auto">
                <Grid ColumnDefinitions="36,*,38" ColumnSpacing="9">
                    <Border
                        BackgroundColor="{StaticResource AccentColor}"
                        HeightRequest="34"
                        StrokeThickness="0"
                        WidthRequest="34">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <Image
                            Aspect="AspectFit"
                            Margin="5"
                            Source="banccoon_mark_placeholder.svg" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="0">
                        <Label
                            FontAttributes="Bold"
                            FontSize="16"
                            Text="Banccoon"
                            TextColor="{StaticResource ShellTextColor}" />
                        <Label
                            FontSize="11"
                            Text="Private forecast"
                            TextColor="#B8C7BD" />
                    </VerticalStackLayout>
                    <Border
                        Grid.Column="2"
                        BackgroundColor="{StaticResource ShellPanelColor}"
                        HeightRequest="34"
                        HorizontalOptions="End"
                        StrokeThickness="0"
                        VerticalOptions="Center"
                        WidthRequest="34">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleNavigationCommand}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout
                            HorizontalOptions="Center"
                            Spacing="4"
                            VerticalOptions="Center">
                            <BoxView
                                Color="{StaticResource ShellTextColor}"
                                HeightRequest="2"
                                WidthRequest="16" />
                            <BoxView
                                Color="{StaticResource ShellTextColor}"
                                HeightRequest="2"
                                WidthRequest="16" />
                            <BoxView
                                Color="{StaticResource ShellTextColor}"
                                HeightRequest="2"
                                WidthRequest="16" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <VerticalStackLayout Grid.Row="1" Margin="0,16,0,0" Spacing="4">
                    <Button
                        Command="{Binding SelectSectionCommand}"
                        CommandParameter="{x:Static viewModels:AppSection.Dashboard}"
                        Style="{StaticResource ShellButton}"
                        Text="Dashboard" />
                    <Button
                        Command="{Binding SelectSectionCommand}"
                        CommandParameter="{x:Static viewModels:AppSection.Accounts}"
                        Style="{StaticResource ShellButton}"
                        Text="Accounts" />
                    <Button
                        Command="{Binding SelectSectionCommand}"
                        CommandParameter="{x:Static viewModels:AppSection.Transactions}"
                        Style="{StaticResource ShellButton}"
                        Text="Transactions" />
                    <Button
                        Command="{Binding SelectSectionCommand}"
                        CommandParameter="{x:Static viewModels:AppSection.Scheduled}"
                        Style="{StaticResource ShellButton}"
                        Text="Scheduled" />
                    <Button
                        Command="{Binding SelectSectionCommand}"
                        CommandParameter="{x:Static viewModels:AppSection.Goals}"
                        Style="{StaticResource ShellButton}"
                        Text="Goals" />
                    <Button
                        Command="{Binding SelectSectionCommand}"
                        CommandParameter="{x:Static viewModels:AppSection.Forecast}"
                        Style="{StaticResource ShellButton}"
                        Text="Forecast" />
                    <Button
                        Command="{Binding SelectSectionCommand}"
                        CommandParameter="{x:Static viewModels:AppSection.Analytics}"
                        Style="{StaticResource ShellButton}"
                        Text="Analytics" />
                    <Button
                        Command="{Binding SelectSectionCommand}"
                        CommandParameter="{x:Static viewModels:AppSection.Preferences}"
                        Style="{StaticResource ShellButton}"
                        Text="Preferences" />
                </VerticalStackLayout>

                <Border
                    Grid.Row="2"
                    Padding="12"
                    BackgroundColor="{StaticResource ShellPanelColor}"
                    StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="4">
                        <Label
                            FontAttributes="Bold"
                            FontSize="12"
                            Text="Logo folder"
                            TextColor="{StaticResource ShellTextColor}" />
                        <Label
                            FontSize="11"
                            Text="Resources/Images/banccoon"
                            TextColor="#B8C7BD" />
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </Border>

        <Border
            Grid.Column="1"
            BackgroundColor="{StaticResource SurfaceColor}"
            Stroke="{StaticResource DividerColor}"
            StrokeThickness="0">
            <Grid Padding="22,14" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" RowDefinitions="Auto,Auto">
                <Border
                    BackgroundColor="{StaticResource SurfaceMutedColor}"
                    HeightRequest="38"
                    IsVisible="{Binding IsMenuButtonVisible}"
                    StrokeThickness="0"
                    VerticalOptions="Center"
                    WidthRequest="38">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleNavigationCommand}" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout
                        HorizontalOptions="Center"
                        Spacing="4"
                        VerticalOptions="Center">
                        <BoxView
                            Color="{StaticResource PrimaryTextColor}"
                            HeightRequest="2"
                            WidthRequest="18" />
                        <BoxView
                            Color="{StaticResource PrimaryTextColor}"
                            HeightRequest="2"
                            WidthRequest="18" />
                        <BoxView
                            Color="{StaticResource PrimaryTextColor}"
                            HeightRequest="2"
                            WidthRequest="18" />
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout Grid.Column="1" Spacing="2">
                    <Label
                        FontAttributes="Bold"
                        FontSize="22"
                        Text="{Binding SelectedTitle}" />
                    <Label
                        Style="{StaticResource MutedLabel}"
                        Text="{Binding SelectedDescription}" />
                </VerticalStackLayout>

                <HorizontalStackLayout
                    Grid.Column="2"
                    Spacing="8"
                    VerticalOptions="Center">
                    <Button
                        Command="{Binding Data.RefreshCommand}"
                        Style="{StaticResource QuietButton}"
                        Text="Refresh" />
                    <Button
                        Command="{Binding UseRailNavigationCommand}"
                        Style="{StaticResource QuietButton}"
                        Text="Rail" />
                    <Button
                        Command="{Binding UseTopTabsCommand}"
                        Style="{StaticResource QuietButton}"
                        Text="Tabs" />
                </HorizontalStackLayout>

                <ScrollView
                    Grid.Row="1"
                    Grid.ColumnSpan="3"
                    Margin="0,14,0,0"
                    IsVisible="{Binding IsTopTabsMode}"
                    Orientation="Horizontal">
                    <HorizontalStackLayout Spacing="8">
                        <Button Command="{Binding SelectSectionCommand}" CommandParameter="{x:Static viewModels:AppSection.Dashboard}" Style="{StaticResource QuietButton}" Text="Dashboard" />
                        <Button Command="{Binding SelectSectionCommand}" CommandParameter="{x:Static viewModels:AppSection.Accounts}" Style="{StaticResource QuietButton}" Text="Accounts" />
                        <Button Command="{Binding SelectSectionCommand}" CommandParameter="{x:Static viewModels:AppSection.Transactions}" Style="{StaticResource QuietButton}" Text="Transactions" />
                        <Button Command="{Binding SelectSectionCommand}" CommandParameter="{x:Static viewModels:AppSection.Scheduled}" Style="{StaticResource QuietButton}" Text="Scheduled" />
                        <Button Command="{Binding SelectSectionCommand}" CommandParameter="{x:Static viewModels:AppSection.Goals}" Style="{StaticResource QuietButton}" Text="Goals" />
                        <Button Command="{Binding SelectSectionCommand}" CommandParameter="{x:Static viewModels:AppSection.Forecast}" Style="{StaticResource QuietButton}" Text="Forecast" />
                        <Button Command="{Binding SelectSectionCommand}" CommandParameter="{x:Static viewModels:AppSection.Analytics}" Style="{StaticResource QuietButton}" Text="Analytics" />
                        <Button Command="{Binding SelectSectionCommand}" CommandParameter="{x:Static viewModels:AppSection.Preferences}" Style="{StaticResource QuietButton}" Text="Preferences" />
                    </HorizontalStackLayout>
                </ScrollView>
            </Grid>
        </Border>

        <ScrollView Grid.Row="1" Grid.Column="1">
            <VerticalStackLayout Padding="28" Spacing="18">
                <Border
                    Padding="12,10"
                    BackgroundColor="{StaticResource AccentSoftColor}"
                    IsVisible="{Binding Data.HasStatusMessage}"
                    StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>
                    <Label
                        FontSize="13"
                        Text="{Binding Data.StatusMessage}"
                        TextColor="{StaticResource PrimaryTextColor}" />
                </Border>

                <VerticalStackLayout
                    IsVisible="{Binding IsDashboardSelected}"
                    Spacing="18">
                    <Grid ColumnDefinitions="2*,*" ColumnSpacing="18">
                        <Border
                            Padding="22"
                            BackgroundColor="{StaticResource SurfaceColor}"
                            Stroke="{StaticResource DividerColor}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="14">
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="30"
                                    Text="{Binding Data.AvailableToSpendText, StringFormat='You can safely spend {0}.'}" />
                                <Label
                                    Style="{StaticResource MutedLabel}"
                                    Text="This uses saved local accounts, scheduled obligations, credit card payments, and savings reservations." />
                                <HorizontalStackLayout Spacing="10">
                                    <Button
                                        Command="{Binding SelectSectionCommand}"
                                        CommandParameter="{x:Static viewModels:AppSection.Accounts}"
                                        Style="{StaticResource PrimaryButton}"
                                        Text="Add account" />
                                    <Button
                                        Command="{Binding SelectSectionCommand}"
                                        CommandParameter="{x:Static viewModels:AppSection.Scheduled}"
                                        Style="{StaticResource QuietButton}"
                                        Text="Add scheduled item" />
                                    <Button
                                        Command="{Binding SelectSectionCommand}"
                                        CommandParameter="{x:Static viewModels:AppSection.Goals}"
                                        Style="{StaticResource QuietButton}"
                                        Text="Add goal" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Border>

                        <Border
                            Grid.Column="1"
                            Padding="18"
                            BackgroundColor="{StaticResource SurfaceColor}"
                            Stroke="{StaticResource DividerColor}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="8">
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="16"
                                    Text="Next obligations" />
                                <CollectionView
                                    HeightRequest="156"
                                    ItemsSource="{Binding Data.UpcomingObligations}">
                                    <CollectionView.EmptyView>
                                        <Label Style="{StaticResource MutedLabel}" Text="No obligations in this forecast period." />
                                    </CollectionView.EmptyView>
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Padding="0,4" ColumnDefinitions="*,Auto">
                                                <VerticalStackLayout Spacing="1">
                                                    <Label FontAttributes="Bold" FontSize="13" Text="{Binding Name}" />
                                                    <Label FontSize="11" Style="{StaticResource MutedLabel}" Text="{Binding DateText}" />
                                                </VerticalStackLayout>
                                                <Label Grid.Column="1" FontAttributes="Bold" Text="{Binding AmountText}" />
                                            </Grid>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="14">
                        <Border Padding="16" BackgroundColor="{StaticResource SurfaceColor}" Stroke="{StaticResource DividerColor}">
                            <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                            <VerticalStackLayout>
                                <Label Style="{StaticResource MutedLabel}" Text="Current balance" />
                                <Label FontAttributes="Bold" FontSize="24" Text="{Binding Data.CurrentBalanceText}" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="1" Padding="16" BackgroundColor="{StaticResource SurfaceColor}" Stroke="{StaticResource DividerColor}">
                            <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                            <VerticalStackLayout>
                                <Label Style="{StaticResource MutedLabel}" Text="Upcoming obligations" />
                                <Label FontAttributes="Bold" FontSize="24" Text="{Binding Data.UpcomingObligationsText}" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="2" Padding="16" BackgroundColor="{StaticResource SurfaceColor}" Stroke="{StaticResource DividerColor}">
                            <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                            <VerticalStackLayout>
                                <Label Style="{StaticResource MutedLabel}" Text="Lowest forecast" />
                                <Label FontAttributes="Bold" FontSize="24" Text="{Binding Data.LowestForecastText}" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="3" Padding="16" BackgroundColor="{StaticResource SurfaceColor}" Stroke="{StaticResource DividerColor}">
                            <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                            <VerticalStackLayout>
                                <Label Style="{StaticResource MutedLabel}" Text="Forecast period" />
                                <Label FontAttributes="Bold" FontSize="24" Text="{Binding Data.ForecastPeriodText}" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </VerticalStackLayout>

                <VerticalStackLayout IsVisible="{Binding IsAccountsSelected}" Spacing="16">
                    <Label Style="{StaticResource SectionTitleLabel}" Text="Accounts" />
                    <Grid ColumnDefinitions="1.1*,1.2*" ColumnSpacing="18">
                        <Border Padding="16" BackgroundColor="{StaticResource SurfaceColor}" Stroke="{StaticResource DividerColor}">
                            <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                            <VerticalStackLayout Spacing="10">
                                <Label FontAttributes="Bold" Text="New account" />
                                <Entry Placeholder="Name" Text="{Binding Data.NewAccountName}" />
                                <Picker
                                    ItemDisplayBinding="{Binding ., Converter={StaticResource EnumDisplayConverter}}"
                                    ItemsSource="{Binding Data.AccountTypes}"
                                    SelectedItem="{Binding Data.SelectedAccountType}" />
                                <Grid ColumnDefinitions="*,140" ColumnSpacing="10">
                                    <Entry Keyboard="Numeric" Placeholder="Balance" Text="{Binding Data.NewAccountBalanceText}" />
                                    <Picker Grid.Column="1" ItemsSource="{Binding Data.SupportedCurrencies}" SelectedItem="{Binding Data.NewAccountCurrency}" />
                                </Grid>
                                <VerticalStackLayout IsVisible="{Binding Data.IsNewAccountCreditCard}" Spacing="8">
                                    <Label FontAttributes="Bold" FontSize="13" Text="Credit card details" />
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                        <Entry Keyboard="Numeric" Placeholder="Current debt" Text="{Binding Data.NewCreditCardDebtText}" />
                                        <Entry Grid.Column="1" Keyboard="Numeric" Placeholder="Due day, 1-31" Text="{Binding Data.NewCreditCardPaymentDueDayText}" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                        <Entry Keyboard="Numeric" Placeholder="Minimum payment" Text="{Binding Data.NewCreditCardMinimumPaymentText}" />
                                        <Entry Grid.Column="1" Keyboard="Numeric" Placeholder="Planned payment" Text="{Binding Data.NewCreditCardPlannedPaymentText}" />
                                    </Grid>
                                </VerticalStackLayout>
                                <Button Command="{Binding Data.AddAccountCommand}" Style="{StaticResource PrimaryButton}" Text="Save account" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Column="1" Padding="16" BackgroundColor="{StaticResource SurfaceColor}" Stroke="{StaticResource DividerColor}">
                            <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                            <VerticalStackLayout Spacing="10">
                                <Label FontAttributes="Bold" Text="Update selected account" />
                                <Picker
                                    ItemDisplayBinding="{Binding Name}"
                                    ItemsSource="{Binding Data.Accounts}"
                                    SelectedItem="{Binding Data.SelectedAccount}" />
                                <Entry Keyboard="Numeric" Placeholder="Current balance" Text="{Binding Data.SelectedAccountBalanceText}" />
                                <VerticalStackLayout IsVisible="{Binding Data.IsSelectedAccountCreditCard}" Spacing="8">
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                        <Entry Keyboard="Numeric" Placeholder="Current debt" Text="{Binding Data.SelectedAccountDebtText}" />
                                        <Entry Grid.Column="1" Keyboard="Numeric" Placeholder="Due day, 1-31" Text="{Binding Data.SelectedAccountPaymentDueDayText}" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                        <Entry Keyboard="Numeric" Placeholder="Minimum payment" Text="{Binding Data.SelectedAccountMinimumPaymentText}" />
                                        <Entry Grid.Column="1" Keyboard="Numeric" Placeholder="Planned payment" Text="{Binding Data.SelectedAccountPlannedPaymentText}" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                        <Entry Keyboard="Numeric" Placeholder="Payoff calculator payment" Text="{Binding Data.SelectedAccountPayoffPaymentText}" />
                                        <Entry Grid.Column="1" Keyboard="Numeric" Placeholder="Manual monthly finance charge" Text="{Binding Data.SelectedAccountManualFinanceChargeText}" />
                                    </Grid>
                                    <Label Style="{StaticResource MutedLabel}" Text="{Binding Data.SelectedAccountPayoffSummary}" />
                                </VerticalStackLayout>
                                <Button Command="{Binding Data.SaveSelectedAccountCommand}" Style="{StaticResource PrimaryButton}" Text="Update account" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <CollectionView ItemsSource="{Binding Data.AccountSummaries}">
                        <CollectionView.EmptyView>
                            <Label Style="{StaticResource MutedLabel}" Text="No accounts yet." />
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8" Padding="14" BackgroundColor="{StaticResource SurfaceColor}" Stroke="{StaticResource DividerColor}">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                                        <VerticalStackLayout Spacing="2">
                                            <Label FontAttributes="Bold" Text="{Binding Name}" />
                                            <Label Style="{StaticResource MutedLabel}" Text="{Binding CreditText}" />
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="1" HorizontalOptions="End" Spacing="2">
                                            <Label FontAttributes="Bold" HorizontalTextAlignment="End" Text="{Binding BalanceText}" />
                                            <Label Style="{StaticResource MutedLabel}" HorizontalTextAlignment="End" Text="{Binding TypeText}" />
                                        </VerticalStackLayout>
                                        <Button
                                            Grid.Column="2"
                                            Command="{Binding BindingContext.Data.DeleteAccountCommand, Source={x:Reference Page}}"
                                            CommandParameter="{Binding Source}"
                                            Style="{StaticResource QuietButton}"
                                            Text="Delete" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <VerticalStackLayout IsVisible="{Binding IsTransactionsSelected}" Spacing="16">
                    <Label Style="{StaticResource SectionTitleLabel}" Text="Transactions" />
                    <Border Padding="16" BackgroundColor="{StaticResource SurfaceColor}" Stroke="{StaticResource DividerColor}">
                        <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                        <Grid ColumnDefinitions="1.4*,*,*,*,Auto" ColumnSpacing="10">
                            <Picker ItemDisplayBinding="{Binding Name}" ItemsSource="{Binding Data.Accounts}" SelectedItem="{Binding Data.NewTransactionAccount}" />
                            <Picker
                                Grid.Column="1"
                                ItemDisplayBinding="{Binding ., Converter={StaticResource EnumDisplayConverter}}"
                                ItemsSource="{Binding Data.TransactionTypes}"
                                SelectedItem="{Binding Data.SelectedTransactionType}" />
                            <DatePicker
                                Grid.Column="2"
                                Date="{Binding Data.NewTransactionDate}"
                                Format="{Binding Data.DatePickerFormat}" />
                            <Entry Grid.Column="3" Keyboard="Numeric" Placeholder="Amount" Text="{Binding Data.NewTransactionAmountText}" />
                            <Button Grid.Column="4" Command="{Binding Data.AddTransactionCommand}" Style="{StaticResource PrimaryButton}" Text="Add" />
                        </Grid>
                    </Border>
                    <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="10">
                        <Picker
                            ItemDisplayBinding="{Binding Name}"
                            ItemsSource="{Binding Data.CategoryChoices}"
                            SelectedItem="{Binding Data.SelectedTransactionCategory}" />
                        <Entry
                            Grid.Column="1"
                            Placeholder="New category"
                            Text="{Binding Data.NewCategoryName}" />
                        <Button
                            Grid.Column="2"
                            Command="{Binding Data.AddCategoryCommand}"
                            Style="{StaticResource QuietButton}"
                            Text="Add category" />
                    </Grid>
                    <CollectionView
                        HeightRequest="70"
                        ItemsSource="{Binding Data.CategorySummaries}">
                        <CollectionView.EmptyView>
                            <Label Style="{StaticResource MutedLabel}" Text="No categories yet. Transactions can still use None." />
                        </CollectionView.EmptyView>
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Padding="10,8"
                                    BackgroundColor="{StaticResource SurfaceColor}"
                                    Stroke="{StaticResource DividerColor}">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="8" />
                                    </Border.StrokeShape>
                                    <HorizontalStackLayout Spacing="8">
                                        <Label VerticalTextAlignment="Center" Text="{Binding Name}" />
                                        <Button
                                            Command="{Binding BindingContext.Data.DeleteCategoryCommand, Source={x:Reference Page}}"
                                            CommandParameter="{Binding Source}"
                                            Style="{StaticResource QuietButton}"
                                            Text="Delete" />
                                    </HorizontalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                    <Entry Placeholder="Notes" Text="{Binding Data.NewTransactionNotes}" />
                    <CollectionView ItemsSource="{Binding Data.TransactionSummaries}">
                        <CollectionView.EmptyView>
                            <Label Style="{StaticResource MutedLabel}" Text="No transactions yet." />
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8" Padding="14" BackgroundColor="{StaticResource SurfaceColor}" Stroke="{StaticResource DividerColor}">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                                        <VerticalStackLayout Spacing="2">
                                            <Label FontAttributes="Bold" Text="{Binding AccountName}" />
                                            <Label Style="{StaticResource MutedLabel}" Text="{Binding CategoryText}" />
                                            <Label Style="{StaticResource MutedLabel}" Text="{Binding NotesText}" />
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="1" HorizontalOptions="End" Spacing="2">
                                            <Label FontAttributes="Bold" HorizontalTextAlignment="End" Text="{Binding AmountText}" />
                                            <Label Style="{StaticResource MutedLabel}" HorizontalTextAlignment="End" Text="{Binding DateText}" />
                                        </VerticalStackLayout>
                                        <Button Grid.Column="2" Command="{Binding BindingContext.Data.DeleteTransactionCommand, Source={x:Reference Page}}" CommandParameter="{Binding Source}" Style="{StaticResource QuietButton}" Text="Delete" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <VerticalStackLayout IsVisible="{Binding IsScheduledSelected}" Spacing="16">
                    <Label Style="{StaticResource SectionTitleLabel}" Text="Scheduled" />
                    <Border Padding="16" BackgroundColor="{StaticResource SurfaceColor}" Stroke="{StaticResource DividerColor}">
                        <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                        <VerticalStackLayout Spacing="10">
                            <Grid ColumnDefinitions="1.2*,*,*" ColumnSpacing="10">
                                <Entry Placeholder="Name" Text="{Binding Data.NewScheduledName}" />
                                <Picker Grid.Column="1" ItemDisplayBinding="{Binding Name}" ItemsSource="{Binding Data.Accounts}" SelectedItem="{Binding Data.NewScheduledAccount}" />
                                <Picker
                                    Grid.Column="2"
                                    ItemDisplayBinding="{Binding ., Converter={StaticResource EnumDisplayConverter}}"
                                    ItemsSource="{Binding Data.TransactionTypes}"
                                    SelectedItem="{Binding Data.SelectedScheduledType}" />
                            </Grid>
                            <Entry Keyboard="Numeric" Placeholder="Amount" Text="{Binding Data.NewScheduledAmountText}" />
                            <Grid ColumnDefinitions="Auto,70,170,Auto,Auto" ColumnSpacing="8">
                                <Label
                                    Text="Every"
                                    VerticalTextAlignment="Center" />
                                <Entry
                                    Grid.Column="1"
                                    HorizontalTextAlignment="Center"
                                    Keyboard="Numeric"
                                    Text="{Binding Data.NewScheduledIntervalText}" />
                                <Picker
                                    Grid.Column="2"
                                    ItemDisplayBinding="{Binding ., Converter={StaticResource EnumDisplayConverter}}"
                                    ItemsSource="{Binding Data.RecurrenceFrequencies}"
                                    SelectedItem="{Binding Data.SelectedScheduledFrequency}" />
                                <Label
                                    Grid.Column="3"
                                    Text="starting"
                                    VerticalTextAlignment="Center" />
                                <DatePicker
                                    Grid.Column="4"
                                    Date="{Binding Data.NewScheduledDate}"
                                    Format="{Binding Data.DatePickerFormat}" />
                            </Grid>
                            <Label
                                Style="{StaticResource MutedLabel}"
                                Text="{Binding Data.ScheduledRecurrenceSentencePreview}" />
                            <Picker
                                ItemDisplayBinding="{Binding Name}"
                                ItemsSource="{Binding Data.CategoryChoices}"
                                SelectedItem="{Binding Data.SelectedScheduledCategory}" />
                            <Button Command="{Binding Data.AddScheduledTransactionCommand}" Style="{StaticResource PrimaryButton}" Text="Save scheduled item" />
                        </VerticalStackLayout>
                    </Border>
                    <CollectionView ItemsSource="{Binding Data.ScheduledTransactionSummaries}">
                        <CollectionView.EmptyView>
                            <Label Style="{StaticResource MutedLabel}" Text="No scheduled transactions yet." />
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8" Padding="14" BackgroundColor="{StaticResource SurfaceColor}" Stroke="{StaticResource DividerColor}">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                                        <VerticalStackLayout Spacing="2">
                                            <Label FontAttributes="Bold" Text="{Binding Name}" />
                                            <Label Style="{StaticResource MutedLabel}" Text="{Binding RecurrenceText}" />
                                            <Label Style="{StaticResource MutedLabel}" Text="{Binding CategoryText}" />
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="1" HorizontalOptions="End" Spacing="2">
                                            <Label FontAttributes="Bold" HorizontalTextAlignment="End" Text="{Binding AmountText}" />
                                            <Label Style="{StaticResource MutedLabel}" HorizontalTextAlignment="End" Text="{Binding NextText}" />
                                        </VerticalStackLayout>
                                        <Button Grid.Column="2" Command="{Binding BindingContext.Data.DeleteScheduledTransactionCommand, Source={x:Reference Page}}" CommandParameter="{Binding Source}" Style="{StaticResource QuietButton}" Text="Delete" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <VerticalStackLayout IsVisible="{Binding IsGoalsSelected}" Spacing="16">
                    <Label Style="{StaticResource SectionTitleLabel}" Text="Goals" />
                    <Border Padding="16" BackgroundColor="{StaticResource SurfaceColor}" Stroke="{StaticResource DividerColor}">
                        <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                        <Grid ColumnDefinitions="1.2*,*,*,*,Auto" ColumnSpacing="10">
                            <Entry Placeholder="Goal name" Text="{Binding Data.NewGoalName}" />
                            <Entry Grid.Column="1" Keyboard="Numeric" Placeholder="Target" Text="{Binding Data.NewGoalTargetAmountText}" />
                            <Entry Grid.Column="2" Keyboard="Numeric" Placeholder="Current" Text="{Binding Data.NewGoalCurrentAmountText}" />
                            <DatePicker
                                Grid.Column="3"
                                Date="{Binding Data.NewGoalTargetDate}"
                                Format="{Binding Data.DatePickerFormat}" />
                            <Button Grid.Column="4" Command="{Binding Data.AddSavingsGoalCommand}" Style="{StaticResource PrimaryButton}" Text="Add" />
                        </Grid>
                    </Border>
                    <Picker ItemDisplayBinding="{Binding Name}" ItemsSource="{Binding Data.Accounts}" SelectedItem="{Binding Data.NewGoalAccount}" Title="Optional linked savings account" />
                    <CollectionView ItemsSource="{Binding Data.SavingsGoalSummaries}">
                        <CollectionView.EmptyView>
                            <Label Style="{StaticResource MutedLabel}" Text="No savings goals yet." />
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8" Padding="14" BackgroundColor="{StaticResource SurfaceColor}" Stroke="{StaticResource DividerColor}">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                                        <VerticalStackLayout Spacing="2">
                                            <Label FontAttributes="Bold" Text="{Binding Name}" />
                                            <Label Style="{StaticResource MutedLabel}" Text="{Binding AccountName}" />
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="1" HorizontalOptions="End" Spacing="2">
                                            <Label FontAttributes="Bold" HorizontalTextAlignment="End" Text="{Binding CurrentText}" />
                                            <Label Style="{StaticResource MutedLabel}" HorizontalTextAlignment="End" Text="{Binding ProgressText}" />
                                        </VerticalStackLayout>
                                        <Button Grid.Column="2" Command="{Binding BindingContext.Data.DeleteSavingsGoalCommand, Source={x:Reference Page}}" CommandParameter="{Binding Source}" Style="{StaticResource QuietButton}" Text="Delete" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <VerticalStackLayout IsVisible="{Binding IsForecastSelected}" Spacing="16">
                    <Label Style="{StaticResource SectionTitleLabel}" Text="Forecast" />
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="14">
                        <Border Padding="16" BackgroundColor="{StaticResource SurfaceColor}" Stroke="{StaticResource DividerColor}">
                            <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                            <VerticalStackLayout>
                                <Label Style="{StaticResource MutedLabel}" Text="Available to spend" />
                                <Label FontAttributes="Bold" FontSize="24" Text="{Binding Data.AvailableToSpendText}" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="1" Padding="16" BackgroundColor="{StaticResource SurfaceColor}" Stroke="{StaticResource DividerColor}">
                            <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                            <VerticalStackLayout>
                                <Label Style="{StaticResource MutedLabel}" Text="Lowest balance" />
                                <Label FontAttributes="Bold" FontSize="24" Text="{Binding Data.LowestForecastText}" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="2" Padding="16" BackgroundColor="{StaticResource SurfaceColor}" Stroke="{StaticResource DividerColor}">
                            <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                            <VerticalStackLayout>
                                <Label Style="{StaticResource MutedLabel}" Text="Period" />
                                <Label FontAttributes="Bold" FontSize="24" Text="{Binding Data.ForecastPeriodText}" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                    <CollectionView ItemsSource="{Binding Data.ForecastEvents}">
                        <CollectionView.EmptyView>
                            <Label Style="{StaticResource MutedLabel}" Text="No forecast events yet. Add scheduled items or credit card payment details." />
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8" Padding="14" BackgroundColor="{StaticResource SurfaceColor}" Stroke="{StaticResource DividerColor}">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <VerticalStackLayout>
                                            <Label FontAttributes="Bold" Text="{Binding Name}" />
                                            <Label Style="{StaticResource MutedLabel}" Text="{Binding DateText}" />
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="1" HorizontalOptions="End">
                                            <Label FontAttributes="Bold" HorizontalTextAlignment="End" Text="{Binding AmountText}" />
                                            <Label Style="{StaticResource MutedLabel}" HorizontalTextAlignment="End" Text="{Binding KindText}" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <VerticalStackLayout IsVisible="{Binding IsAnalyticsSelected}" Spacing="16">
                    <Label Style="{StaticResource SectionTitleLabel}" Text="Analytics" />
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="14">
                        <Border Padding="16" BackgroundColor="{StaticResource SurfaceColor}" Stroke="{StaticResource DividerColor}">
                            <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                            <VerticalStackLayout>
                                <Label Style="{StaticResource MutedLabel}" Text="Accounts" />
                                <Label FontAttributes="Bold" FontSize="24" Text="{Binding Data.Accounts.Count}" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="1" Padding="16" BackgroundColor="{StaticResource SurfaceColor}" Stroke="{StaticResource DividerColor}">
                            <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                            <VerticalStackLayout>
                                <Label Style="{StaticResource MutedLabel}" Text="Transactions" />
                                <Label FontAttributes="Bold" FontSize="24" Text="{Binding Data.Transactions.Count}" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="2" Padding="16" BackgroundColor="{StaticResource SurfaceColor}" Stroke="{StaticResource DividerColor}">
                            <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                            <VerticalStackLayout>
                                <Label Style="{StaticResource MutedLabel}" Text="Scheduled" />
                                <Label FontAttributes="Bold" FontSize="24" Text="{Binding Data.ScheduledTransactions.Count}" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                    <Label Style="{StaticResource MutedLabel}" Text="Richer trend and category analytics can build on these saved local transactions once category management is wired." />
                </VerticalStackLayout>

                <VerticalStackLayout IsVisible="{Binding IsPreferencesSelected}" Spacing="14">
                    <Label Style="{StaticResource SectionTitleLabel}" Text="Preferences" />
                    <Border Padding="16" BackgroundColor="{StaticResource SurfaceColor}" Stroke="{StaticResource DividerColor}">
                        <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                        <Grid ColumnDefinitions="*,180" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="4">
                                <Label FontAttributes="Bold" Text="Default currency" />
                                <Label Style="{StaticResource MutedLabel}" Text="Used for new accounts and summary displays." />
                            </VerticalStackLayout>
                            <Picker Grid.Column="1" ItemsSource="{Binding Data.SupportedCurrencies}" SelectedItem="{Binding Data.DefaultCurrency}" />
                        </Grid>
                    </Border>
                    <Border Padding="16" BackgroundColor="{StaticResource SurfaceColor}" Stroke="{StaticResource DividerColor}">
                        <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                        <Grid ColumnDefinitions="*,180" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="4">
                                <Label FontAttributes="Bold" Text="Default forecast period" />
                                <Label Style="{StaticResource MutedLabel}" Text="Controls dashboard and forecast horizon." />
                            </VerticalStackLayout>
                            <Picker
                                Grid.Column="1"
                                ItemDisplayBinding="{Binding ., Converter={StaticResource EnumDisplayConverter}}"
                                ItemsSource="{Binding Data.ForecastPeriods}"
                                SelectedItem="{Binding Data.SelectedForecastPeriod}" />
                        </Grid>
                    </Border>
                    <Border Padding="16" BackgroundColor="{StaticResource SurfaceColor}" Stroke="{StaticResource DividerColor}">
                        <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                        <Grid ColumnDefinitions="*,180" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="4">
                                <Label FontAttributes="Bold" Text="Check-in reminder" />
                                <Label Style="{StaticResource MutedLabel}" Text="Stored now; notification scheduling comes in hardening." />
                            </VerticalStackLayout>
                            <Picker
                                Grid.Column="1"
                                ItemDisplayBinding="{Binding ., Converter={StaticResource EnumDisplayConverter}}"
                                ItemsSource="{Binding Data.ReminderFrequencies}"
                                SelectedItem="{Binding Data.SelectedReminderFrequency}" />
                        </Grid>
                    </Border>
                    <Border Padding="16" BackgroundColor="{StaticResource SurfaceColor}" Stroke="{StaticResource DividerColor}">
                        <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                        <Grid ColumnDefinitions="*,180" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="4">
                                <Label FontAttributes="Bold" Text="Date format" />
                                <Label Style="{StaticResource MutedLabel}" Text="Used throughout transactions, forecasts, goals, and payoff dates." />
                            </VerticalStackLayout>
                            <Picker
                                Grid.Column="1"
                                ItemDisplayBinding="{Binding ., Converter={StaticResource EnumDisplayConverter}}"
                                ItemsSource="{Binding Data.DateDisplayFormats}"
                                SelectedItem="{Binding Data.SelectedDateDisplayFormat}" />
                        </Grid>
                    </Border>
                    <Border Padding="16" BackgroundColor="{StaticResource SurfaceColor}" Stroke="{StaticResource DividerColor}">
                        <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="4">
                                <Label FontAttributes="Bold" Text="Power-user features" />
                                <Label Style="{StaticResource MutedLabel}" Text="Show advanced controls such as technical recurrence syntax." />
                            </VerticalStackLayout>
                            <CheckBox Grid.Column="1" IsChecked="{Binding ShowPowerUserFeatures}" VerticalOptions="Center" />
                        </Grid>
                    </Border>
                    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="10">
                        <Button Command="{Binding Data.SavePreferencesCommand}" Style="{StaticResource PrimaryButton}" Text="Save preferences" />
                        <Button Grid.Column="1" Command="{Binding UseRailNavigationCommand}" Style="{StaticResource QuietButton}" Text="Use rail" />
                        <Button Grid.Column="2" Command="{Binding UseCompactNavigationCommand}" Style="{StaticResource QuietButton}" Text="Compact rail" />
                        <Button Grid.Column="3" Command="{Binding UseTopTabsCommand}" Style="{StaticResource QuietButton}" Text="Use tabs" />
                    </Grid>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
