                                            Style="{StaticResource QuietButton}"
                                            Text="Delete" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <VerticalStackLayout IsVisible="{Binding IsForecastSelected}" Spacing="16">
                    <Label Style="{StaticResource SectionTitleLabel}" Text="Forecast" />
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="14">
                        <Border Padding="16" BackgroundColor="{DynamicResource SurfaceColor}" Stroke="{DynamicResource DividerColor}">
                            <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                            <VerticalStackLayout>
                                <Label Style="{StaticResource MutedLabel}" Text="Available to spend" />
                                <Label FontAttributes="Bold" FontSize="24" Text="{Binding Data.AvailableToSpendText}" />
