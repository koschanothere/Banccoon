<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Banccoon.App.Views.MainPage"
    x:Name="Page"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Banccoon.App.Controls"
    xmlns:viewModels="clr-namespace:Banccoon.App.ViewModels"
    BackgroundColor="{DynamicResource PageBackgroundColor}"
    Title="Banccoon">
    <Grid RowDefinitions="Auto,*">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding NavigationColumnWidth}" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border
            Grid.RowSpan="2"
            BackgroundColor="{DynamicResource ShellBackgroundColor}"
            IsVisible="{Binding IsRailMode}"
            StrokeThickness="0">
            <Grid Padding="12,14" RowDefinitions="Auto,*,Auto">
                <Grid ColumnDefinitions="36,*,38" ColumnSpacing="9">
                    <Border
                        BackgroundColor="{DynamicResource AccentColor}"
                        HeightRequest="34"
                        StrokeThickness="0"
                        WidthRequest="34">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <Image
                            Aspect="AspectFit"
                            Margin="5"
                            Source="banccoon_mark_placeholder.svg" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="0">
                        <Label
                            FontAttributes="Bold"
                            FontSize="16"
                            Text="Banccoon"
                            TextColor="{DynamicResource ShellTextColor}" />
                        <Label
                            FontSize="11"
                            Text="Private forecast"
                            TextColor="#B8C7BD" />
                    </VerticalStackLayout>
                    <Border
                        Grid.Column="2"
                        BackgroundColor="{DynamicResource ShellPanelColor}"
                        HeightRequest="34"
                        HorizontalOptions="End"
                        StrokeThickness="0"
                        VerticalOptions="Center"
                        WidthRequest="34">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleNavigationCommand}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout
                            HorizontalOptions="Center"
                            Spacing="4"
                            VerticalOptions="Center">
                            <BoxView
                                Color="{DynamicResource ShellTextColor}"
                                HeightRequest="2"
                                WidthRequest="16" />
                            <BoxView
                                Color="{DynamicResource ShellTextColor}"
                                HeightRequest="2"
                                WidthRequest="16" />
                            <BoxView
                                Color="{DynamicResource ShellTextColor}"
                                HeightRequest="2"
                                WidthRequest="16" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <VerticalStackLayout Grid.Row="1" Margin="0,16,0,0" Spacing="4">
                    <Button
                        Command="{Binding SelectSectionCommand}"
                        CommandParameter="{x:Static viewModels:AppSection.Dashboard}"
                        Style="{StaticResource ShellButton}"
                        Text="Dashboard" />
                    <Button
                        Command="{Binding SelectSectionCommand}"
                        CommandParameter="{x:Static viewModels:AppSection.Transactions}"
                        Style="{StaticResource ShellButton}"
                        Text="Transactions" />
                    <Button
                        Command="{Binding SelectSectionCommand}"
                        CommandParameter="{x:Static viewModels:AppSection.Accounts}"
                        Style="{StaticResource ShellButton}"
                        Text="Accounts" />
                    <Button
                        Command="{Binding SelectSectionCommand}"
                        CommandParameter="{x:Static viewModels:AppSection.Settings}"
                        Style="{StaticResource ShellButton}"
                        Text="Settings" />
                </VerticalStackLayout>

                <Border
                    Grid.Row="2"
                    Padding="12"
                    BackgroundColor="{DynamicResource ShellPanelColor}"
                    StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="4">
                        <Label
                            FontAttributes="Bold"
                            FontSize="12"
                            Text="Logo folder"
                            TextColor="{DynamicResource ShellTextColor}" />
                        <Label
                            FontSize="11"
                            Text="Resources/Images/banccoon"
                            TextColor="#B8C7BD" />
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </Border>

        <Border
            Grid.Column="1"
            BackgroundColor="{DynamicResource SurfaceColor}"
            Stroke="{DynamicResource DividerColor}"
            StrokeThickness="0">
            <Grid Padding="22,14" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" RowDefinitions="Auto,Auto">
                <Border
                    BackgroundColor="{DynamicResource SurfaceMutedColor}"
                    HeightRequest="38"
                    IsVisible="{Binding IsMenuButtonVisible}"
                    StrokeThickness="0"
                    VerticalOptions="Center"
                    WidthRequest="38">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleNavigationCommand}" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout
                        HorizontalOptions="Center"
                        Spacing="4"
                        VerticalOptions="Center">
                        <BoxView
                            Color="{DynamicResource PrimaryTextColor}"
                            HeightRequest="2"
                            WidthRequest="18" />
                        <BoxView
                            Color="{DynamicResource PrimaryTextColor}"
                            HeightRequest="2"
                            WidthRequest="18" />
                        <BoxView
                            Color="{DynamicResource PrimaryTextColor}"
                            HeightRequest="2"
                            WidthRequest="18" />
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout Grid.Column="1" Spacing="2">
                    <Label
                        FontAttributes="Bold"
                        FontSize="22"
                        Text="{Binding SelectedTitle}" />
                    <Label
                        Style="{StaticResource MutedLabel}"
                        Text="{Binding SelectedDescription}" />
                </VerticalStackLayout>

                <HorizontalStackLayout
                    Grid.Column="2"
                    Spacing="8"
                    VerticalOptions="Center">
                    <Button
                        Command="{Binding Data.RefreshCommand}"
                        Style="{StaticResource QuietButton}"
                        Text="Refresh" />
                </HorizontalStackLayout>

                <ScrollView
                    Grid.Row="1"
                    Grid.ColumnSpan="3"
                    Margin="0,14,0,0"
                    IsVisible="{Binding IsTopTabsMode}"
                    Orientation="Horizontal">
                    <HorizontalStackLayout Spacing="8">
                        <Button Command="{Binding SelectSectionCommand}" CommandParameter="{x:Static viewModels:AppSection.Dashboard}" Style="{StaticResource QuietButton}" Text="Dashboard" />
                        <Button Command="{Binding SelectSectionCommand}" CommandParameter="{x:Static viewModels:AppSection.Transactions}" Style="{StaticResource QuietButton}" Text="Transactions" />
                        <Button Command="{Binding SelectSectionCommand}" CommandParameter="{x:Static viewModels:AppSection.Accounts}" Style="{StaticResource QuietButton}" Text="Accounts" />
                        <Button Command="{Binding SelectSectionCommand}" CommandParameter="{x:Static viewModels:AppSection.Settings}" Style="{StaticResource QuietButton}" Text="Settings" />
                    </HorizontalStackLayout>
                </ScrollView>
            </Grid>
        </Border>

        <ScrollView Grid.Row="1" Grid.Column="1">
            <VerticalStackLayout Padding="28" Spacing="18">
                <Border
                    Padding="12,10"
                    BackgroundColor="{DynamicResource AccentSoftColor}"
                    IsVisible="{Binding Data.HasStatusMessage}"
                    StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>
                    <Label
                        FontSize="13"
                        Text="{Binding Data.StatusMessage}"
                        TextColor="{DynamicResource PrimaryTextColor}" />
                </Border>

                <VerticalStackLayout
                    IsVisible="{Binding IsDashboardSelected}"
                    Spacing="18">
                    <Grid ColumnDefinitions="2*,*" ColumnSpacing="18">
                        <Border
                            Padding="22"
                            BackgroundColor="{DynamicResource SurfaceColor}"
                            Stroke="{DynamicResource DividerColor}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="14">
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="30"
                                    Text="{Binding Data.DashboardAvailableToSpendText, StringFormat='You can safely spend {0}.'}" />
                                <Label
                                    Style="{StaticResource MutedLabel}"
                                    Text="{Binding Data.DashboardIncludedAccountsText}" />
                                <HorizontalStackLayout Spacing="10">
                                    <Button
                                        Command="{Binding SelectSectionCommand}"
                                        CommandParameter="{x:Static viewModels:AppSection.Accounts}"
                                        Style="{StaticResource PrimaryButton}"
                                        Text="Add account" />
                                    <Button
                                        Command="{Binding ToggleDashboardReconciliationCommand}"
                                        Style="{StaticResource QuietButton}"
                                        Text="Check in" />
                                    <Button
                                        Command="{Binding SelectSectionCommand}"
                                        CommandParameter="{x:Static viewModels:AppSection.Transactions}"
                                        Style="{StaticResource QuietButton}"
                                        Text="Add scheduled item" />
                                    <Button
                                        Command="{Binding SelectSectionCommand}"
                                        CommandParameter="{x:Static viewModels:AppSection.Accounts}"
                                        Style="{StaticResource QuietButton}"
                                        Text="Add goal" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Border>

                        <Border
                            Grid.Column="1"
                            Padding="18"
                            BackgroundColor="{DynamicResource SurfaceColor}"
                            Stroke="{DynamicResource DividerColor}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="8">
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="16"
                                    Text="Next obligations" />
                                <CollectionView
                                    HeightRequest="156"
                                    ItemsSource="{Binding Data.UpcomingObligations}">
                                    <CollectionView.EmptyView>
                                        <Label Style="{StaticResource MutedLabel}" Text="No obligations in this forecast period." />
                                    </CollectionView.EmptyView>
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Padding="0,4" ColumnDefinitions="*,Auto">
                                                <VerticalStackLayout Spacing="1">
                                                    <Label FontAttributes="Bold" FontSize="13" Text="{Binding Name}" />
                                                    <Label FontSize="11" Style="{StaticResource MutedLabel}" Text="{Binding DateText}" />
                                                </VerticalStackLayout>
                                                <Label Grid.Column="1" FontAttributes="Bold" Text="{Binding AmountText}" />
                                            </Grid>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="14">
                        <Border Padding="16" BackgroundColor="{DynamicResource SurfaceColor}" Stroke="{DynamicResource DividerColor}">
                            <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                            <VerticalStackLayout>
                                <Label Style="{StaticResource MutedLabel}" Text="Current balance" />
                                <Label FontAttributes="Bold" FontSize="24" Text="{Binding Data.DashboardCurrentBalanceText}" />
                            </VerticalStackLayout>
                        </Border>
                        <Border
                            Grid.Column="1"
                            Padding="16"
                            BackgroundColor="{DynamicResource SurfaceColor}"
                            Stroke="{DynamicResource DividerColor}">
                            <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                            <VerticalStackLayout>
                                <Label Style="{StaticResource MutedLabel}" Text="Upcoming obligations" />
                                <Label FontAttributes="Bold" FontSize="24" Text="{Binding Data.DashboardUpcomingObligationsText}" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="2" Padding="16" BackgroundColor="{DynamicResource SurfaceColor}" Stroke="{DynamicResource DividerColor}">
                            <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                            <VerticalStackLayout>
                                <Label Style="{StaticResource MutedLabel}" Text="Lowest forecast" />
                                <Label FontAttributes="Bold" FontSize="24" Text="{Binding Data.DashboardLowestForecastText}" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="3" Padding="16" BackgroundColor="{DynamicResource SurfaceColor}" Stroke="{DynamicResource DividerColor}">
                            <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                            <VerticalStackLayout>
                                <Label Style="{StaticResource MutedLabel}" Text="Forecast period" />
                                <Label FontAttributes="Bold" FontSize="24" Text="{Binding Data.ForecastPeriodText}" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <Border Padding="16" BackgroundColor="{DynamicResource SurfaceColor}" Stroke="{DynamicResource DividerColor}">
                        <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                        <VerticalStackLayout Spacing="10">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <VerticalStackLayout Spacing="2">
                                    <Label FontAttributes="Bold" Text="Dashboard balance trend" />
                                    <Label Style="{StaticResource MutedLabel}" Text="Past 7 days of account changes and upcoming projected balances." />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" HorizontalOptions="End" Spacing="6">
                                    <Label FontAttributes="Bold" HorizontalTextAlignment="End" Text="{Binding Data.SelectedDashboardForecastPoint.BalanceText}" />
                                    <Label Style="{StaticResource MutedLabel}" HorizontalTextAlignment="End" Text="{Binding Data.SelectedDashboardForecastPoint.DateText}" />
                                    <HorizontalStackLayout HorizontalOptions="End" Spacing="6">
                                        <Button
                                            Command="{Binding ToggleDashboardForecastCommand}"
                                            Style="{StaticResource QuietButton}"
                                            Text="Forecast" />
                                        <Button
                                            Command="{Binding ToggleDashboardAnalyticsCommand}"
                                            Style="{StaticResource QuietButton}"
                                            Text="Analytics" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </Grid>
                            <controls:ForecastChartView
                                HeightRequest="250"
                                Points="{Binding Data.DashboardForecastPoints}"
                                SelectedPoint="{Binding Data.SelectedDashboardForecastPoint, Mode=TwoWay}" />
                            <Label Style="{StaticResource MutedLabel}" Text="{Binding Data.SelectedDashboardForecastPoint.EventsText}" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout IsVisible="{Binding IsAccountsSelected}" Spacing="16">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                        <Label Style="{StaticResource SectionTitleLabel}" Text="Accounts" />
                        <Button
                            Grid.Column="1"
                            Command="{Binding Data.ToggleAccountNumberRevealCommand}"
                            Style="{StaticResource QuietButton}"
                            Text="{Binding Data.AccountNumberRevealText}" />
                        <Button
                            Grid.Column="2"
                            Command="{Binding Data.ToggleAccountsEditingCommand}"
                            Style="{StaticResource QuietButton}"
                            Text="{Binding Data.AccountsEditModeText}" />
                    </Grid>
                    <Border Padding="16" BackgroundColor="{DynamicResource SurfaceColor}" Stroke="{DynamicResource DividerColor}">
                        <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                        <VerticalStackLayout Spacing="10">
                            <Label FontAttributes="Bold" Text="New account" />
                            <Entry Placeholder="Name" Text="{Binding Data.NewAccountName}" />
                            <Picker
                                ItemDisplayBinding="{Binding ., Converter={StaticResource EnumDisplayConverter}}"
                                ItemsSource="{Binding Data.AccountTypes}"
                                SelectedItem="{Binding Data.SelectedAccountType}" />
                            <Entry
                                IsVisible="{Binding Data.IsNewAccountPlanningValueVisible}"
                                Keyboard="Numeric"
                                Placeholder="{Binding Data.NewAccountPlanningValueLabel}"
                                Text="{Binding Data.NewAccountPlanningValueText}" />
                            <Grid ColumnDefinitions="*,140" ColumnSpacing="10">
                                <Entry Keyboard="Numeric" Placeholder="Balance" Text="{Binding Data.NewAccountBalanceText}" />
                                <Picker Grid.Column="1" ItemsSource="{Binding Data.SupportedCurrencies}" SelectedItem="{Binding Data.NewAccountCurrency}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,180" ColumnSpacing="10">
                                <Entry Placeholder="Account number, optional" Text="{Binding Data.NewAccountNumber}" />
                                <Entry
                                    Grid.Column="1"
                                    IsVisible="{Binding Data.IsNewAccountCard}"
                                    Keyboard="Numeric"
                                    MaxLength="4"
                                    Placeholder="Card last 4"
                                    Text="{Binding Data.NewCardLastFourDigits}" />
                            </Grid>
                            <HorizontalStackLayout Spacing="8">
                                <CheckBox IsChecked="{Binding Data.NewAccountIncludeInDashboardTotals}" />
                                <Label Style="{StaticResource MutedLabel}" Text="Include this account in dashboard totals" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <VerticalStackLayout IsVisible="{Binding Data.IsNewAccountCreditCard}" Spacing="8">
                                <Label FontAttributes="Bold" FontSize="13" Text="Credit card details" />
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <Entry Keyboard="Numeric" Placeholder="Current debt" Text="{Binding Data.NewCreditCardDebtText}" />
                                    <Entry Grid.Column="1" Keyboard="Numeric" Placeholder="Due day, 1-31" Text="{Binding Data.NewCreditCardPaymentDueDayText}" />
                                </Grid>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <Entry Keyboard="Numeric" Placeholder="Minimum payment" Text="{Binding Data.NewCreditCardMinimumPaymentText}" />
                                    <Entry Grid.Column="1" Keyboard="Numeric" Placeholder="Planned payment" Text="{Binding Data.NewCreditCardPlannedPaymentText}" />
                                </Grid>
                            </VerticalStackLayout>
                            <Button Command="{Binding Data.AddAccountCommand}" Style="{StaticResource PrimaryButton}" Text="Save account" />
                        </VerticalStackLayout>
                    </Border>

                    <CollectionView ItemsSource="{Binding Data.AccountSummaries}">
                        <CollectionView.EmptyView>
                            <Label Style="{StaticResource MutedLabel}" Text="No accounts yet." />
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8" Padding="14" BackgroundColor="{DynamicResource SurfaceColor}" Stroke="{DynamicResource DividerColor}">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                                        <VerticalStackLayout IsVisible="{Binding IsReadOnlyVisible}" Spacing="2">
                                            <Label FontAttributes="Bold" Text="{Binding Name}" />
                                            <Label Style="{StaticResource MutedLabel}" Text="{Binding CreditText}" />
                                            <Label Style="{StaticResource MutedLabel}" Text="{Binding IdentifierText}" />
                                            <Label Style="{StaticResource MutedLabel}" Text="{Binding DashboardText}" />
                                        </VerticalStackLayout>
                                        <VerticalStackLayout IsVisible="{Binding IsEditFormVisible}" Spacing="10">
                                            <Entry Placeholder="Account name" Text="{Binding BindingContext.Data.SelectedAccountName, Source={x:Reference Page}}" />
                                            <Grid ColumnDefinitions="*,140" ColumnSpacing="10">
                                                <Picker
                                                    ItemDisplayBinding="{Binding ., Converter={StaticResource EnumDisplayConverter}}"
                                                    ItemsSource="{Binding BindingContext.Data.AccountTypes, Source={x:Reference Page}}"
                                                    SelectedItem="{Binding BindingContext.Data.SelectedAccountEditType, Source={x:Reference Page}}" />
                                                <Picker
                                                    Grid.Column="1"
                                                    ItemsSource="{Binding BindingContext.Data.SupportedCurrencies, Source={x:Reference Page}}"
                                                    SelectedItem="{Binding BindingContext.Data.SelectedAccountCurrency, Source={x:Reference Page}}" />
                                            </Grid>
                                            <Entry
                                                IsVisible="{Binding BindingContext.Data.IsSelectedAccountPlanningValueVisible, Source={x:Reference Page}}"
                                                Keyboard="Numeric"
                                                Placeholder="{Binding BindingContext.Data.SelectedAccountPlanningValueLabel, Source={x:Reference Page}}"
                                                Text="{Binding BindingContext.Data.SelectedAccountPlanningValueText, Source={x:Reference Page}}" />
                                            <Label Style="{StaticResource MutedLabel}" Text="{Binding BindingContext.Data.SelectedAccountBalanceText, Source={x:Reference Page}, StringFormat='Balance from transactions: {0}'}" />
                                            <Grid ColumnDefinitions="*,180" ColumnSpacing="10">
                                                <Entry Placeholder="Account number, optional" Text="{Binding BindingContext.Data.SelectedAccountNumber, Source={x:Reference Page}}" />
                                                <Entry
                                                    Grid.Column="1"
                                                    IsVisible="{Binding BindingContext.Data.IsSelectedAccountEditCard, Source={x:Reference Page}}"
                                                    Keyboard="Numeric"
                                                    MaxLength="4"
                                                    Placeholder="Card last 4"
                                                    Text="{Binding BindingContext.Data.SelectedCardLastFourDigits, Source={x:Reference Page}}" />
                                            </Grid>
                                            <HorizontalStackLayout Spacing="8">
                                                <CheckBox IsChecked="{Binding BindingContext.Data.SelectedAccountIncludeInDashboardTotals, Source={x:Reference Page}}" />
                                                <Label Style="{StaticResource MutedLabel}" Text="Include this account in dashboard totals" VerticalOptions="Center" />
                                            </HorizontalStackLayout>
                                            <VerticalStackLayout IsVisible="{Binding BindingContext.Data.IsSelectedAccountEditCreditCard, Source={x:Reference Page}}" Spacing="8">
                                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                                    <Entry Keyboard="Numeric" Placeholder="Current debt" Text="{Binding BindingContext.Data.SelectedAccountDebtText, Source={x:Reference Page}}" />
                                                    <Entry Grid.Column="1" Keyboard="Numeric" Placeholder="Due day, 1-31" Text="{Binding BindingContext.Data.SelectedAccountPaymentDueDayText, Source={x:Reference Page}}" />
                                                </Grid>
                                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                                    <Entry Keyboard="Numeric" Placeholder="Minimum payment" Text="{Binding BindingContext.Data.SelectedAccountMinimumPaymentText, Source={x:Reference Page}}" />
                                                    <Entry Grid.Column="1" Keyboard="Numeric" Placeholder="Planned payment" Text="{Binding BindingContext.Data.SelectedAccountPlannedPaymentText, Source={x:Reference Page}}" />
                                                </Grid>
                                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                                    <Entry Keyboard="Numeric" Placeholder="Payoff calculator payment" Text="{Binding BindingContext.Data.SelectedAccountPayoffPaymentText, Source={x:Reference Page}}" />
                                                    <Entry Grid.Column="1" Keyboard="Numeric" Placeholder="Manual monthly finance charge" Text="{Binding BindingContext.Data.SelectedAccountManualFinanceChargeText, Source={x:Reference Page}}" />
                                                </Grid>
                                                <Label Style="{StaticResource MutedLabel}" Text="{Binding BindingContext.Data.SelectedAccountPayoffSummary, Source={x:Reference Page}}" />
                                            </VerticalStackLayout>
                                            <Button Command="{Binding BindingContext.Data.SaveSelectedAccountCommand, Source={x:Reference Page}}" Style="{StaticResource PrimaryButton}" Text="Save account" />
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="1" HorizontalOptions="End" Spacing="2">
                                            <Label FontAttributes="Bold" HorizontalTextAlignment="End" Text="{Binding BalanceText}" />
                                            <Label Style="{StaticResource MutedLabel}" HorizontalTextAlignment="End" Text="{Binding TypeText}" />
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="2" IsVisible="{Binding CanShowAccountActions}" Spacing="6">
                                            <Button
                                                Command="{Binding BindingContext.Data.SelectAccountCommand, Source={x:Reference Page}}"
                                                CommandParameter="{Binding .}"
                                                Style="{StaticResource QuietButton}"
                                                Text="Edit" />
                                            <Button
                                                Command="{Binding BindingContext.Data.DeleteAccountCommand, Source={x:Reference Page}}"
                                                CommandParameter="{Binding Source}"
                                                Style="{StaticResource QuietButton}"
                                                Text="Delete" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <VerticalStackLayout IsVisible="{Binding IsTransactionsSelected}" Spacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Style="{StaticResource SectionTitleLabel}" Text="Transactions" />
                        <Button
                            Grid.Column="1"
                            Command="{Binding Data.ToggleTransactionsEditingCommand}"
                            Style="{StaticResource QuietButton}"
                            Text="{Binding Data.TransactionsEditModeText}" />
                    </Grid>
                    <HorizontalStackLayout Spacing="8">
                        <Button
                            Command="{Binding ToggleTransactionAddOptionsCommand}"
                            Style="{StaticResource QuietButton}"
                            Text="+" />
                        <Button
                            Command="{Binding OpenExpenseTransactionWorkflowCommand}"
                            IsVisible="{Binding IsTransactionAddOptionsExpanded}"
                            Style="{StaticResource QuietButton}"
                            Text="Expense" />
                        <Button
                            Command="{Binding OpenIncomeTransactionWorkflowCommand}"
                            IsVisible="{Binding IsTransactionAddOptionsExpanded}"
                            Style="{StaticResource QuietButton}"
                            Text="Income" />
                        <Button
                            Command="{Binding OpenTransferTransactionWorkflowCommand}"
                            IsVisible="{Binding IsTransactionAddOptionsExpanded}"
                            Style="{StaticResource QuietButton}"
                            Text="Transfer" />
                        <Button
                            Command="{Binding OpenScheduledWorkflowCommand}"
                            Style="{StaticResource QuietButton}"
                            Text="Scheduled" />
                        <Button
                            Command="{Binding OpenStatementImportWorkflowCommand}"
                            Style="{StaticResource QuietButton}"
                            Text="Statement import" />
                    </HorizontalStackLayout>
                    <Border
                        Padding="16"
                        BackgroundColor="{DynamicResource SurfaceColor}"
                        IsVisible="{Binding Data.IsTransactionsEditing}"
                        Stroke="{DynamicResource DividerColor}">
                        <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                        <VerticalStackLayout Spacing="10">
                            <Label FontAttributes="Bold" Text="Bulk edit selected transactions" />
                            <Grid ColumnDefinitions="*,Auto,*,160,Auto,Auto" ColumnSpacing="8">
                                <Picker
                                    ItemDisplayBinding="{Binding Name}"
                                    ItemsSource="{Binding Data.Categories}"
                                    SelectedItem="{Binding Data.BulkTransactionCategory}"
                                    Title="Category" />
                                <Button
                                    Grid.Column="1"
                                    Command="{Binding Data.BulkAssignTransactionCategoryCommand}"
                                    Style="{StaticResource QuietButton}"
                                    Text="Apply category" />
                                <Picker
                                    Grid.Column="2"
                                    ItemDisplayBinding="{Binding Name}"
                                    ItemsSource="{Binding Data.ScheduledTransactionSummaries}"
                                    SelectedItem="{Binding Data.BulkTransactionScheduledOccurrence}"
                                    Title="Scheduled item" />
                                <DatePicker
                                    Grid.Column="3"
                                    Date="{Binding Data.BulkTransactionScheduledOccurrenceDate}"
                                    Format="{Binding Data.DatePickerFormat}" />
                                <Button
                                    Grid.Column="4"
                                    Command="{Binding Data.BulkAssignScheduledOccurrenceCommand}"
                                    Style="{StaticResource QuietButton}"
                                    Text="Apply scheduled" />
                                <Button
                                    Grid.Column="5"
                                    Command="{Binding Data.BulkDeleteTransactionsCommand}"
                                    Style="{StaticResource QuietButton}"
                                    Text="Delete selected" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                    <CollectionView ItemsSource="{Binding Data.TransactionSummaries}">
                        <CollectionView.EmptyView>
                            <Label Style="{StaticResource MutedLabel}" Text="No transactions yet." />
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8" Padding="14" BackgroundColor="{DynamicResource SurfaceColor}" Stroke="{DynamicResource DividerColor}">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                                    <Grid ColumnDefinitions="Auto,Auto,*,160,Auto" ColumnSpacing="10">
                                        <CheckBox
                                            IsChecked="{Binding IsSelected}"
                                            IsVisible="{Binding BindingContext.Data.IsTransactionsEditing, Source={x:Reference Page}}"
                                            VerticalOptions="Start" />
                                        <Button
                                            Grid.Column="1"
                                            Command="{Binding ToggleDetailsCommand}"
                                            IsVisible="{Binding HasDetails}"
                                            Style="{StaticResource QuietButton}"
                                            Text="{Binding DetailsToggleText}" />
                                        <VerticalStackLayout Grid.Column="2" Spacing="2">
                                            <Label FontAttributes="Bold" Text="{Binding Name}" />
                                            <Label Style="{StaticResource MutedLabel}" Text="{Binding AccountName}" />
                                            <Label Style="{StaticResource MutedLabel}" Text="{Binding CategoryText}" />
