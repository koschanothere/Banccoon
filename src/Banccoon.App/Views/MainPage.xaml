                            <Label Style="{StaticResource MutedLabel}" Text="No statement rows yet. Import a supported statement to review rows." />
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,6" Padding="10" BackgroundColor="{DynamicResource SurfaceColor}" Stroke="{DynamicResource DividerColor}">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                                    <Grid ColumnDefinitions="92,2*,110,170,Auto,Auto" ColumnSpacing="10">
                                        <Label Style="{StaticResource MutedLabel}" Text="{Binding DateText}" VerticalTextAlignment="Center" />
                                        <VerticalStackLayout Grid.Column="1" Spacing="1">
                                            <Label FontAttributes="Bold" LineBreakMode="TailTruncation" Text="{Binding Description}" />
                                            <Label Style="{StaticResource MutedLabel}" Text="{Binding TypeText}" />
                                            <Label Style="{StaticResource MutedLabel}" Text="{Binding DuplicateText}" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="2" FontAttributes="Bold" HorizontalTextAlignment="End" Text="{Binding AmountText}" VerticalTextAlignment="Center" />
                                        <Picker
                                            Grid.Column="3"
                                            IsEnabled="{Binding IsPending}"
                                            ItemDisplayBinding="{Binding Name}"
                                            ItemsSource="{Binding CategoryChoices}"
                                            SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                                            Title="Category" />
