                    </Border>
                    <Border Padding="16" BackgroundColor="{DynamicResource SurfaceColor}" Stroke="{DynamicResource DividerColor}">
                        <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                        <Grid ColumnDefinitions="*,180" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="4">
                                <Label FontAttributes="Bold" Text="Default currency" />
                                <Label Style="{StaticResource MutedLabel}" Text="Used for new accounts and summary displays." />
                            </VerticalStackLayout>
                            <Picker Grid.Column="1" ItemsSource="{Binding Data.SupportedCurrencies}" SelectedItem="{Binding Data.DefaultCurrency}" />
                        </Grid>
                    </Border>
                    <Border Padding="16" BackgroundColor="{DynamicResource SurfaceColor}" Stroke="{DynamicResource DividerColor}">
                        <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                        <Grid ColumnDefinitions="*,180" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="4">
                                <Label FontAttributes="Bold" Text="Default forecast period" />
                                <Label Style="{StaticResource MutedLabel}" Text="Controls dashboard and forecast horizon." />
                            </VerticalStackLayout>
                            <Picker
                                Grid.Column="1"
                                ItemDisplayBinding="{Binding ., Converter={StaticResource EnumDisplayConverter}}"
                                ItemsSource="{Binding Data.ForecastPeriods}"
                                SelectedItem="{Binding Data.SelectedForecastPeriod}" />
                        </Grid>
                    </Border>
                    <Border Padding="16" BackgroundColor="{DynamicResource SurfaceColor}" Stroke="{DynamicResource DividerColor}">
                        <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                        <Grid ColumnDefinitions="*,180" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="4">
                                <Label FontAttributes="Bold" Text="Check-in reminder" />
                                <Label Style="{StaticResource MutedLabel}" Text="Stored now; notification scheduling comes in hardening." />
                            </VerticalStackLayout>
                            <Picker
                                Grid.Column="1"
                                ItemDisplayBinding="{Binding ., Converter={StaticResource EnumDisplayConverter}}"
                                ItemsSource="{Binding Data.ReminderFrequencies}"
                                SelectedItem="{Binding Data.SelectedReminderFrequency}" />
                        </Grid>
                    </Border>
                    <Border Padding="16" BackgroundColor="{DynamicResource SurfaceColor}" Stroke="{DynamicResource DividerColor}">
                        <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                        <Grid ColumnDefinitions="*,180" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="4">
                                <Label FontAttributes="Bold" Text="Date format" />
                                <Label Style="{StaticResource MutedLabel}" Text="Used throughout transactions, forecasts, goals, and payoff dates." />
                            </VerticalStackLayout>
                            <Picker
                                Grid.Column="1"
                                ItemDisplayBinding="{Binding ., Converter={StaticResource EnumDisplayConverter}}"
                                ItemsSource="{Binding Data.DateDisplayFormats}"
                                SelectedItem="{Binding Data.SelectedDateDisplayFormat}" />
                        </Grid>
                    </Border>
                    <Border Padding="16" BackgroundColor="{DynamicResource SurfaceColor}" Stroke="{DynamicResource DividerColor}">
                        <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="4">
                                <Label FontAttributes="Bold" Text="Power-user features" />
                                <Label Style="{StaticResource MutedLabel}" Text="Show advanced controls such as technical recurrence syntax." />
                            </VerticalStackLayout>
                            <CheckBox Grid.Column="1" IsChecked="{Binding ShowPowerUserFeatures}" VerticalOptions="Center" />
                        </Grid>
                    </Border>
                    <Button Command="{Binding SaveSettingsCommand}" Style="{StaticResource PrimaryButton}" Text="Save settings" />
                </VerticalStackLayout>

                <VerticalStackLayout IsVisible="{Binding IsDataSelected}" Spacing="16">
                    <Label Style="{StaticResource SectionTitleLabel}" Text="Backup and local data" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                        <Border Padding="16" BackgroundColor="{DynamicResource SurfaceColor}" Stroke="{DynamicResource DividerColor}">
                            <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                            <VerticalStackLayout Spacing="10">
                                <Label FontAttributes="Bold" Text="Export backup" />
                                <Label Style="{StaticResource MutedLabel}" Text="Creates a human-readable JSON file containing accounts, transactions, scheduled items, categories, goals, and settings." />
                                <Entry Text="{Binding Data.ExportPathText}" />
                                <HorizontalStackLayout Spacing="8">
                                    <Button Command="{Binding Data.CreateBackupCommand}" Style="{StaticResource PrimaryButton}" Text="Create backup" />
                                    <Button Command="{Binding Data.ResetExportPathCommand}" Style="{StaticResource QuietButton}" Text="New path" />
                                    <Button Command="{Binding Data.CopyExportPathToImportCommand}" Style="{StaticResource QuietButton}" Text="Use for import" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Column="1" Padding="16" BackgroundColor="{DynamicResource SurfaceColor}" Stroke="{DynamicResource DividerColor}">
                            <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                            <VerticalStackLayout Spacing="10">
                                <Label FontAttributes="Bold" Text="Import or restore" />
                                <Label Style="{StaticResource MutedLabel}" Text="Validate first when you are not sure. Merge preserves local data; replace clears local data before restore." />
                                <Entry Placeholder="Path to Banccoon JSON backup" Text="{Binding Data.ImportPathText}" />
                                <Picker
                                    ItemDisplayBinding="{Binding ., Converter={StaticResource EnumDisplayConverter}}"
                                    ItemsSource="{Binding Data.ImportModes}"
                                    SelectedItem="{Binding Data.SelectedImportMode}" />
                                <HorizontalStackLayout Spacing="8">
                                    <Button Command="{Binding Data.ValidateImportCommand}" Style="{StaticResource QuietButton}" Text="Validate" />
                                    <Button Command="{Binding Data.RestoreBackupCommand}" Style="{StaticResource PrimaryButton}" Text="Run import" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                    <Border Padding="16" BackgroundColor="{DynamicResource SurfaceColor}" Stroke="{DynamicResource DividerColor}">
                        <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                        <VerticalStackLayout Spacing="8">
                            <Label FontAttributes="Bold" Text="Import/export status" />
                            <Label Style="{StaticResource MutedLabel}" Text="{Binding Data.ImportExportSummary}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Padding="16" BackgroundColor="#F7E8E8" Stroke="#E1B5B5">
                        <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                        <VerticalStackLayout Spacing="10">
                            <Label FontAttributes="Bold" Text="Delete all local data" />
                            <Label Style="{StaticResource MutedLabel}" Text="For testing and full data ownership. Create an export first unless you truly want to start over." />
                            <CheckBox IsChecked="{Binding Data.DeleteAllBackupAcknowledged}" />
                            <Label Style="{StaticResource MutedLabel}" Text="I have exported a backup or intentionally do not want one." />
                            <Entry Placeholder="Type DELETE ALL DATA" Text="{Binding Data.DeleteAllConfirmationText}" />
                            <Button Command="{Binding Data.DeleteAllDataCommand}" Style="{StaticResource QuietButton}" Text="Delete all local data" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <Grid
            Grid.RowSpan="2"
            Grid.ColumnSpan="2"
            BackgroundColor="#80000000"
            IsVisible="{Binding WorkflowOverlay.IsOpen}">
            <Border
                Padding="24"
                BackgroundColor="{DynamicResource SurfaceColor}"
                HorizontalOptions="Center"
                MaximumWidthRequest="620"
                Stroke="{DynamicResource DividerColor}"
                VerticalOptions="Center"
                WidthRequest="560">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="2">
                            <Label FontAttributes="Bold" FontSize="20" Text="{Binding WorkflowOverlay.Title}" />
                            <Label
                                IsVisible="{Binding WorkflowOverlay.HasMessage}"
                                Style="{StaticResource MutedLabel}"
                                Text="{Binding WorkflowOverlay.Message}" />
                        </VerticalStackLayout>
                        <Button
                            Grid.Column="1"
                            Command="{Binding WorkflowOverlay.CloseCommand}"
                            IsEnabled="{Binding WorkflowOverlay.CanClose}"
                            Style="{StaticResource QuietButton}"
                            Text="Close" />
                    </Grid>
                    <Grid
                        ColumnDefinitions="*,Auto"
                        ColumnSpacing="12"
                        IsVisible="{Binding WorkflowOverlay.HasStepProgress}">
                        <Label
                            FontAttributes="Bold"
                            Text="{Binding WorkflowOverlay.StepTitle}" />
                        <Label
                            Grid.Column="1"
                            Style="{StaticResource MutedLabel}"
                            Text="{Binding WorkflowOverlay.StepProgressText}" />
                    </Grid>
                    <Border
                        Padding="12"
                        BackgroundColor="{DynamicResource SurfaceMutedColor}"
                        StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <ScrollView MaximumHeightRequest="560">
                        <VerticalStackLayout Spacing="10">
                            <Label
                                FontAttributes="Bold"
                                IsVisible="{Binding WorkflowOverlay.HasStepTitle}"
                                Text="{Binding WorkflowOverlay.StepTitle}" />
                            <Label
                                IsVisible="{Binding WorkflowOverlay.HasBodyText}"
                                Style="{StaticResource MutedLabel}"
                                Text="{Binding WorkflowOverlay.BodyText}" />
                            <VerticalStackLayout IsVisible="{Binding IsStartupSetupWorkflow}" Spacing="10">
                                <Button Command="{Binding OpenStartupStatementImportCommand}" Style="{StaticResource PrimaryButton}" Text="Import a bank statement" />
                                <Button Command="{Binding OpenStartupManualSetupCommand}" Style="{StaticResource QuietButton}" Text="Set up manually" />
                                <Button Command="{Binding OpenStartupBackupRestoreCommand}" Style="{StaticResource QuietButton}" Text="Restore Banccoon backup" />
                            </VerticalStackLayout>
                            <VerticalStackLayout IsVisible="{Binding Data.IsManualSetupWorkflow}" Spacing="8">
                                <Entry Placeholder="Account name" Text="{Binding Data.NewAccountName}" />
                                <Picker
                                    ItemDisplayBinding="{Binding ., Converter={StaticResource EnumDisplayConverter}}"
                                    ItemsSource="{Binding Data.AccountTypes}"
                                    SelectedItem="{Binding Data.SelectedAccountType}" />
                                <Entry
                                    IsVisible="{Binding Data.IsNewAccountPlanningValueVisible}"
                                    Keyboard="Numeric"
                                    Placeholder="{Binding Data.NewAccountPlanningValueLabel}"
                                    Text="{Binding Data.NewAccountPlanningValueText}" />
                                <Grid ColumnDefinitions="*,140" ColumnSpacing="8">
                                    <Entry Keyboard="Numeric" Placeholder="Balance" Text="{Binding Data.NewAccountBalanceText}" />
                                    <Picker Grid.Column="1" ItemsSource="{Binding Data.SupportedCurrencies}" SelectedItem="{Binding Data.NewAccountCurrency}" />
                                </Grid>
                                <Grid ColumnDefinitions="*,180" ColumnSpacing="8">
                                    <Entry Placeholder="Account number, optional" Text="{Binding Data.NewAccountNumber}" />
                                    <Entry
                                        Grid.Column="1"
                                        IsVisible="{Binding Data.IsNewAccountCard}"
                                        Keyboard="Numeric"
                                        MaxLength="4"
                                        Placeholder="Card last 4"
                                        Text="{Binding Data.NewCardLastFourDigits}" />
                                </Grid>
                                <HorizontalStackLayout Spacing="8">
                                    <CheckBox IsChecked="{Binding Data.NewAccountIncludeInDashboardTotals}" />
                                    <Label Style="{StaticResource MutedLabel}" Text="Include in dashboard totals" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <Button Command="{Binding Data.AddAccountCommand}" Style="{StaticResource PrimaryButton}" Text="Save account" />
                            </VerticalStackLayout>
                            <VerticalStackLayout IsVisible="{Binding Data.IsExpenseIncomeTransactionWorkflow}" Spacing="8">
                                <HorizontalStackLayout Spacing="8">
                                    <CheckBox IsChecked="{Binding Data.IsNewTransactionScheduledOccurrenceEnabled}" />
                                    <Label Style="{StaticResource MutedLabel}" Text="Scheduled transaction occurrence" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <Grid ColumnDefinitions="*,160" ColumnSpacing="8">
                                    <Picker ItemDisplayBinding="{Binding Name}" ItemsSource="{Binding Data.Accounts}" SelectedItem="{Binding Data.NewTransactionAccount}" Title="Account" />
                                    <DatePicker Grid.Column="1" Date="{Binding Data.NewTransactionDate}" Format="{Binding Data.DatePickerFormat}" />
                                </Grid>
                                <Grid ColumnDefinitions="*" ColumnSpacing="8">
                                    <Picker
                                        ItemDisplayBinding="{Binding Name}"
                                        ItemsSource="{Binding Data.ScheduledTransactionSummaries}"
                                        SelectedItem="{Binding Data.NewTransactionScheduledOccurrence}"
                                        IsVisible="{Binding Data.IsNewTransactionScheduledVisible}"
                                        Title="Existing scheduled item" />
                                </Grid>
                                <VerticalStackLayout IsVisible="{Binding Data.IsNewTransactionAdHocVisible}" Spacing="8">
                                    <Entry Placeholder="Transaction name" Text="{Binding Data.NewTransactionName}" />
                                    <Entry Keyboard="Numeric" Placeholder="Amount" Text="{Binding Data.NewTransactionAmountText}" />
                                    <Entry Placeholder="Description, optional" Text="{Binding Data.NewTransactionNotes}" />
                                </VerticalStackLayout>
                                <Button Command="{Binding Data.AddTransactionCommand}" Style="{StaticResource PrimaryButton}" Text="Save transaction" />
                            </VerticalStackLayout>
                            <VerticalStackLayout IsVisible="{Binding Data.IsTransferTransactionWorkflow}" Spacing="8">
                                <HorizontalStackLayout Spacing="8">
                                    <CheckBox IsChecked="{Binding Data.IsNewTransactionScheduledOccurrenceEnabled}" />
                                    <Label Style="{StaticResource MutedLabel}" Text="Scheduled transaction occurrence" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <Picker ItemDisplayBinding="{Binding Name}" ItemsSource="{Binding Data.Accounts}" SelectedItem="{Binding Data.NewTransactionAccount}" Title="Outgoing account" />
                                    <Picker Grid.Column="1" ItemDisplayBinding="{Binding Name}" ItemsSource="{Binding Data.Accounts}" SelectedItem="{Binding Data.NewTransferDestinationAccount}" Title="Incoming account or goal" />
                                </Grid>
                                <DatePicker Date="{Binding Data.NewTransactionDate}" Format="{Binding Data.DatePickerFormat}" />
                                <Grid ColumnDefinitions="*" ColumnSpacing="8">
                                    <Picker
                                        ItemDisplayBinding="{Binding Name}"
                                        ItemsSource="{Binding Data.ScheduledTransactionSummaries}"
                                        SelectedItem="{Binding Data.NewTransactionScheduledOccurrence}"
                                        IsVisible="{Binding Data.IsNewTransactionScheduledVisible}"
                                        Title="Existing scheduled item" />
                                </Grid>
                                <VerticalStackLayout IsVisible="{Binding Data.IsNewTransactionAdHocVisible}" Spacing="8">
                                    <Entry Placeholder="Transfer name" Text="{Binding Data.NewTransactionName}" />
                                    <Entry Keyboard="Numeric" Placeholder="Amount" Text="{Binding Data.NewTransactionAmountText}" />
                                    <Entry Placeholder="Description, optional" Text="{Binding Data.NewTransactionNotes}" />
                                </VerticalStackLayout>
                                <Button Command="{Binding Data.AddTransactionCommand}" Style="{StaticResource PrimaryButton}" Text="Save transfer" />
                            </VerticalStackLayout>
                            <VerticalStackLayout IsVisible="{Binding Data.IsScheduledTransactionWorkflow}" Spacing="8">
                                <Entry Placeholder="Name" Text="{Binding Data.NewScheduledName}" />
                                <Grid ColumnDefinitions="*,*,160" ColumnSpacing="8">
                                    <Picker ItemDisplayBinding="{Binding Name}" ItemsSource="{Binding Data.Accounts}" SelectedItem="{Binding Data.NewScheduledAccount}" Title="Account" />
                                    <Picker Grid.Column="1" ItemDisplayBinding="{Binding ., Converter={StaticResource EnumDisplayConverter}}" ItemsSource="{Binding Data.TransactionTypes}" SelectedItem="{Binding Data.SelectedScheduledType}" />
                                    <Entry Grid.Column="2" Keyboard="Numeric" Placeholder="Amount" Text="{Binding Data.NewScheduledAmountText}" />
                                </Grid>
                                <Grid ColumnDefinitions="120,*,160" ColumnSpacing="8">
                                    <Entry Keyboard="Numeric" Placeholder="Every" Text="{Binding Data.NewScheduledIntervalText}" />
                                    <Picker Grid.Column="1" ItemDisplayBinding="{Binding ., Converter={StaticResource EnumDisplayConverter}}" ItemsSource="{Binding Data.RecurrenceFrequencies}" SelectedItem="{Binding Data.SelectedScheduledFrequency}" />
                                    <DatePicker Grid.Column="2" Date="{Binding Data.NewScheduledDate}" Format="{Binding Data.DatePickerFormat}" />
                                </Grid>
                                <Picker ItemDisplayBinding="{Binding Name}" ItemsSource="{Binding Data.ScheduledCategoryChoices}" SelectedItem="{Binding Data.SelectedScheduledCategory}" Title="Category" />
                                <Entry Placeholder="Notes" Text="{Binding Data.NewScheduledNotes}" />
                                <Label Style="{StaticResource MutedLabel}" Text="{Binding Data.ScheduledRecurrenceSentencePreview}" />
                                <Button Command="{Binding Data.AddScheduledTransactionCommand}" Style="{StaticResource PrimaryButton}" Text="Save scheduled item" />
                                <CollectionView HeightRequest="180" ItemsSource="{Binding Data.ScheduledTransactionSummaries}">
                                    <CollectionView.EmptyView>
                                        <Label Style="{StaticResource MutedLabel}" Text="No scheduled items yet." />
                                    </CollectionView.EmptyView>
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Padding="0,5" ColumnDefinitions="*,Auto">
                                                <VerticalStackLayout Spacing="1">
                                                    <Label FontAttributes="Bold" Text="{Binding Name}" />
                                                    <Label Style="{StaticResource MutedLabel}" Text="{Binding RecurrenceText}" />
                                                </VerticalStackLayout>
                                                <Label Grid.Column="1" FontAttributes="Bold" Text="{Binding AmountText}" />
                                            </Grid>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </VerticalStackLayout>
                            <VerticalStackLayout IsVisible="{Binding Data.IsStatementImportTransactionWorkflow}" Spacing="8">
                                <Button Command="{Binding Data.PickStatementFileCommand}" Style="{StaticResource PrimaryButton}" Text="Pick statement file" />
                                <Label Style="{StaticResource MutedLabel}" Text="{Binding Data.StatementSelectedFileText}" />
                                <Label Style="{StaticResource MutedLabel}" Text="{Binding Data.AvailableStatementParsersText}" />
                                <Label Style="{StaticResource MutedLabel}" Text="{Binding Data.StatementDetectedAccountText}" />
                                <Label Style="{StaticResource MutedLabel}" Text="{Binding Data.StatementMatchedAccountText}" />
                                <VerticalStackLayout IsVisible="{Binding Data.IsStatementAccountUnmatched}" Spacing="8">
                                    <Picker ItemDisplayBinding="{Binding Name}" ItemsSource="{Binding Data.Accounts}" SelectedItem="{Binding Data.StatementConnectAccount}" Title="Link to existing account" />
                                    <Button Command="{Binding Data.ConnectStatementAccountCommand}" Style="{StaticResource QuietButton}" Text="Link account" />
                                    <Entry Placeholder="New account name" Text="{Binding Data.StatementNewAccountName}" />
                                    <Picker ItemsSource="{Binding Data.SupportedCurrencies}" SelectedItem="{Binding Data.StatementNewAccountCurrency}" Title="Currency" />
                                    <Button Command="{Binding Data.CreateStatementAccountFromStatementCommand}" Style="{StaticResource QuietButton}" Text="Create statement account" />
                                </VerticalStackLayout>
                                <Picker ItemDisplayBinding="{Binding DisplayTitle}" ItemsSource="{Binding Data.StatementImportBatchSummaries}" SelectedItem="{Binding Data.SelectedStatementImportBatch}" Title="Pending import batch" />
                                <Label Style="{StaticResource MutedLabel}" Text="{Binding Data.StatementImportStatusText}" />
                                <CollectionView HeightRequest="220" ItemsSource="{Binding Data.StatementImportRows}">
                                    <CollectionView.EmptyView>
                                        <Label Style="{StaticResource MutedLabel}" Text="No statement rows ready for review." />
                                    </CollectionView.EmptyView>
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Padding="0,5" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                                <VerticalStackLayout Spacing="1">
                                                    <Label FontAttributes="Bold" Text="{Binding Description}" />
                                                    <Label Style="{StaticResource MutedLabel}" Text="{Binding DetailText}" />
                                                </VerticalStackLayout>
                                                <Button Grid.Column="1" Command="{Binding BindingContext.Data.ApproveStatementRowCommand, Source={x:Reference Page}}" CommandParameter="{Binding .}" Style="{StaticResource QuietButton}" Text="Approve" />
                                                <Button Grid.Column="2" Command="{Binding BindingContext.Data.SkipStatementRowCommand, Source={x:Reference Page}}" CommandParameter="{Binding .}" Style="{StaticResource QuietButton}" Text="Skip" />
                                            </Grid>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </VerticalStackLayout>
                            <VerticalStackLayout IsVisible="{Binding Data.IsBackupRestoreWorkflow}" Spacing="8">
                                <Entry Placeholder="Path to Banccoon JSON backup" Text="{Binding Data.ImportPathText}" />
                                <Picker
                                    ItemDisplayBinding="{Binding ., Converter={StaticResource EnumDisplayConverter}}"
                                    ItemsSource="{Binding Data.ImportModes}"
                                    SelectedItem="{Binding Data.SelectedImportMode}" />
                                <HorizontalStackLayout Spacing="8">
                                    <Button Command="{Binding Data.ValidateImportCommand}" Style="{StaticResource QuietButton}" Text="Validate" />
                                    <Button Command="{Binding Data.RestoreBackupCommand}" Style="{StaticResource PrimaryButton}" Text="Run import" />
                                </HorizontalStackLayout>
                                <Label Style="{StaticResource MutedLabel}" Text="{Binding Data.ImportExportSummary}" />
                            </VerticalStackLayout>
                            <ActivityIndicator
                                IsRunning="{Binding WorkflowOverlay.IsBusy}"
                                IsVisible="{Binding WorkflowOverlay.IsBusy}" />
                            <Border
                                Padding="10"
                                BackgroundColor="#F7E8E8"
                                IsVisible="{Binding WorkflowOverlay.HasError}"
                                Stroke="#E1B5B5">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>
                                <Label Text="{Binding WorkflowOverlay.ErrorMessage}" />
                            </Border>
                        </VerticalStackLayout>
                        </ScrollView>
                    </Border>
                    <HorizontalStackLayout HorizontalOptions="End" Spacing="8">
                        <Button
                            Command="{Binding WorkflowOverlay.CancelCommand}"
                            IsEnabled="{Binding WorkflowOverlay.CanClose}"
                            Style="{StaticResource QuietButton}"
                            Text="Cancel" />
                        <Button
                            Command="{Binding WorkflowOverlay.PreviousStepCommand}"
                            IsEnabled="{Binding WorkflowOverlay.CanMovePrevious}"
                            Style="{StaticResource QuietButton}"
                            Text="{Binding WorkflowOverlay.SecondaryActionText}" />
                        <Button
                            Command="{Binding WorkflowOverlay.NextStepCommand}"
                            IsEnabled="{Binding WorkflowOverlay.CanMoveNext}"
                            Style="{StaticResource PrimaryButton}"
                            Text="{Binding WorkflowOverlay.PrimaryActionText}" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
