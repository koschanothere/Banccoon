                                        </VerticalStackLayout>
                                        <Button
                                            Grid.Column="2"
                                            Command="{Binding BindingContext.Data.DeleteScheduledTransactionCommand, Source={x:Reference Page}}"
                                            CommandParameter="{Binding Source}"
