                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1">
                                        <Label Style="{StaticResource MutedLabel}" Text="Real balance" />
                                        <Label FontAttributes="Bold" Text="{Binding Data.ReconciliationActualText}" />
                                    </VerticalStackLayout>
                                </Grid>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                    <VerticalStackLayout>
                                        <Label Style="{StaticResource MutedLabel}" Text="Difference" />
                                        <Label FontAttributes="Bold" Text="{Binding Data.ReconciliationDifferenceText}" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1">
                                        <Label Style="{StaticResource MutedLabel}" Text="Status" />
                                        <Label FontAttributes="Bold" Text="{Binding Data.ReconciliationStatusText}" />
                                    </VerticalStackLayout>
                                </Grid>
                                <Label FontAttributes="Bold" Text="Reconciliation transactions" />
                                <Grid ColumnDefinitions="*,150,*,Auto" ColumnSpacing="10">
