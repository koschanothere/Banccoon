                                        <VerticalStackLayout Grid.Column="1" HorizontalOptions="End">
                                            <Label FontAttributes="Bold" HorizontalTextAlignment="End" Text="{Binding AmountText}" />
                                            <Label Style="{StaticResource MutedLabel}" HorizontalTextAlignment="End" Text="{Binding KindText}" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <VerticalStackLayout IsVisible="{Binding IsReconciliationSelected}" Spacing="16">
                    <Label Style="{StaticResource SectionTitleLabel}" Text="Reconciliation" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                        <Border Padding="16" BackgroundColor="{DynamicResource SurfaceColor}" Stroke="{DynamicResource DividerColor}">
                            <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
