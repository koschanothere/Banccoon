                                            Grid.Column="5"
                                            Command="{Binding BindingContext.Data.SkipStatementRowCommand, Source={x:Reference Page}}"
                                            CommandParameter="{Binding .}"
                                            IsEnabled="{Binding IsPending}"
                                            Style="{StaticResource QuietButton}"
                                            Text="Skip" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <VerticalStackLayout IsVisible="{Binding IsScheduledSelected}" Spacing="16">
