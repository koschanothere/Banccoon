                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,8" Padding="12" BackgroundColor="{DynamicResource SurfaceMutedColor}" StrokeThickness="0">
                                                <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                    <VerticalStackLayout Spacing="2">
                                                        <Label FontAttributes="Bold" Text="{Binding Name}" />
                                                        <Label Style="{StaticResource MutedLabel}" Text="{Binding DetailText}" />
                                                        <Label Style="{StaticResource MutedLabel}" Text="{Binding DecisionText}" />
                                                    </VerticalStackLayout>
                                                    <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                                                        <Entry Keyboard="Numeric" WidthRequest="90" Text="{Binding EditableAmountText}" />
                                                        <Button Command="{Binding BindingContext.Data.ConfirmExpectedTransactionCommand, Source={x:Reference Page}}" CommandParameter="{Binding .}" Style="{StaticResource QuietButton}" Text="Confirm" />
                                                        <Button Command="{Binding BindingContext.Data.DelayExpectedTransactionCommand, Source={x:Reference Page}}" CommandParameter="{Binding .}" Style="{StaticResource QuietButton}" Text="Delay" />
                                                        <Button Command="{Binding BindingContext.Data.CancelExpectedTransactionCommand, Source={x:Reference Page}}" CommandParameter="{Binding .}" Style="{StaticResource QuietButton}" Text="Skip" />
                                                    </HorizontalStackLayout>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Column="1" Padding="16" BackgroundColor="{DynamicResource SurfaceColor}" Stroke="{DynamicResource DividerColor}">
