<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Banccoon.App.Views.TransactionsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:Banccoon.App.ViewModels"
    x:DataType="viewModels:TransactionsViewModel"
    Title="Transactions"
    BackgroundColor="{AppThemeBinding Light={StaticResource LightPageBackground}, Dark={StaticResource DarkPageBackground}}">
    <VerticalStackLayout Padding="32" Spacing="8">
        <Label Text="Transactions" Style="{StaticResource ScreenTitleLabel}" />
        <Label Text="{Binding PlaceholderText}" Style="{StaticResource SecondaryLabel}" />
    </VerticalStackLayout>
</ContentPage>
