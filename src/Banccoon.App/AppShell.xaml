<?xml version="1.0" encoding="utf-8" ?>
<Shell
    x:Class="Banccoon.App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Banccoon.App.Views"
    Shell.FlyoutBehavior="Disabled">
    <TabBar>
        <ShellContent
            ContentTemplate="{DataTemplate views:DashboardPage}"
            Route="dashboard"
            Title="Dashboard" />
        <ShellContent
            ContentTemplate="{DataTemplate views:TransactionsPage}"
            Route="transactions"
            Title="Transactions" />
        <ShellContent
            ContentTemplate="{DataTemplate views:AccountsPage}"
            Route="accounts"
            Title="Accounts" />
        <ShellContent
            ContentTemplate="{DataTemplate views:SettingsPage}"
            Route="settings"
            Title="Settings" />
    </TabBar>
</Shell>
