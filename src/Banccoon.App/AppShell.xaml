<?xml version="1.0" encoding="utf-8" ?>
<Shell
    x:Class="Banccoon.App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Banccoon.App.Views"
    xmlns:viewModels="clr-namespace:Banccoon.App.ViewModels"
    x:DataType="viewModels:AppShellViewModel"
    Shell.FlyoutBehavior="Locked"
    Shell.FlyoutWidth="190"
    Shell.NavBarIsVisible="False"
    FlyoutBackgroundColor="{AppThemeBinding Light={StaticResource LightSidebarBackground}, Dark={StaticResource DarkSidebarBackground}}">

    <Shell.FlyoutHeaderTemplate>
        <DataTemplate>
            <HorizontalStackLayout Padding="16,12,16,12" Spacing="10">
                <Border WidthRequest="48" HeightRequest="48" Padding="4" StrokeShape="RoundRectangle 14" Stroke="Transparent"
                        Background="{AppThemeBinding Light={StaticResource LightAccent}, Dark={StaticResource DarkAccent}}">
                    <Image Source="{Binding CurrentTabImageSource}" Aspect="AspectFit" />
                </Border>
                <Label Text="Banccoon" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" />
            </HorizontalStackLayout>
        </DataTemplate>
    </Shell.FlyoutHeaderTemplate>

    <Shell.FlyoutFooterTemplate>
        <DataTemplate>
            <VerticalStackLayout Padding="16,10,16,16" Spacing="6">
                <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource LightDivider}, Dark={StaticResource DarkDivider}}" Margin="0,0,0,6" />
                <Label Text="ACCOUNTS" FontSize="11" FontAttributes="Bold" CharacterSpacing="0.5"
                       TextColor="{AppThemeBinding Light={StaticResource LightTextTertiary}, Dark={StaticResource DarkTextTertiary}}" />
                <CollectionView ItemsSource="{Binding FavoriteAccounts}">
                    <CollectionView.EmptyView>
                        <Label Text="Star an account to pin it here." FontSize="12"
                               TextColor="{AppThemeBinding Light={StaticResource LightTextTertiary}, Dark={StaticResource DarkTextTertiary}}" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:SidebarAccountViewModel">
                            <Grid ColumnDefinitions="*,Auto" Padding="0,5">
                                <Label Grid.Column="0" Text="{Binding Name}" FontSize="13" LineBreakMode="TailTruncation" />
                                <Label Grid.Column="1" Text="{Binding BalanceText}" FontSize="12" FontAttributes="Bold" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </DataTemplate>
    </Shell.FlyoutFooterTemplate>

    <FlyoutItem Title="Dashboard" Route="dashboard">
        <ShellContent ContentTemplate="{DataTemplate views:DashboardPage}" />
    </FlyoutItem>
    <FlyoutItem Title="Transactions" Route="transactions">
        <ShellContent ContentTemplate="{DataTemplate views:TransactionsPage}" />
    </FlyoutItem>
    <FlyoutItem Title="Accounts" Route="accounts">
        <ShellContent ContentTemplate="{DataTemplate views:AccountsPage}" />
    </FlyoutItem>
    <FlyoutItem Title="Settings" Route="settings">
        <ShellContent ContentTemplate="{DataTemplate views:SettingsPage}" />
    </FlyoutItem>
</Shell>
