<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="Banccoon.App.Controls.RecurrenceEditorView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Banccoon.App.Controls"
    xmlns:loc="clr-namespace:Banccoon.App.Localization">
    <VerticalStackLayout Spacing="12">
        <Grid ColumnDefinitions="Auto,96,160,*" ColumnSpacing="8" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
            <Label
                Grid.Row="0"
                Grid.Column="0"
                Text="{loc:Translate RecurrenceEditor_Every}"
                VerticalOptions="Center" />
            <Entry
                Grid.Row="0"
                Grid.Column="1"
                Keyboard="Numeric"
                Placeholder="1"
                Text="{Binding Interval}" />
            <Picker
                Grid.Row="0"
                Grid.Column="2"
                Title="{loc:Translate RecurrenceEditor_FrequencyPickerTitle}"
                ItemsSource="{Binding Frequencies}"
                ItemDisplayBinding="{Binding ., Converter={StaticResource EnumDisplayConverter}}"
                SelectedItem="{Binding Frequency}" />

            <Label
                Grid.Row="1"
                Grid.Column="0"
                IsVisible="{Binding IsWeekly}"
                Text="{loc:Translate RecurrenceEditor_On}"
                VerticalOptions="Center" />
            <Picker
                Grid.Row="1"
                Grid.Column="1"
                Grid.ColumnSpan="2"
                Title="{loc:Translate RecurrenceEditor_DayOfWeekPickerTitle}"
                IsVisible="{Binding IsWeekly}"
                ItemsSource="{Binding DaysOfWeek}"
                SelectedItem="{Binding DayOfWeek}" />

            <Label
                Grid.Row="2"
                Grid.Column="0"
                IsVisible="{Binding IsMonthly}"
                Text="{loc:Translate RecurrenceEditor_Monthly}"
                VerticalOptions="Center" />
            <Picker
                Grid.Row="2"
                Grid.Column="1"
                Grid.ColumnSpan="2"
                Title="{loc:Translate RecurrenceEditor_MonthlyModePickerTitle}"
                IsVisible="{Binding IsMonthly}"
                ItemsSource="{Binding MonthlyModes}"
                ItemDisplayBinding="{Binding ., Converter={StaticResource EnumDisplayConverter}}"
                SelectedItem="{Binding MonthlyMode}" />
            <Entry
                Grid.Row="2"
                Grid.Column="3"
                IsVisible="{Binding UsesDayOfMonth}"
                Keyboard="Numeric"
                Placeholder="{loc:Translate RecurrenceEditor_DayPlaceholder}"
                Text="{Binding DayOfMonth}" />

            <Label
                Grid.Row="3"
                Grid.Column="0"
                Text="{loc:Translate RecurrenceEditor_Starts}"
                VerticalOptions="Center" />
            <DatePicker
                Grid.Row="3"
                Grid.Column="1"
                Grid.ColumnSpan="2"
                Date="{Binding StartDate}" />

            <HorizontalStackLayout
                Grid.Row="4"
                Grid.Column="0"
                Grid.ColumnSpan="4"
                Spacing="8">
                <CheckBox IsChecked="{Binding HasEndDate}" />
                <Label
                    Text="{loc:Translate RecurrenceEditor_Ends}"
                    VerticalOptions="Center" />
                <DatePicker
                    Date="{Binding EndDate}"
                    IsEnabled="{Binding HasEndDate}" />
            </HorizontalStackLayout>
        </Grid>

        <Label
            FontAttributes="Bold"
            Text="{Binding Description}" />
        <Label
            Text="{Binding ValidationMessage}"
            TextColor="#B3261E" />

        <Border
            Padding="14"
            BackgroundColor="{AppThemeBinding Light={StaticResource LightCardSoft}, Dark={StaticResource DarkCardSoft}}"
            Stroke="{AppThemeBinding Light={StaticResource LightDivider}, Dark={StaticResource DarkDivider}}"
            controls:PowerUser.IsPowerUserElement="True"
            controls:PowerUser.ShowPowerUserElements="{Binding ShowPowerUserFeatures}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="8" />
            </Border.StrokeShape>
            <VerticalStackLayout Spacing="10">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <VerticalStackLayout Spacing="2">
                        <Label
                            FontAttributes="Bold"
                            Text="{loc:Translate RecurrenceEditor_TechnicalSyntaxTitle}" />
                        <Label
                            Style="{StaticResource TertiaryLabel}"
                            Text="{loc:Translate RecurrenceEditor_TechnicalSyntaxSubtitle}" />
                    </VerticalStackLayout>
                    <CheckBox
                        Grid.Column="1"
                        IsChecked="{Binding IsTechnicalSyntaxExpanded}"
                        VerticalOptions="Center" />
                </Grid>

                <VerticalStackLayout
                    IsVisible="{Binding IsTechnicalSyntaxExpanded}"
                    Spacing="8">
                    <Editor
                        AutoSize="TextChanges"
                        FontFamily="Consolas"
                        HeightRequest="74"
                        Placeholder="FREQ=WEEKLY;INTERVAL=2;BYDAY=MO;START=2026-06-07"
                        Text="{Binding TechnicalSyntax}" />
                    <HorizontalStackLayout Spacing="8">
                        <Button
                            Command="{Binding ApplyTechnicalSyntaxCommand}"
                            Style="{StaticResource PrimaryButton}"
                            Text="{loc:Translate RecurrenceEditor_ApplySyntaxButton}" />
                    </HorizontalStackLayout>
                    <Label
                        Style="{StaticResource TertiaryLabel}"
                        Text="{Binding TechnicalSyntaxMessage}" />
                    <Label
                        FontAttributes="Bold"
                        FontSize="12"
                        Text="{loc:Translate RecurrenceEditor_ExamplesHeader}" />
                    <CollectionView
                        HeightRequest="148"
                        ItemsSource="{Binding SyntaxExamples}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <VerticalStackLayout Padding="0,4" Spacing="2">
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="12"
                                        Text="{Binding LabelText}" />
                                    <Label
                                        FontFamily="Consolas"
                                        FontSize="12"
                                        Text="{Binding Syntax}"
                                        TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </Border>
    </VerticalStackLayout>
</ContentView>
