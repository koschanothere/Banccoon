<?xml version="1.0" encoding="utf-8" ?>
<Application
    x:Class="Banccoon.App.App"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:Banccoon.App.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <converters:EnumDisplayConverter x:Key="EnumDisplayConverter" />

            <Color x:Key="PageBackgroundColor">#F4F6F3</Color>
            <Color x:Key="ShellBackgroundColor">#17201B</Color>
            <Color x:Key="ShellPanelColor">#203128</Color>
            <Color x:Key="SurfaceColor">#FFFFFF</Color>
            <Color x:Key="SurfaceMutedColor">#EEF3EF</Color>
            <Color x:Key="PrimaryTextColor">#14201A</Color>
            <Color x:Key="SecondaryTextColor">#5A675E</Color>
            <Color x:Key="MutedTextColor">#7A847D</Color>
            <Color x:Key="ShellTextColor">#F5F8F2</Color>
            <Color x:Key="AccentColor">#2E8B57</Color>
            <Color x:Key="AccentSoftColor">#DDEEE4</Color>
            <Color x:Key="WarningColor">#C9862C</Color>
            <Color x:Key="RoseColor">#B55B67</Color>
            <Color x:Key="DividerColor">#DDE5DD</Color>

            <Style TargetType="Label">
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="TextColor" Value="{DynamicResource PrimaryTextColor}" />
            </Style>

            <Style x:Key="SectionTitleLabel" TargetType="Label">
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="FontSize" Value="26" />
            </Style>

            <Style x:Key="MutedLabel" TargetType="Label">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="TextColor" Value="{DynamicResource SecondaryTextColor}" />
            </Style>

            <Style TargetType="Entry">
                <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceMutedColor}" />
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="PlaceholderColor" Value="{DynamicResource MutedTextColor}" />
                <Setter Property="TextColor" Value="{DynamicResource PrimaryTextColor}" />
            </Style>

            <Style TargetType="Picker">
                <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceMutedColor}" />
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="TextColor" Value="{DynamicResource PrimaryTextColor}" />
                <Setter Property="TitleColor" Value="{DynamicResource MutedTextColor}" />
            </Style>

            <Style TargetType="DatePicker">
                <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceMutedColor}" />
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="TextColor" Value="{DynamicResource PrimaryTextColor}" />
            </Style>

            <Style x:Key="ShellButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="BorderWidth" Value="0" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="HorizontalOptions" Value="Start" />
                <Setter Property="Padding" Value="12,10" />
                <Setter Property="TextColor" Value="{DynamicResource ShellTextColor}" />
            </Style>

            <Style x:Key="QuietButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceMutedColor}" />
                <Setter Property="BorderWidth" Value="0" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Padding" Value="12,8" />
                <Setter Property="TextColor" Value="{DynamicResource PrimaryTextColor}" />
            </Style>

            <Style x:Key="PrimaryButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{DynamicResource AccentColor}" />
                <Setter Property="BorderWidth" Value="0" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Padding" Value="12,8" />
                <Setter Property="TextColor" Value="#FFFFFF" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
